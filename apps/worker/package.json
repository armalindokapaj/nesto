{
  "name": "@nesto/worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "rebuild-derived": "tsx src/ops/rebuild-derived.ts"
  },
  "dependencies": {
    "@nesto/contracts": "workspace:*",
    "@nesto/crypto": "workspace:*",
    "@nesto/database": "workspace:*",
    "@nesto/events": "workspace:*",
    "@nesto/observability": "workspace:*",
    "@nesto/storage": "workspace:*",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@nesto/config": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.4.7",
    "pg": "^8.23.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
