{
  "name": "@nesto/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nesto/auth": "workspace:*",
    "@nesto/contracts": "workspace:*",
    "@nesto/crypto": "workspace:*",
    "@nesto/database": "workspace:*",
    "@nesto/events": "workspace:*",
    "@nesto/money": "workspace:*",
    "@nesto/observability": "workspace:*",
    "@nesto/policy": "workspace:*",
    "@nesto/storage": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "fastify": "5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1",
    "@fastify/static": "^8.1.0"
  },
  "devDependencies": {
    "@nesto/config": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
