  structures ProjectStructure[]
  units      Unit[]

  // PRD_Client_Supplier_Portals Phase 1 (additive) — Projects module itself is
  // frozen (read/link only); this is solely the required Prisma back-relation
  // for BusinessAccessRelationship, no Projects business logic touched.
