// Nesto — Phase 0/1 data model.
//
// Datasource is SQLite for zero-dependency local development (no Docker/Postgres
// available in this environment). Every tenant-owned model carries a `tenantId`
// column so switching `provider` to "postgresql" later is a config change, not a
// schema rewrite. Status/role fields are plain strings (validated at the app layer
// via lib/constants.ts) rather than Prisma enums, since SQLite has no native enum
// support — this also means the same schema works unmodified on Postgres.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  companies              Company[]
  memberships            CompanyMembership[]
  projects               Project[]
  tasks                  Task[]
  comments               Comment[]
  timelineEvents         TimelineEvent[]
  notifications          Notification[]
  auditEvents            AuditEvent[]
  domainEvents           DomainEvent[]
  invoices               Invoice[]
  financeAccounts        FinanceAccount[]
  employees              Employee[]
  leaveRequests          LeaveRequest[]
  drawings               Drawing[]
  rfis                   RFI[]
  invitations            Invitation[]
  teams                  Team[]
  contracts              Contract[]
  contractors            Contractor[]
  documentFiles          DocumentFile[]
  meetings               Meeting[]
  assets                 Asset[]
  settings               TenantSettings?
  numberSeries           NumberSeries[]
  dimensionDefinitions   DimensionDefinition[]
  recordDimensions       RecordDimension[]
  financialLedgerEntries FinancialLedgerEntry[]
  suggestions            Suggestion[]
  hrAppointments         HrAppointment[]
  clients                Client[]
  hseReports             HseReport[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]

  // --- PRD_Rework_1 Projects Module & Project Page Redesign ----------------
  projectRenders      ProjectRender[]
  projectPins         ProjectPin[]
  projectWorkPackages ProjectWorkPackage[]
  projectApprovals    ProjectApproval[]
  projectPhotos       ProjectPhoto[]

  // --- PRD_Units / PRD_Unit_Page Real Estate Inventory ----------------------
  projectStructures  ProjectStructure[]
  projectFloors      ProjectFloor[]
  units              Unit[]
  unitAreaComponents UnitAreaComponent[]
  unitRenders        UnitRender[]
  unitActivityEvents UnitActivityEvent[]

  // --- PRD_4 Cross-Department Task Orchestration -----------------------
  taskStages                TaskStage[]
  taskDepartments           TaskDepartment[]
  departmentDeliverables    DepartmentDeliverable[]
  taskParticipants          TaskParticipant[]
  taskEvents                TaskEvent[]
  taskApprovals             TaskApproval[]
  involvementRequests       DepartmentInvolvementRequest[]
  taskEscalations           TaskEscalation[]
  taskDelayExplanations     TaskDelayExplanation[]
  taskContractLinks         TaskContractLink[]
  taskContractorAssignments TaskContractorAssignment[]
  taskInspections           TaskInspection[]
  taskCompletionRecords     TaskCompletionRecord[]
  taskReopeningRecords      TaskReopeningRecord[]

  // --- PRD_Tasks_Module (additive: Star + Checklist) --------------------
  taskStars          TaskStar[]
  taskChecklistItems TaskChecklistItem[]

  // --- PRD_CRM_Module (additive) -----------------------------------------
  contacts       Contact[]
  clientNotes    ClientNote[]
  pipelines      Pipeline[]
  pipelineStages PipelineStage[]
  opportunities  Opportunity[]
  leads          Lead[]
  clientStars    ClientStar[]

  // --- PRD_6 Public Sign-Up / Platform Approval -------------------------
  profileInvitations ProfileInvitation[]

  // --- PRD_9 Personal Calendar / Leave / Reminders -----------------------
  agendaEvents      AgendaEvent[]
  projectMilestones ProjectMilestone[]

  salaryRecords     SalaryRecord[]
  companyModules    CompanyModule[]
  employeeTrainings EmployeeTraining[]
  documentApprovals DocumentApproval[]

  // --- PRD_Documents_Module ------------------------------------------------
  folders   Folder[]
  documents Document[]

  // --- Platform Configuration ----------------------------------------------
  platformConfigSettings PlatformConfigSetting[]
}

model Company {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  legalName       String?
  isParent        Boolean   @default(false)
  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies  Company[] @relation("CompanyHierarchy")
  logoUrl         String?
  countryCode     String    @default("AL")
  planName        String    @default("Enterprise")
  seatLimit       Int       @default(50)
  createdAt       DateTime  @default(now())

  branches Branch[]
  projects Project[]
  units    Unit[]

  // --- Platform Configuration ----------------------------------------------
  platformConfigSettings PlatformConfigSetting[]
}

model Branch {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  address            String?
  isRegisteredBranch Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// Global login identity — one record per person, may hold memberships in
// multiple tenants (Section 3: "one login, many contexts").
model UserIdentity {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatarColor  String   @default("#B8860B")
  createdAt    DateTime @default(now())
  // PRD_9 §6 — belongs to the identity, not a tenant membership, so the
  // preference (and role-derived Creative flavor) follows the user across
  // devices and workspaces. PLATFORM_DEFAULT | NIGHT | CREATIVE
  theme        String   @default("PLATFORM_DEFAULT")

  memberships             CompanyMembership[]
  projectMembers          ProjectMember[]
  createdTasks            Task[]                   @relation("TaskCreator")
  responsibleTasks        Task[]                   @relation("TaskResponsible")
  taskContributions       TaskContribution[]
  comments                Comment[]
  notifications           Notification[]
  employeeRecord          Employee?
  teamMemberships         TeamMember[]
  uploadedDocuments       DocumentFile[]
  documentApprovals       DocumentFile[]           @relation("DocumentApprover")
  organisedMeetings       Meeting[]
  postedLedgerEntries     FinancialLedgerEntry[]
  notificationPreferences NotificationPreference[]
  suggestions             Suggestion[]
  hrAppointments          HrAppointment[]
  createdClients          Client[]
  hseReports              HseReport[]
  purchaseOrdersRequested PurchaseOrder[]

  // --- PRD_4 Cross-Department Task Orchestration -----------------------
  taskManagerFor             Task[]                         @relation("TaskManager")
  decisionOwnerFor           Task[]                         @relation("TaskDecisionOwner")
  finalApproverFor           Task[]                         @relation("TaskFinalApprover")
  departmentOwnerFor         TaskDepartment[]               @relation("TaskDepartmentOwner")
  taskParticipations         TaskParticipant[]              @relation("TaskParticipantUser")
  taskEventsActed            TaskEvent[]                    @relation("TaskEventActor")
  taskApprovalsGiven         TaskApproval[]                 @relation("TaskApprover")
  taskApprovalsDelegatedToMe TaskApproval[]                 @relation("TaskApprovalDelegate")
  involvementRequestsMade    DepartmentInvolvementRequest[] @relation("InvolvementRequester")
  involvementRequestsHandled DepartmentInvolvementRequest[] @relation("InvolvementResponder")
  escalationsRaised          TaskEscalation[]               @relation("EscalationFrom")
  escalationsReceived        TaskEscalation[]               @relation("EscalationTo")
  delayExplanationsGiven     TaskDelayExplanation[]         @relation("DelayExplanationAuthor")
  contractLinksCreated       TaskContractLink[]             @relation("ContractLinkCreator")
  contractorAssignmentsMade  TaskContractorAssignment[]     @relation("ContractorAssignmentAssignedBy")
  taskInspectionsPerformed   TaskInspection[]               @relation("TaskInspector")
  taskCompletionsRecorded    TaskCompletionRecord[]         @relation("TaskCompletedBy")
  taskReopeningsRecorded     TaskReopeningRecord[]          @relation("TaskReopenedBy")
  stagesSkipped              TaskStage[]                    @relation("StageSkippedBy")
  contractorProfile          Contractor?                    @relation("ContractorLogin")

  // --- PRD_Tasks_Module (additive: Star + Checklist) --------------------
  taskStars              TaskStar[]          @relation("TaskStarUser")
  taskChecklistOwned     TaskChecklistItem[] @relation("TaskChecklistOwner")
  taskChecklistCompleted TaskChecklistItem[] @relation("TaskChecklistCompletedBy")
  taskChecklistCreated   TaskChecklistItem[] @relation("TaskChecklistCreatedBy")

  // --- PRD_Teams_Module (additive: type, lead, member role) --------------
  teamsLed Team[] @relation("TeamLead")

  // --- PRD_CRM_Module (additive) -----------------------------------------
  clientsOwned        Client[]      @relation("ClientOwner")
  contactsOwned       Contact[]     @relation("ContactOwner")
  clientNotesAuthored ClientNote[]  @relation("ClientNoteAuthor")
  opportunitiesOwned  Opportunity[] @relation("OpportunityOwner")
  leadsOwned          Lead[]        @relation("LeadOwner")
  clientStars         ClientStar[]  @relation("ClientStarUser")

  // --- PRD_6 Public Sign-Up / Platform Approval -------------------------
  // A single flag on the existing company-scoped identity, not a separate
  // tenant-independent Platform Admin account model (that's PRD_7's fuller
  // scope) — enough to gate a minimal /platform/applications review queue.
  isPlatformAdmin            Boolean              @default(false)
  reviewedApplications       ProfileApplication[] @relation("ApplicationReviewer")
  applicationReviewsAuthored ApplicationReview[]  @relation("ApplicationReviewAuthor")
  profileInvitationsSent     ProfileInvitation[]

  // --- PRD_9 Personal Calendar / Leave / Reminders -----------------------
  agendaEvents         AgendaEvent[]
  reminderPreferences  ReminderPreference[]
  createdMilestones    ProjectMilestone[]
  leaveRequestsCreated LeaveRequest[]       @relation("LeaveCreatedBy")
  leaveRequestsDecided LeaveRequest[]       @relation("LeaveDecidedBy")

  // --- Salary History ----------------------------------------------------
  salaryRecordsCreated SalaryRecord[] @relation("SalaryRecordCreatedBy")
  salaryRecordsUpdated SalaryRecord[] @relation("SalaryRecordUpdatedBy")

  // --- Training Module -----------------------------------------------------
  trainingsAssigned EmployeeTraining[] @relation("TrainingAssignedBy")

  // --- PRD_18 Document Passport / Blue Ticket -------------------------------
  documentApprovalsGiven DocumentApproval[]

  // --- PRD_Rework_1 Projects Module & Project Page Redesign ----------------
  projectPins                ProjectPin[]
  uploadedProjectRenders     ProjectRender[]
  uploadedProjectPhotos      ProjectPhoto[]
  projectWorkPackagesCreated ProjectWorkPackage[]
  projectApprovalsRequested  ProjectApproval[]    @relation("ApprovalRequester")
  projectApprovalsToApprove  ProjectApproval[]    @relation("ApprovalApprover")

  // --- PRD_Units / PRD_Unit_Page Real Estate Inventory ----------------------
  uploadedUnitRenders     UnitRender[]
  unitActivityEventsActed UnitActivityEvent[]

  // --- PRD_Documents_Module ------------------------------------------------
  documentsOwned       Document[]            @relation("DocumentOwner")
  documentComments     DocumentComment[]     @relation("DocumentCommentAuthor")
  documentFavorites    DocumentFavorite[]    @relation("DocumentFavoriteUser")
  documentReadReceipts DocumentReadReceipt[] @relation("DocumentReadReceiptUser")
  documentActivities   DocumentActivity[]    @relation("DocumentActivityActor")
}

// Links an identity to a tenant workspace with a role, department and access mode.
model CompanyMembership {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // see lib/constants.ts ROLES
  department String?
  position   String?
  managerId  String?
  accessMode String       @default("STANDARD") // STANDARD | VIEW_ONLY | SUSPENDED | ARCHIVED
  createdAt  DateTime     @default(now())

  @@unique([tenantId, userId])
}

model Invitation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        String
  status      String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
}

// ---------------------------------------------------------------------------
// Projects & Tasks
// ---------------------------------------------------------------------------

model Project {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  name          String
  clientName    String?
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id])
  location      String?
  budget        Float?
  contractValue Float?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("ACTIVE") // ACTIVE | ON_TRACK | AT_RISK | DELAYED | COMPLETED | ARCHIVED
  progressPct   Int       @default(0)
  createdAt     DateTime  @default(now())

  // PRD_Rework_1 Brand Kit — the pinned render doubles as both the Project
  // Page cover image and the universal thumbnail everywhere (cards, search,
  // notifications, ...), per PRD §6. No separate coverImageId field.
  accentColor    String?
  logoDataUrl    String?
  pinnedRenderId String?        @unique
  pinnedRender   ProjectRender? @relation("ProjectPinnedRender", fields: [pinnedRenderId], references: [id], onDelete: SetNull)

  members        ProjectMember[]
  tasks          Task[]
  drawings       Drawing[]
  rfis           RFI[]
  invoices       Invoice[]
  contracts      Contract[]
  documentFiles  DocumentFile[]
  meetings       Meeting[]
  assets         Asset[]
  hseReports     HseReport[]
  purchaseOrders PurchaseOrder[]
  milestones     ProjectMilestone[]

  // PRD_Rework_1 Projects Module & Project Page Redesign
  renders      ProjectRender[]      @relation("ProjectRenderGallery")
  pins         ProjectPin[]
  workPackages ProjectWorkPackage[]
  approvals    ProjectApproval[]
  photos       ProjectPhoto[]

  // PRD_Units / PRD_Unit_Page Real Estate Inventory
  structures ProjectStructure[]
  units      Unit[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model ProjectMember {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleOnProject String?
  createdAt     DateTime     @default(now())

  @@unique([projectId, userId])
}

// ---------------------------------------------------------------------------
// PRD_Rework_1 — Projects Module & Project Page Redesign
// ---------------------------------------------------------------------------
// Technical Documents and Government & Legal need no new model here — they
// reuse DocumentFile's existing revision chain (supersedesId/supersededBy/
// version) and DocumentApproval "Blue Ticket" decisions, just filtered by a
// category list (see lib/constants.ts). Everything below is genuinely new.

model ProjectRender {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation("ProjectRenderGallery", fields: [projectId], references: [id], onDelete: Cascade)
  fileData     Bytes
  fileMimeType String
  fileSize     Int
  checksum     String
  uploadedById String
  uploadedBy   UserIdentity @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  pinnedByProject Project? @relation("ProjectPinnedRender")

  @@index([tenantId, projectId])
}

model ProjectPin {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([projectId, userId])
  @@index([tenantId, userId])
}

model ProjectWorkPackage {
  id                 String       @id @default(cuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  status             String       @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | ON_HOLD | COMPLETED
  progressPct        Int          @default(0)
  area               String?
  contractorId       String?
  contractor         Contractor?  @relation(fields: [contractorId], references: [id])
  startDate          DateTime?
  expectedFinishDate DateTime?
  latestUpdate       String?
  createdById        String
  createdBy          UserIdentity @relation(fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())

  photos ProjectPhoto[]

  @@index([tenantId, projectId])
}

model ProjectApproval {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  department      String?
  relatedEntity   String?
  optionsProposed String?
  costImpact      String?
  timelineImpact  String?
  technicalImpact String?
  requesterId     String
  requester       UserIdentity @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approverId      String
  approver        UserIdentity @relation("ApprovalApprover", fields: [approverId], references: [id])
  deadline        DateTime?
  status          String       @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedAt       DateTime?
  decisionNote    String?
  createdAt       DateTime     @default(now())

  attachments DocumentFile[]

  @@index([tenantId, projectId])
}

model ProjectPhoto {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String?
  workPackage   ProjectWorkPackage? @relation(fields: [workPackageId], references: [id])
  fileData      Bytes
  fileMimeType  String
  fileSize      Int
  checksum      String
  caption       String?
  takenAt       DateTime            @default(now())
  uploadedById  String
  uploadedBy    UserIdentity        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime            @default(now())

  @@index([tenantId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_Units / PRD_Unit_Page — Real Estate Inventory (Pass 1)
// ---------------------------------------------------------------------------
// Pass 1 covers the inventory grid + a basic single-unit workspace (overview,
// component-based pricing, documents/renders, a thin activity log). The full
// sales workflow (holds, reservations, payments, linked packages, client
// changes, handover, split/merge) is Pass 2 — deliberately not modeled yet.

model ProjectStructure {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("BUILDING") // BUILDING | BLOCK | TOWER | PHASE | ZONE
  order     Int      @default(0)
  createdAt DateTime @default(now())

  floors ProjectFloor[]
  units  Unit[]

  @@unique([projectId, name])
  @@index([tenantId, projectId])
}

model ProjectFloor {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structureId String
  structure   ProjectStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  label       String // "Ground Floor", "Level 3"
  level       Int // signed, for sorting — basements negative
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  units Unit[]

  @@unique([structureId, label])
  @@index([tenantId, structureId])
}

model Unit {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  structureId String?
  structure   ProjectStructure? @relation(fields: [structureId], references: [id])
  floorId     String?
  floor       ProjectFloor?     @relation(fields: [floorId], references: [id])

  code        String
  type        String // APARTMENT | VILLA | OFFICE | PARKING | RETAIL | STORAGE | HOTEL_ROOM | LAND_PLOT | CUSTOM
  displayName String?

  orientation String?
  view        String?
  features    String?
  notes       String?

  // Physical build progress — distinct from lifecycleStatus (the sales state machine).
  constructionStatus String? // PLANNED | UNDER_CONSTRUCTION | COMPLETED
  lifecycleStatus    String  @default("DRAFT")

  currency        String  @default("EUR")
  fixedAdjustment Float   @default(0)
  // JSON string of type-specific field values, keyed by the hardcoded per-type
  // schema in lib/constants.ts (UNIT_TYPE_FIELDS) — matches DomainEvent.payload's
  // existing String-for-JSON convention rather than introducing the Json scalar.
  typeFields      String?

  pinnedRenderId String?     @unique
  pinnedRender   UnitRender? @relation("UnitPinnedRender", fields: [pinnedRenderId], references: [id], onDelete: SetNull)

  // Optimistic concurrency — compare-and-swap on every update.
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  areaComponents UnitAreaComponent[]
  renders        UnitRender[]        @relation("UnitRenderGallery")
  documentFiles  DocumentFile[]
  activityEvents UnitActivityEvent[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@index([tenantId, structureId])
  @@index([tenantId, floorId])
  @@index([tenantId, lifecycleStatus])
}

model UnitAreaComponent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  componentType   String // INTERNAL | BALCONY | TERRACE | GARDEN | STORAGE | CUSTOM
  label           String
  areaM2          Float
  pricePerM2      Float
  // Exactly one true per unit — an application-layer invariant (Prisma/SQLite
  // can't express "exactly one" declaratively), enforced transactionally
  // whenever a unit's component set is written. Main must always have
  // includedInTotal true, or a "final total" edit becomes a silent no-op.
  isMain          Boolean @default(false)
  includedInTotal Boolean @default(true)
  order           Int     @default(0)

  // subtotal is NEVER stored — always areaM2 * pricePerM2, computed at read
  // time. No staleness risk, matches PRD_Unit_Page §6's "not a separate
  // source of truth" language for derived pricing values.

  @@index([tenantId, unitId])
}

model UnitRender {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit         @relation("UnitRenderGallery", fields: [unitId], references: [id], onDelete: Cascade)
  fileData     Bytes
  fileMimeType String
  fileSize     Int
  checksum     String
  uploadedById String
  uploadedBy   UserIdentity @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  pinnedByUnit Unit? @relation("UnitPinnedRender")

  @@index([tenantId, unitId])
}

model UnitActivityEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Pass 1 subset: UNIT_CREATED | UNIT_UPDATED | STATUS_CHANGED | ARCHIVED |
  // RESTORED. Pass 2 adds sales/payment/handover/split/merge event types.
  eventType String
  actorId   String
  actor     UserIdentity @relation(fields: [actorId], references: [id])
  summary   String
  metadata  String?
  createdAt DateTime     @default(now())

  @@index([tenantId, unitId])
}

model Task {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code              String
  title             String
  description       String?
  visibility        String        @default("COMPANY_PUBLIC") // PRIVATE | DEPARTMENT_PUBLIC | COMPANY_PUBLIC
  status            String        @default("TO_DO") // TO_DO | IN_PROGRESS | REVIEW | APPROVED | COMPLETED | BLOCKED | ON_HOLD | NEEDS_REVISION | REJECTED | OVERDUE
  priority          String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  dueDate           DateTime?
  createdById       String
  createdBy         UserIdentity  @relation("TaskCreator", fields: [createdById], references: [id])
  mainResponsibleId String?
  mainResponsible   UserIdentity? @relation("TaskResponsible", fields: [mainResponsibleId], references: [id])
  // PRD_3 — set when this task was generated from a client comment @mention.
  // Permanent two-way link: the comment is never deleted/rewritten when the
  // task changes, and vice versa (CCT-003, CCT-044).
  sourceCommentId   String?       @unique
  sourceComment     Comment?      @relation("TaskSourceComment", fields: [sourceCommentId], references: [id])
  // Accountable "department" for a department-only or department+individual
  // mention, using the same Role vocabulary the rest of the app already
  // treats as departments (ARCHITECT, LEGAL, FINANCE, ...) rather than
  // introducing a separate Department entity.
  departmentRole    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // --- PRD_4 Cross-Department Task Orchestration -----------------------
  // A task becomes "orchestrated" the moment it has stages attached
  // (task-orchestration.ts's startOrchestration()) — plain tasks (simple
  // checklist items, PRD_3 client-comment tasks) are unaffected and never
  // touch these fields. `status` above keeps its existing TO_DO/IN_PROGRESS/…
  // vocabulary for plain tasks; `orchestrationStatus` is a parallel field
  // using PRD_4 §6.3's richer parent-status vocabulary once orchestration
  // starts, so the two systems never collide on one column's meaning.
  orchestrationStatus  String? // DRAFT | SUBMITTED | UNDER_TRIAGE | ACTIVE | WAITING_FOR_INFORMATION |
  // WAITING_FOR_APPROVAL | WAITING_FOR_CONTRACT | WAITING_FOR_PROCUREMENT |
  // WAITING_FOR_CONTRACTOR | SCHEDULED | IN_EXECUTION | WAITING_FOR_INSPECTION |
  // UNDER_FINAL_VERIFICATION | COMPLETED | REJECTED | CANCELLED | REOPENED | ARCHIVED
  category             String? // free classification, e.g. "Facade Repair", "MEP Fault"
  severity             String? // LOW | MEDIUM | HIGH | CRITICAL — distinct from `priority` (2.1 Classification)
  riskLevel            String? // LOW | MEDIUM | HIGH
  locationDetail       String? // e.g. "Block A / East Facade / Levels 3-5" — free text; no Building/Unit model exists yet
  startDate            DateTime?
  forecastDate         DateTime?
  actualCompletionDate DateTime?
  taskManagerId        String?
  taskManager          UserIdentity? @relation("TaskManager", fields: [taskManagerId], references: [id])
  decisionOwnerId      String?
  decisionOwner        UserIdentity? @relation("TaskDecisionOwner", fields: [decisionOwnerId], references: [id])
  finalApproverId      String?
  finalApprover        UserIdentity? @relation("TaskFinalApprover", fields: [finalApproverId], references: [id])
  currentStageId       String?
  currentStage         TaskStage?    @relation("TaskCurrentStage", fields: [currentStageId], references: [id])

  contributions  TaskContribution[]
  dependsOn      TaskDependency[]    @relation("DependentTask")
  dependedOnBy   TaskDependency[]    @relation("DependsOnTask")
  documents      DocumentFile[]
  stars          TaskStar[]
  checklistItems TaskChecklistItem[]

  stages                TaskStage[]                    @relation("TaskStages")
  departments           TaskDepartment[]
  participants          TaskParticipant[]
  events                TaskEvent[]
  approvals             TaskApproval[]
  involvementRequests   DepartmentInvolvementRequest[]
  escalations           TaskEscalation[]
  delayExplanations     TaskDelayExplanation[]
  contractLinks         TaskContractLink[]
  contractorAssignments TaskContractorAssignment[]
  inspections           TaskInspection[]
  completionRecords     TaskCompletionRecord[]
  reopeningRecords      TaskReopeningRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, dueDate])
  @@index([mainResponsibleId])
}

// ---------------------------------------------------------------------------
// PRD_4 — Cross-Department Task Orchestration. Additive: governs a task's
// life *after* creation (assignment, department involvement, approvals,
// contracts, contractor execution, inspection, closure) without altering the
// plain-task rules PRD_1/PRD_3 already established. See Task.orchestrationStatus
// for how the two systems coexist on one Task row.
// ---------------------------------------------------------------------------

// One reusable reference workflow ships built-in (§6.2's reference flow,
// also §15's facade-repair walkthrough) rather than a full visual workflow-
// template builder — that configurable builder is Appendix A's P2-Advanced
// scope, explicitly out of this pass.
model TaskStage {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation("TaskStages", fields: [taskId], references: [id], onDelete: Cascade)
  key         String // stable machine key, e.g. "PM_TRIAGE", "ENGINEERING_ASSESSMENT"
  label       String
  sequence    Int
  isParallel  Boolean       @default(false)
  status      String        @default("PENDING") // PENDING | ACTIVE | WAITING | COMPLETED | SKIPPED | REJECTED
  skipReason  String?
  skippedById String?
  skippedBy   UserIdentity? @relation("StageSkippedBy", fields: [skippedById], references: [id])
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  currentForTask Task[] @relation("TaskCurrentStage")

  @@unique([taskId, key])
}

// CTO-003/CTO-011 — adding a department creates one accountable owner, not
// just a watcher.
model TaskDepartment {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  department      String // Role vocabulary (ENGINEER, ARCHITECT, PROCUREMENT, LEGAL, FINANCE, QAQC, HSE, PM, ...)
  ownerId         String
  owner           UserIdentity @relation("TaskDepartmentOwner", fields: [ownerId], references: [id])
  isMandatory     Boolean      @default(true)
  activatedReason String? // manual request reason, or the auto-routing rule name that activated it
  createdAt       DateTime     @default(now())

  deliverable DepartmentDeliverable?

  @@unique([taskId, department])
}

model DepartmentDeliverable {
  id                     String                  @id @default(cuid())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskDepartmentId       String                  @unique
  taskDepartment         TaskDepartment          @relation(fields: [taskDepartmentId], references: [id], onDelete: Cascade)
  requiredAction         String
  expectedOutput         String?
  deadline               DateTime?
  status                 String                  @default("NOT_STARTED")
  // NOT_STARTED | WAITING_FOR_DEPENDENCY | ACTIVE | INFORMATION_REQUESTED | SUBMITTED | UNDER_REVIEW |
  // APPROVED | REJECTED | REVISION_REQUIRED | NOT_REQUIRED | BLOCKED | COMPLETED
  requiresApproval       Boolean                 @default(true)
  notRequiredReason      String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  blockedByDeliverableId String?
  blockedByDeliverable   DepartmentDeliverable?  @relation("DeliverableDependency", fields: [blockedByDeliverableId], references: [id])
  blocksDeliverables     DepartmentDeliverable[] @relation("DeliverableDependency")
  createdAt              DateTime                @default(now())

  approvals         TaskApproval[]
  delayExplanations TaskDelayExplanation[]
}

// Many-to-many contributors/reviewers/watchers. The single-owner roles
// (Task Manager, Decision Owner, Final Approver, Department Owner) are FKs
// above/on TaskDepartment per CTO-010/CTO-011 — exactly one accountable
// person, not a set.
model TaskParticipant {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     UserIdentity @relation("TaskParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  role     String // CONTRIBUTOR | REVIEWER | WATCHER
  addedAt  DateTime     @default(now())

  @@unique([taskId, userId, role])
}

// CTO-002/CTO-006/CTO-050 — append-only immutable timeline. The app layer
// only ever calls create() against this table; there is no update/delete path.
model TaskEvent {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         UserIdentity? @relation("TaskEventActor", fields: [actorId], references: [id])
  actorRole     String?
  eventType     String // TASK_CREATED | ORCHESTRATION_STARTED | STAGE_TRANSITION | DEPARTMENT_ACTIVATED |
  // DELIVERABLE_SUBMITTED | APPROVAL_RECORDED | FILE_UPLOADED | CONTRACT_LINKED |
  // CONTRACTOR_ASSIGNED | CONTRACTOR_ACTION | INSPECTION_RECORDED | DELAY_EXPLAINED |
  // ESCALATED | ESCALATION_ACKNOWLEDGED | TASK_COMPLETED | TASK_REOPENED
  summary       String
  previousState String?
  newState      String?
  metadata      String? // JSON-encoded string
  createdAt     DateTime      @default(now())

  @@index([taskId, createdAt])
}

// CTO-061 — a typed approval action, never a plain comment.
model TaskApproval {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   DepartmentDeliverable? @relation(fields: [deliverableId], references: [id])
  approverId    String
  approver      UserIdentity           @relation("TaskApprover", fields: [approverId], references: [id])
  action        String // APPROVE | APPROVE_WITH_CONDITIONS | REJECT | REQUEST_REVISION | REQUEST_INFO | DELEGATE
  comment       String?
  conditions    String? // JSON-encoded array of required condition strings
  conditionsMet Boolean                @default(false)
  delegatedToId String?
  delegatedTo   UserIdentity?          @relation("TaskApprovalDelegate", fields: [delegatedToId], references: [id])
  fileId        String?
  createdAt     DateTime               @default(now())

  @@index([taskId])
  @@index([delegatedToId])
}

model DepartmentInvolvementRequest {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId             String
  task               Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        UserIdentity  @relation("InvolvementRequester", fields: [requestedById], references: [id])
  department         String
  reason             String
  requestedAction    String?
  desiredDeadline    DateTime?
  shouldBlock        Boolean       @default(true)
  status             String        @default("PENDING") // PENDING | ACTION_REQUIRED | COMMENT_ONLY | NOT_REQUIRED | INFO_REQUESTED | REDIRECTED
  response           String?
  redirectDepartment String?
  respondedById      String?
  respondedBy        UserIdentity? @relation("InvolvementResponder", fields: [respondedById], references: [id])
  respondedAt        DateTime?
  createdAt          DateTime      @default(now())
}

model TaskEscalation {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserId     String?
  fromUser       UserIdentity? @relation("EscalationFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         UserIdentity  @relation("EscalationTo", fields: [toUserId], references: [id])
  reason         String
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([toUserId])
}

model TaskDelayExplanation {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId             String
  task               Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverableId      String?
  deliverable        DepartmentDeliverable? @relation(fields: [deliverableId], references: [id])
  cause              String
  progressPct        Int
  newExpectedDate    DateTime
  blockingDependency String?
  costImpact         Float?
  scheduleImpactDays Int?
  correctiveAction   String?
  authorId           String
  author             UserIdentity           @relation("DelayExplanationAuthor", fields: [authorId], references: [id])
  createdAt          DateTime               @default(now())
}

// Contracts/quotations/POs remain separate objects (§9) — this just links
// and records the routing decision, never duplicates the contract's data.
model TaskContractLink {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?    @relation(fields: [contractId], references: [id])
  decision    String // EXISTING_CONTRACT | VARIATION_REQUIRED | NEW_CONTRACT_REQUIRED | NOT_REQUIRED | FURTHER_ASSESSMENT
  reason      String?
  createdById String
  createdBy   UserIdentity @relation("ContractLinkCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

// The restricted external work package (§10) — a contractor sees only this,
// never the project/client/finance modules (CTO-100).
model TaskContractorAssignment {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contractorId         String
  contractor           Contractor   @relation(fields: [contractorId], references: [id])
  contractId           String?
  contract             Contract?    @relation(fields: [contractId], references: [id])
  scope                String
  status               String       @default("ASSIGNED")
  // ASSIGNED | ACCEPTED | CLARIFICATION_REQUESTED | SCHEDULED | IN_PROGRESS | DELAYED | READY_FOR_INSPECTION | REWORK_REQUIRED | COMPLETED
  plannedStart         DateTime?
  deadline             DateTime?
  acceptedAt           DateTime?
  readyForInspectionAt DateTime?
  assignedById         String
  assignedBy           UserIdentity @relation("ContractorAssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt            DateTime     @default(now())
}

model TaskInspection {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedAt DateTime      @default(now())
  inspectorId String?
  inspector   UserIdentity? @relation("TaskInspector", fields: [inspectorId], references: [id])
  result      String? // PASSED | PASSED_WITH_OBSERVATIONS | FAILED | REWORK_REQUIRED | ADDITIONAL_INSPECTION_REQUIRED
  notes       String?
  inspectedAt DateTime?
  createdAt   DateTime      @default(now())
}

model TaskCompletionRecord {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedById String
  completedBy   UserIdentity @relation("TaskCompletedBy", fields: [completedById], references: [id])
  comment       String
  actualDate    DateTime     @default(now())
  gatesSnapshot String // JSON-encoded snapshot of the completion checklist at closure time
  createdAt     DateTime     @default(now())

  reopenings TaskReopeningRecord[]
}

// CTO-082 — reopening starts a new lifecycle segment; the prior completion
// record is never edited or deleted.
model TaskReopeningRecord {
  id                         String               @id @default(cuid())
  tenantId                   String
  tenant                     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId                     String
  task                       Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reopenedById               String
  reopenedBy                 UserIdentity         @relation("TaskReopenedBy", fields: [reopenedById], references: [id])
  reason                     String
  newIssue                   String?
  newDeadline                DateTime?
  riskImpact                 String?
  previousCompletionRecordId String
  previousCompletionRecord   TaskCompletionRecord @relation(fields: [previousCompletionRecordId], references: [id])
  createdAt                  DateTime             @default(now())
}

model TaskContribution {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?
  deliverable String?
  status      String       @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  createdAt   DateTime     @default(now())
}

model TaskDependency {
  id            String @id @default(cuid())
  taskId        String
  task          Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOnTask Task   @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

// ---------------------------------------------------------------------------
// PRD_Tasks_Module — additive layer on top of the Task model above. §4's
// "participant-based privacy" is already enforced by canViewTask()
// (src/lib/project-access.ts, PRD_10) via Task.visibility/TaskParticipant;
// this only adds the collaborative surface the PRD's Task Page needs that
// didn't already exist: a private per-user Star (§14) and a shared,
// participant-editable Checklist (§9). Watchers reuse TaskParticipant's
// existing WATCHER role rather than a separate model; Activity reuses
// TaskEvent; discussion reuses the platform's generic Comment model
// (already wired to Task via listComments(tenantId, "Task", id)).
// ---------------------------------------------------------------------------

// §14 Personal Star — private, does not touch official priority, never
// notifies. Mirrors DocumentFavorite's shape.
model TaskStar {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation("TaskStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([taskId, userId])
  @@index([tenantId, userId])
}

// §9 Shared Checklist — collaborative To-Do items any participant may add,
// claim or complete. Every check/uncheck is also written to TaskEvent so it
// appears in the Activity Timeline (§9: "must appear ... with user and
// timestamp").
model TaskChecklistItem {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  ownerId       String?
  owner         UserIdentity? @relation("TaskChecklistOwner", fields: [ownerId], references: [id])
  dueAt         DateTime?
  notes         String?
  completed     Boolean       @default(false)
  completedById String?
  completedBy   UserIdentity? @relation("TaskChecklistCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  sortOrder     Int           @default(0)
  createdById   String
  createdBy     UserIdentity  @relation("TaskChecklistCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId, taskId])
}

// ---------------------------------------------------------------------------
// Collaboration: comments, timeline, notifications, audit
// ---------------------------------------------------------------------------

model Comment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId       String
  author         UserIdentity @relation(fields: [authorId], references: [id])
  body           String
  classification String? // DECISION | QUESTION | ISSUE | INFORMATION
  targetType     String // "Task" | "Project" | "Client" | ...
  targetId       String
  createdAt      DateTime     @default(now())

  // PRD_3 — a comment (currently only used on Client profiles) can spawn at
  // most one task via @mention; the FK lives on Task (see
  // Task.sourceCommentId) so this is the 1:1 reverse side.
  createdTask Task? @relation("TaskSourceComment")
}

model Suggestion {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime     @default(now())
}

model TimelineEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  eventType  String
  actorId    String?
  metadata   String? // JSON-encoded string
  createdAt  DateTime @default(now())
}

model Notification {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId, isRead])
}

// Per-user, per-event-category channel choice (Section 14 — "each user
// chooses channels, subject to company defaults and critical-event rules").
model NotificationPreference {
  id       String       @id @default(cuid())
  userId   String
  user     UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // TASKS | APPROVALS | FINANCE | PROJECTS
  inApp    Boolean      @default(true)
  email    Boolean      @default(false)
  whatsapp Boolean      @default(false)

  @@unique([userId, category])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Audit 2 §5 "Cross-Module Interaction Through Domain Events" — transactional
// outbox for the Contract Approved -> Finance Structure -> Payment Recorded
// reference workflow (src/lib/domain-events.ts). Written inside the SAME
// transaction as the state change that raised it, so the event can never be
// lost even if in-process dispatch fails right after commit; a row left
// PENDING/FAILED here is exactly what a future background worker would
// sweep and retry, without any schema change.
model DomainEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // e.g. "ContractApproved", "PaymentRecorded"
  payload     String // JSON
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // PRD_18 §11 context envelope — additive, nullable so pre-existing rows
  // and any future caller that omits context still work.
  correlationId   String? // links a business process across events/retries; defaults to this event's own id when root
  causationId     String? // the event that caused this one, if any
  actorUserId     String?
  actorSnapshot   String? // JSON ActorSnapshot at emit time
  sourceModule    String?
  sourceRecordId  String?
  owningCompanyId String?
  projectId       String?
  confidentiality String?

  @@index([tenantId, status])
  @@index([correlationId])
}

// ---------------------------------------------------------------------------
// Phase-1 dashboard support tables (minimal slices of Phase 2+ modules,
// just enough to render real Finance/HR/Architect dashboard data)
// ---------------------------------------------------------------------------

model FinanceAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  type     String // OPERATING | PAYROLL | SAVINGS | TAX | PETTY_CASH
  balance  Float
  currency String @default("EUR")
}

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  // Set only on the type="PAYMENT" invoices auto-created by the
  // ContractApproved reaction (src/server/contract-lifecycle-reactions.ts)
  // as the contract's "Finance Structure" — not a client-facing field.
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  number      String
  type        String // INVOICE | BILL | PAYMENT | EXPENSE
  description String?
  amount      Float
  currency    String    @default("EUR")
  status      String    @default("PENDING") // legacy: PAID | PENDING | SENT | OVERDUE | COMPLETED
  // PRD_2 posting lifecycle (§8.1) also uses this column:
  // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | POSTED | REVERSED
  issuedDate  DateTime  @default(now())
  dueDate     DateTime?
  postedAt    DateTime?
  postedById  String?

  ledgerEntries FinancialLedgerEntry[]

  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, contractId])
}

model Employee {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?       @unique
  user         UserIdentity? @relation(fields: [userId], references: [id])
  fullName     String
  position     String
  department   String
  hireDate     DateTime
  status       String        @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  avatarColor  String        @default("#1A1D23")
  birthday     DateTime?
  // Employee Profile — contact info shown to any active company member so
  // colleagues can reach out; a base64 data URL rather than a real file/blob
  // store, since this app has no object storage anywhere (every other
  // "document" feature is metadata-only) — this is the one place a real
  // inline image is actually rendered, so it needs real bytes, not just a name.
  phone        String?
  photoDataUrl String?
  // PRD_9 LEV-001 — "direct superior" for leave-request creation. Self-relation
  // rather than reusing CompanyMembership.managerId (a dormant, unused, un-typed
  // field with no clear FK target) since leave lives on Employee, not on the
  // tenant-membership record.
  managerId    String?
  manager      Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])

  leaveRequests LeaveRequest[]
  reports       Employee[]         @relation("EmployeeManager")
  documents     DocumentFile[]
  // Salary History — see SalaryRecord below; access is gated to HR/Finance/
  // Admin/Owner via canViewSalary() in src/server/employee-profile.ts. Not
  // even the employee themselves sees this (unlike Work Contract/CV).
  salaryRecords SalaryRecord[]
  trainings     EmployeeTraining[]

  @@index([tenantId, department])
}

// Time-boxed salary history — every change creates a new record; past
// records are never overwritten, only superseded (status flips CURRENT ->
// PREVIOUS and effectiveEndDate is set). HR is the single source of truth;
// Finance reads the CURRENT record directly for payroll/cost/forecast
// calculations rather than maintaining its own duplicate.
model SalaryRecord {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  currency           String        @default("EUR") // EUR | ALL
  grossSalary        Float
  netSalary          Float
  paymentFrequency   String        @default("MONTHLY") // MONTHLY | BIWEEKLY | WEEKLY | ANNUAL
  status             String        @default("CURRENT") // CURRENT | PREVIOUS
  notes              String?
  createdById        String
  createdBy          UserIdentity  @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          UserIdentity? @relation("SalaryRecordUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, status])
}

// Per-company module registry — absence of a row means enabled (so
// existing tenants keep every feature they already had); only an explicit
// disabled row hides a module's nav items via visibleNavSections().
model CompanyModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
}

// Employee-facing training records — HR assigns, each employee sees only
// their own (self-or-HR gate, mirrors canViewWorkContract).
model EmployeeTraining {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name          String
  provider      String?
  status        String       @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED | EXPIRED
  assignedById  String
  assignedBy    UserIdentity @relation("TrainingAssignedBy", fields: [assignedById], references: [id])
  dueDate       DateTime?
  completedDate DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, employeeId])
}

model LeaveRequest {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  status      String        @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reason      String?
  createdAt   DateTime      @default(now())
  // PRD_9 §4.1 — who created the request (the employee themselves, their
  // direct superior, or HR on someone's behalf) and, once decided, who at HR
  // decided it. Nullable: rows created before this PRD had no such actor.
  createdById String?
  createdBy   UserIdentity? @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  decidedById String?
  decidedBy   UserIdentity? @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model HrAppointment {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  type          String       @default("INTERVIEW") // INTERVIEW | INTERNAL | OTHER
  candidateName String?
  scheduledAt   DateTime
  notes         String?
  createdById   String
  createdBy     UserIdentity @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
}

model Drawing {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageName  String
  discipline   String?
  revisionCode String
  status       String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | NEEDS_REVISION
  updatedAt    DateTime @updatedAt
}

model RFI {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  title        String
  status       String    @default("OPEN") // OPEN | ANSWERED | OVERDUE
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
}

model HseReport {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String
  severity     String       @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status       String       @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  reportedById String
  reportedBy   UserIdentity @relation(fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Procurement — suppliers and purchase orders. Deliberately separate from
// Contractor/Contract (those are subcontractors executing project work;
// suppliers/POs are materials & goods purchasing), and gated by its own
// "PROCUREMENT" resource so it's a real, independent department like HR or
// Finance rather than a sub-feature bolted onto Contracts.
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number    String // Number Series: SUP-{SEQ6}
  name      String
  category  String // e.g. Steel, Concrete, Electrical, MEP
  email     String?
  phone     String?
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String // Number Series: PO-{YYYY}-{SEQ5}
  projectId     String?
  project       Project?     @relation(fields: [projectId], references: [id])
  supplierId    String
  supplier      Supplier     @relation(fields: [supplierId], references: [id])
  description   String
  amount        Float
  currency      String       @default("EUR")
  status        String       @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ORDERED | RECEIVED | CANCELLED
  requestedById String
  requestedBy   UserIdentity @relation(fields: [requestedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// PRD_1 additional master entities — Card-page entities per PRD_2 §4.3's
// required catalog (Company/Project/Employee/Contractor/Contract/Drawing
// already exist above; this section adds the remaining ones).
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  // --- PRD_Teams_Module (additive) ---------------------------------------
  // §5 — a free string, not an enum: "Team types are configurable and must
  // not be hard-coded." TEAM_TYPE_SUGGESTIONS in teams-module.ts seeds the
  // picker with the PRD's starter list; admins may enter any custom value.
  teamType   String?
  leadId     String?
  lead       UserIdentity? @relation("TeamLead", fields: [leadId], references: [id])
  archivedAt DateTime?

  members TeamMember[]
}

model TeamMember {
  id        String       @id @default(cuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  // §6 — describes responsibility *within the team*; explicitly does not
  // replace or alter the user's employment position (Team Roles ≠ job title).
  role String @default("MEMBER") // LEADER | DEPUTY_LEADER | COORDINATOR | REVIEWER | CONTRIBUTOR | SPECIALIST | EXTERNAL_MEMBER | OBSERVER | MEMBER | <custom>

  @@unique([teamId, userId])
}

// Sales-owned client relationship record — deliberately separate from
// Contractor (a different resource, "CLIENTS" vs "COMPANY_NETWORK", so a
// role can be granted one without the other; Sales has CLIENTS but not
// COMPANY_NETWORK, matching that clients and contractors are unrelated
// counterparties from the company's side of the table).
model Client {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  status      String       @default("ACTIVE") // ACTIVE | PROSPECT | INACTIVE
  createdById String
  createdBy   UserIdentity @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  projects  Project[]
  documents DocumentFile[]
  tasks     Task[]

  // --- PRD_CRM_Module (additive) ------------------------------------------
  // §7 — configurable, not an enum, same pattern as Team Type.
  clientType             String?
  // §11 Client Page Header "Assigned salesperson" / §14 "account owner".
  ownerId                String?
  owner                  UserIdentity? @relation("ClientOwner", fields: [ownerId], references: [id])
  // §18 — how this client first reached the company; configurable string.
  source                 String?
  country                String?
  preferredContactMethod String?
  archivedAt             DateTime?

  contacts      Contact[]
  notes         ClientNote[]
  opportunities Opportunity[]
  leads         Lead[]
  stars         ClientStar[]

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// PRD_CRM_Module — additive layer. §46 Data Ownership Rules: CRM owns
// clients, contacts, leads, opportunities, pipelines and notes; it never
// owns units/contracts/finance/documents/tasks, all of which stay
// source-linked (projectId/contractId-style FKs) rather than duplicated.
// Phase-1 scope: Contacts, Notes, Leads and a configurable Sales Pipeline —
// Reservation/ClientPurchase/Communication/SupportCase/Referral/CRMActivity
// are deferred (they read from Units/Contracts/Finance, which aren't wired
// for that yet).
// ---------------------------------------------------------------------------

// §15/§16 — a person tied to a client (an individual client may itself act
// as its own primary contact; a company client typically has several).
model Contact {
  id                     String        @id @default(cuid())
  tenantId               String
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId               String
  client                 Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                   String
  title                  String?
  department             String?
  email                  String?
  phone                  String?
  preferredContactMethod String?
  // §16 — configurable, not an enum (Decision Maker | Legal Representative |
  // Finance Contact | Technical Contact | Sales Contact | Executive Sponsor |
  // Assistant | Family Member | Advisor | custom).
  role                   String?
  decisionInfluence      String?
  status                 String        @default("ACTIVE")
  notes                  String?
  relationshipOwnerId    String?
  relationshipOwner      UserIdentity? @relation("ContactOwner", fields: [relationshipOwnerId], references: [id])
  createdAt              DateTime      @default(now())

  opportunities Opportunity[]

  @@index([tenantId, clientId])
}

// §32 — an internal note, distinct from a Communication log (deferred).
model ClientNote {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    UserIdentity @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  body      String
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId])
}

// §21 — "Pipeline stages are managed through Platform Configuration" in the
// full PRD; Phase-1 keeps them as tenant-editable rows rather than wiring
// the Platform Configuration node tree for per-stage config.
model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  stages        PipelineStage[]
  opportunities Opportunity[]
}

// §22 — the default example (Lead, Contacted, Qualified, Meeting, Site
// Visit, Negotiation, Reservation, Contract, Deposit Paid, Completed, After
// Sales) is seeded by ensureDefaultPipeline(), not hard-coded here.
model PipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  orderNo     Int
  probability Int      @default(0)
  status      String   @default("ACTIVE")

  opportunities Opportunity[]

  @@unique([pipelineId, orderNo])
}

// §20 — a qualified deal in progress, tied to a Client (and optionally a
// Project/Unit of interest via a source-linked id, no duplication of Units
// module data).
model Opportunity {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id])
  // Deliberately a bare id, no Prisma relation() — Projects is frozen and
  // must not gain a back-relation field. Same "source-linked, not owned"
  // pattern as DocumentLink/TaskLink's generic entityId references.
  projectId       String?
  title           String
  estimatedValue  Float?
  expectedCloseAt DateTime?
  ownerId         String?
  owner           UserIdentity? @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  // §21 — separate from pipeline stage: a deal can only be OPEN, WON or LOST.
  status          String        @default("OPEN") // OPEN | WON | LOST
  lostReason      String?
  stageEnteredAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, clientId])
}

// §17/§18/§19 — pre-qualification: may exist before a full Client record
// does. "Convert" creates/links a Client and an Opportunity (teams-module.ts
// style additive service, see convertLead()).
model Lead {
  id                     String        @id @default(cuid())
  tenantId               String
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                  String
  clientId               String?
  client                 Client?       @relation(fields: [clientId], references: [id])
  personName             String?
  personEmail            String?
  personPhone            String?
  // §18 — configurable, not an enum.
  source                 String?
  campaign               String?
  ownerId                String?
  owner                  UserIdentity? @relation("LeadOwner", fields: [ownerId], references: [id])
  interest               String?
  estimatedValue         Float?
  // NEW | CONTACTED | QUALIFIED | DISQUALIFIED | CONVERTED | LOST
  status                 String        @default("NEW")
  priority               String        @default("NORMAL") // LOW | NORMAL | HIGH
  nextActionAt           DateTime?
  qualificationScore     Int?
  qualificationNotes     String?
  lostReason             String?
  convertedOpportunityId String?       @unique
  createdAt              DateTime      @default(now())

  @@index([tenantId, status])
}

// §9 — Personal Star, same private/per-user pattern as Documents/Tasks.
model ClientStar {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation("ClientStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, userId])
  @@index([tenantId, userId])
}

model Contractor {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // Number Series: CTR-{SEQ6}
  name        String
  tradeType   String
  email       String?
  phone       String?
  // Local business identifiers — NIPT is Albania's tax identification number.
  taxId       String?
  bankAccount String?
  status      String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  riskRating  String   @default("LOW") // LOW | MEDIUM | HIGH
  createdAt   DateTime @default(now())

  // PRD_4 §10/§14 — an optional portal login for this contractor, restricted
  // to their own TaskContractorAssignments (CTO-100 task-scoped access).
  // Most contractor profiles have no login at all; this is opt-in per contractor.
  userId String?       @unique
  user   UserIdentity? @relation("ContractorLogin", fields: [userId], references: [id])

  contracts    Contract[]
  assignments  TaskContractorAssignment[]
  workPackages ProjectWorkPackage[]

  @@index([tenantId, status])
}

model Contract {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id])
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  number       String // Number Series: CON-{YYYY}-{SEQ5}
  title        String
  value        Float
  currency     String      @default("EUR")
  // Controlled lifecycle (Audit 2 §7) — the only writer of this field is
  // src/server/contract-lifecycle.ts's transition guard, not ad-hoc updates.
  // DRAFT -> ACTIVE (approveContract) -> COMPLETED (auto, once posted
  // PAYMENT invoices reach the contract value) | TERMINATED.
  status       String      @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | TERMINATED
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime    @default(now())

  taskLinks       TaskContractLink[]
  taskAssignments TaskContractorAssignment[]
  invoices        Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

model DocumentFile {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id])
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Employee Profile — CV/certification/work-contract attachments. Reuses
  // this same document model rather than a parallel one (matches every other
  // "attach a file" feature in the app), with `visibility` gating who besides
  // the uploader can see it: COMPANY (default, the profile directory) or
  // PRIVATE_HR (work contracts — only the employee themselves and HR).
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // PRD_Rework_1 — an existing project document picked as an Approval's
  // attachment, rather than a separate upload path/blob table.
  projectApprovalId String?
  projectApproval   ProjectApproval? @relation(fields: [projectApprovalId], references: [id])
  // PRD_Units / PRD_Unit_Page — a unit's floor plan, technical drawings and
  // other attachments, same optional-FK pattern as every other polymorphic
  // owner on this model.
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  visibility        String           @default("COMPANY")
  name              String
  category          String           @default("General")
  // PRD_4 §8.2 categories (INITIAL_EVIDENCE | TECHNICAL_ASSESSMENT | DRAWING |
  // CALCULATION | SPECIFICATION | QUOTATION | PURCHASE_ORDER | CONTRACT |
  // CONTRACT_VARIATION | METHOD_STATEMENT | SAFETY_DOCUMENT | INSPECTION |
  // COMPLETION_EVIDENCE | INVOICE | PAYMENT_EVIDENCE | FINAL_RECORD) apply when
  // taskId is set; pre-existing free-text categories are unaffected otherwise.
  version           Int              @default(1)
  status            String           @default("DRAFT")
  // DRAFT | SUBMITTED | APPROVED (pre-existing) plus PRD_4 §8.3's fuller set when
  // task-attached: SUPPORTING | UNDER_REVIEW | REJECTED | SUPERSEDED | OFFICIAL | ARCHIVED
  uploadedById      String
  uploadedBy        UserIdentity     @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime         @default(now())

  // CTO-060 — an approved/official file is never overwritten; a changed
  // upload creates a new revision linked to the one it supersedes.
  supersedesId     String?       @unique
  supersedes       DocumentFile? @relation("DocumentRevision", fields: [supersedesId], references: [id])
  supersededBy     DocumentFile? @relation("DocumentRevision")
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       UserIdentity? @relation("DocumentApprover", fields: [approvedById], references: [id])
  taskStageId      String?
  taskDepartmentId String?

  // PRD_18 §12 Document Passport — the actual file. Nullable so the two
  // placeholder-document call sites (project/task creation "expected
  // document" checklist entries, no upload yet) keep working unmodified.
  fileData         Bytes?
  fileMimeType     String?
  fileSize         Int?
  checksum         String? // SHA-256 hex of fileData
  // Mandatory (enforced at the action layer) when supersedesId is set —
  // "what changed and why" per §13's revision-submission rule.
  revisionComment  String?
  // JSON ActorSnapshot (src/lib/actor-snapshot.ts) frozen at upload time —
  // survives the uploader's later role/company changes, per §12 "Immutable
  // origin".
  uploaderSnapshot String?

  approvals DocumentApproval[]

  // PRD_Documents_Module — when set, this row is one immutable revision of a
  // Document (the Passport record). Optional so every pre-existing call site
  // that treats DocumentFile as a standalone attachment keeps working.
  documentId   String?
  document     Document? @relation("DocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  // §15 — revision code/number, unique within one Document.
  revisionCode String?
  currentOf    Document? @relation("DocumentCurrentRevision")

  @@index([tenantId, projectId])
  @@index([tenantId, taskId])
  @@index([tenantId, clientId])
  @@index([tenantId, unitId])
  @@index([tenantId, documentId])
}

// PRD_18 §13 Blue Approval Ticket — an append-only decision ledger bound to
// one exact DocumentFile revision (not a mutable "approved" flag), so a
// REQUEST_CHANGES round can precede the eventual APPROVE without losing
// either decision's history.
model DocumentApproval {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentFileId   String
  documentFile     DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)
  approverId       String
  approver         UserIdentity @relation(fields: [approverId], references: [id])
  // JSON ActorSnapshot at decision time.
  approverSnapshot String
  decision         String // APPROVE | REQUEST_CHANGES | REJECT
  comment          String?
  createdAt        DateTime     @default(now())

  @@index([tenantId, documentFileId])
}

model Meeting {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  title       String
  scheduledAt DateTime
  location    String?
  organiserId String
  organiser   UserIdentity @relation(fields: [organiserId], references: [id])
  status      String       @default("PLANNED") // PLANNED | HELD | CANCELLED
  notes       String?
  createdAt   DateTime     @default(now())

  @@index([tenantId, scheduledAt])
}

model Asset {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  name          String
  type          String // EQUIPMENT | VEHICLE | TOOL | OTHER
  status        String   @default("AVAILABLE") // AVAILABLE | IN_USE | MAINTENANCE | RETIRED
  purchaseValue Float?
  createdAt     DateTime @default(now())
}

model TenantSettings {
  id              String @id @default(cuid())
  tenantId        String @unique
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultCurrency String @default("EUR")
  dateFormat      String @default("DD/MM/YYYY")
  timeFormat      String @default("12H") // 12H | 24H
  calendarDefault String @default("MONTH") // DAY | WEEK | MONTH
}

// ---------------------------------------------------------------------------
// PRD_2 — Number Series: centralized, atomic, per-tenant identifier
// generation (§6.2). Replaces ad hoc `count()`-based codes.
// ---------------------------------------------------------------------------

model NumberSeries {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "PROJECT" | "TASK" | "CONTRACT" | "CONTRACTOR" | "MEETING" | ...
  prefix     String
  nextValue  Int    @default(1)

  @@unique([tenantId, entityType])
}

// Same allocation pattern as NumberSeries, but for platform-level entities
// (PRD_6 applications/profiles) that have no tenant to scope under.
model PlatformNumberSeries {
  id         String @id @default(cuid())
  entityType String @unique // "APPLICATION" | "PROFILE"
  prefix     String
  nextValue  Int    @default(1)
}

// ---------------------------------------------------------------------------
// PRD_2 — Dimensions: reusable analytical tags attached to records (§7).
// Visibility/permissions are unaffected — dimensions are for reporting only.
// ---------------------------------------------------------------------------

model DimensionDefinition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // PROJECT | BRANCH | DEPARTMENT | COST_CENTER | PHASE | TRADE | ...
  label    String

  values DimensionValue[]

  @@unique([tenantId, code])
}

model DimensionValue {
  id           String              @id @default(cuid())
  definitionId String
  definition   DimensionDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  label        String

  recordDimensions RecordDimension[]
}

model RecordDimension {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType       String // "Invoice" | "Task" | ...
  entityId         String
  dimensionValueId String
  dimensionValue   DimensionValue @relation(fields: [dimensionValueId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, dimensionValueId])
}

// ---------------------------------------------------------------------------
// PRD_2 — Posting lifecycle & immutable Financial Ledger (§8, §10), built as
// a concrete vertical slice on Invoices. Stock/Contract/Progress/Time ledgers
// follow the identical pattern in a later phase — PRD_2's own rollout plan
// (§17.2) expects "posting_and_ledgers" to land module by module, not all at
// once, so this isn't a shortcut, it's the specified rollout shape.
// ---------------------------------------------------------------------------

model FinancialLedgerEntry {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice                @relation(fields: [invoiceId], references: [id])
  amount          Float
  currency        String                 @default("EUR")
  postedAt        DateTime               @default(now())
  postedById      String
  postedBy        UserIdentity           @relation(fields: [postedById], references: [id])
  reversesEntryId String?
  reversesEntry   FinancialLedgerEntry?  @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy      FinancialLedgerEntry[] @relation("Reversal")
}

// ---------------------------------------------------------------------------
// PRD_6 — Professional and Contractor Public Sign-Up. Deliberately outside
// the Tenant graph: a PublicAccount is not a company member and must never
// be reachable through tenant-scoped queries (public profile data and
// private company data stay separated per §2's non-interference rule).
// Approval never grants private workspace access — that's a distinct,
// separate ProfileInvitation a Company Admin sends afterward (§21).
// ---------------------------------------------------------------------------

model PublicAccount {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  preferredLanguage String    @default("sq")
  country           String
  timeZone          String
  accountType       String // PROFESSIONAL | CONTRACTOR
  status            String    @default("DRAFT")
  // DRAFT | EMAIL_VERIFICATION_REQUIRED | PROFILE_INCOMPLETE | READY_TO_SUBMIT |
  // PENDING_PLATFORM_REVIEW | CHANGES_REQUESTED | RESUBMITTED | APPROVED |
  // APPROVED_WITH_RESTRICTIONS | REJECTED | SUSPENDED | DEACTIVATED
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  professionalProfile     ProfessionalProfile?
  contractorProfile       ContractorProfile?
  documents               ProfileDocument[]
  portfolioProjects       PortfolioProject[]
  application             ProfileApplication?
  auditEvents             ProfileAuditEvent[]
  emailVerificationTokens EmailVerificationToken[]
  invitations             ProfileInvitation[]
}

model EmailVerificationToken {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  token           String        @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime      @default(now())
}

model ProfessionalProfile {
  id                     String        @id @default(cuid())
  publicAccountId        String        @unique
  publicAccount          PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  firstName              String?
  lastName               String?
  title                  String?
  primaryProfession      String?
  photoUrl               String?
  country                String?
  city                   String?
  headline               String?
  summary                String?
  yearsExperience        Int?
  employmentStatus       String? // EMPLOYED | SELF_EMPLOYED | FREELANCE | SEEKING_WORK | OTHER
  availabilityStatus     String? // AVAILABLE_NOW | AVAILABLE_FROM | NOT_AVAILABLE | OPEN_TO_OFFERS
  professionalEmail      String?
  phone                  String?
  website                String?
  linkedin               String?
  portfolioWebsite       String?
  addressVisibility      String        @default("PRIVATE") // PRIVATE | APPROVED_COMPANIES | SELECTED_COMPANIES | PUBLIC
  preferredContactMethod String?
  engagementTypes        String? // JSON array
  relocationAvailable    Boolean?
  expectedSalary         String?
  preferredProjectTypes  String? // JSON array
  preferredCompanyTypes  String? // JSON array
  workAuthorization      String?
  noticePeriod           String?
  availabilityDate       DateTime?

  experiences    ProfessionalExperience[]
  educations     ProfessionalEducation[]
  certifications ProfessionalCertification[]
  skills         ProfessionalSkill[]
}

model ProfessionalExperience {
  id               String              @id @default(cuid())
  profileId        String
  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  employer         String
  position         String
  employmentType   String?
  country          String?
  city             String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean             @default(false)
  description      String
  createdAt        DateTime            @default(now())
}

model ProfessionalEducation {
  id             String              @id @default(cuid())
  profileId      String
  profile        ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution    String
  degree         String
  fieldOfStudy   String
  country        String?
  startDate      DateTime
  graduationDate DateTime?
  ongoing        Boolean             @default(false)
  createdAt      DateTime            @default(now())
}

model ProfessionalCertification {
  id                  String              @id @default(cuid())
  profileId           String
  profile             ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String
  certificateNumber   String?
  issueDate           DateTime?
  expiryDate          DateTime?
  country             String?
  verificationUrl     String?
  createdAt           DateTime            @default(now())
}

// Professional, software and language skills share one flexible list rather
// than three rigid taxonomy tables — §8.6 keeps software/language skills
// optional and open-ended, so one categorized list captures the requirement
// without a hard-coded managed taxonomy this platform doesn't have yet.
model ProfessionalSkill {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String              @default("PROFESSIONAL") // PROFESSIONAL | SOFTWARE | LANGUAGE
  level     String?
}

model ContractorProfile {
  id                        String        @id @default(cuid())
  publicAccountId           String        @unique
  publicAccount             PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  contractorType            String? // REGISTERED_COMPANY | SOLE_TRADER | INDEPENDENT_CONTRACTOR | SPECIALIST_SUBCONTRACTOR | SUPPLIER_INSTALLER
  legalBusinessName         String?
  tradingName               String?
  registrationNumber        String?
  vatNumber                 String?
  countryOfRegistration     String?
  legalStructure            String?
  foundingYear              Int?
  headquarters              String?
  mainContactPerson         String?
  businessEmail             String?
  businessPhone             String?
  website                   String?
  companySize               String?
  shortDescription          String?
  fullDescription           String?
  primaryService            String?
  additionalServices        String? // JSON array
  countriesServed           String? // JSON array
  maxProjectDistance        String?
  internationalAvailability Boolean?
  typicalProjectSize        String?
  minContractValue          Float?
  maxContractValue          Float?
  activeTeams               String?
  equipmentCapacity         String?

  contacts ContractorContact[]
}

model ContractorContact {
  id        String            @id @default(cuid())
  profileId String
  profile   ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  role      String // OWNER | COMMERCIAL | TENDER | PROJECT_MANAGER | SITE_MANAGER | HSE | FINANCE | LEGAL
  email     String?
  phone     String?
  createdAt DateTime          @default(now())
}

// Shared portfolio entry for both account types (§8.8/§9.6) — a Professional
// shows personal contribution, a Contractor shows company-executed scope;
// same shape, same review/visibility rules either way.
model PortfolioProject {
  id                 String        @id @default(cuid())
  publicAccountId    String
  publicAccount      PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  title              String
  projectType        String
  location           String?
  completionYear     Int?
  clientOrEmployer   String?
  role               String
  description        String
  status             String        @default("COMPLETED") // CONCEPT | ONGOING | COMPLETED | CONFIDENTIAL
  coverImageUrl      String?
  contractValue      Float?
  startDate          DateTime?
  completionDate     DateTime?
  teamSize           Int?
  publicVisibility   Boolean       @default(true)
  ownershipConfirmed Boolean       @default(false)
  createdAt          DateTime      @default(now())
}

// Covers CVs, company profiles, certificates, licenses, registration/VAT,
// insurance and other applicant-uploaded evidence (§8.3/§9.5) with the same
// never-overwrite revision chain used elsewhere in this app (DocumentFile).
model ProfileDocument {
  id                 String           @id @default(cuid())
  publicAccountId    String
  publicAccount      PublicAccount    @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  category           String // CV | COMPANY_PROFILE | PORTFOLIO | CERTIFICATION | LICENSE | REGISTRATION | VAT | INSURANCE | HSE_QAQC | NDA | ORG_CHART | OTHER
  name               String
  version            Int              @default(1)
  supersedesId       String?          @unique
  supersedes         ProfileDocument? @relation("ProfileDocumentRevision", fields: [supersedesId], references: [id])
  supersededBy       ProfileDocument? @relation("ProfileDocumentRevision")
  isActive           Boolean          @default(true)
  visibility         String           @default("PRIVATE")
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String           @default("UNVERIFIED") // UNVERIFIED | SUBMITTED | VERIFIED | DISPUTED
  uploadedAt         DateTime         @default(now())
}

model ProfileApplication {
  id                    String        @id @default(cuid())
  publicAccountId       String        @unique
  publicAccount         PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  applicationNumber     String        @unique
  status                String        @default("PENDING_PLATFORM_REVIEW")
  submittedAt           DateTime      @default(now())
  reviewerId            String?
  reviewer              UserIdentity? @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  decisionReason        String?
  decidedAt             DateTime?
  restrictions          String? // JSON array, set when APPROVED_WITH_RESTRICTIONS
  approvedProfileNumber String? // permanent number-series value, set on approval

  reviews ApplicationReview[]
}

model ApplicationReview {
  id              String             @id @default(cuid())
  applicationId   String
  application     ProfileApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        UserIdentity       @relation("ApplicationReviewAuthor", fields: [reviewerId], references: [id])
  action          String // APPROVE | APPROVE_WITH_RESTRICTIONS | REQUEST_CHANGES | REQUEST_DOCUMENTS | REJECT | SUSPEND | REACTIVATE
  reason          String?
  fieldsRequested String? // JSON array of field/section keys, for REQUEST_CHANGES/REQUEST_DOCUMENTS
  createdAt       DateTime           @default(now())
}

// Append-only, mirrors TaskEvent's discipline (§24 — "events cannot be
// deleted; corrections create new events"). Separate from the tenant-scoped
// AuditEvent/TimelineEvent tables since PublicAccount has no tenant.
model ProfileAuditEvent {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  actorType       String // APPLICANT | PLATFORM_ADMIN | SYSTEM
  actorId         String? // PublicAccount.id or UserIdentity.id depending on actorType
  eventType       String
  summary         String
  previousStatus  String?
  newStatus       String?
  createdAt       DateTime      @default(now())
}

// §21's data-model hook for "Company Admin invites an approved public
// profile into a workspace." The invitation UI itself (company-side search +
// send) is out of scope for this pass — this just gives the relationship a
// real, queryable home so it isn't bolted on awkwardly later.
model ProfileInvitation {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedById     String
  invitedBy       UserIdentity  @relation(fields: [invitedById], references: [id])
  proposedRole    String
  status          String        @default("PENDING") // PENDING | ACCEPTED | DECLINED | REVOKED
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// PRD_9 — Personal Calendar, HR Leave Workflow, Reminders, Adaptive Themes.
// Team Availability (shared colleague-leave visibility) and external
// Google/Outlook sync are explicitly deferred — the PRD itself blocks their
// release until population/conflict-resolution rules are defined.
// ---------------------------------------------------------------------------

// A private, per-user agenda item — the one calendar item type with no other
// source-of-truth record to link back to (§3.1 "Personal agenda" row).
// Always scoped to its own userId; never shared, so it needs no separate
// visibility rules the way leave/tasks/meetings do.
model AgendaEvent {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  endAt     DateTime?
  location  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// §3.1 "Project milestone" row — didn't exist as a model before PRD_9.
model ProjectMilestone {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  createdById String
  createdBy   UserIdentity @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

// §5.1 — per-user, per-item-type reminder lead time. Deliberately separate
// from NotificationPreference (that model is about which *channel* fires for
// an event category; this is about *how long before* a calendar item).
model ReminderPreference {
  id            String       @id @default(cuid())
  userId        String
  user          UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType      String // MEETING | TASK | DEADLINE | AGENDA | INSPECTION
  minutesBefore Int          @default(30)

  @@unique([userId, itemType])
}

// =========================================================================
// PRD_Documents_Module — Documents Module and Document Page
// =========================================================================
// Architectural note: the pre-existing DocumentFile model already stores file
// bytes, a checksum, an uploader snapshot and a `supersedes` revision chain,
// and is referenced throughout the (frozen) Projects module. Rather than
// restructure it into the PRD's Document + DocumentRevision pair — which would
// mean editing frozen Project code — this layer is **additive**: `Document` is
// the PRD's permanent record (the Passport), and each DocumentFile row becomes
// one immutable revision of it via the optional `documentId` back-reference.
// Call sites that never adopt Documents keep working unchanged.

// §8 Hybrid folder architecture. Folders are an organisation layer only —
// business relationships live in DocumentLink, so one Document can appear in
// many folders through DocumentFolderRef with no file duplication.
model Folder {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")

  // SYSTEM folders are generated from a platform record (§8.1) and cannot be
  // freely detached; CUSTOM folders are user-created (§8.2).
  folderType       String    @default("CUSTOM") // SYSTEM | CUSTOM
  // Which record a SYSTEM folder was generated from: PROJECT | UNIT | CLIENT |
  // TASK | MEETING | APPROVAL | FINANCE | LEGAL | HR | COMPANY | ASSET | USER.
  sourceEntityType String?
  sourceEntityId   String?
  name             String
  // Stable key for the platform's default roots (§9) and the per-project
  // subfolder template (§9.1) — lets seeding and lookup be idempotent.
  systemKey        String?
  sortOrder        Int       @default(0)
  archivedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())

  documents  Document[]          @relation("DocumentPrimaryFolder")
  folderRefs DocumentFolderRef[]
  savedViews DocumentSavedView[]

  @@unique([tenantId, systemKey])
  @@index([tenantId, parentId])
  @@index([tenantId, folderType])
}

// §12 Document Passport — the permanent metadata/business identity of a
// document, independent of file bytes or current folder. Survives move,
// shortcut, revision, archive and Tranzit promotion (§12 closing rule).
model Document {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title    String
  // §20 — generated or manually entered; unique per tenant when present.
  code     String?
  docType  String  @default("GENERAL")
  category String  @default("General")

  // §14 lifecycle. DRAFT | TRANZIT | INTERNAL_REVIEW | AWAITING_APPROVAL |
  // APPROVED | ISSUED | NEEDS_REVISION | REJECTED | SUPERSEDED | ARCHIVED | VOID
  status String @default("DRAFT")

  primaryFolderId String?
  primaryFolder   Folder? @relation("DocumentPrimaryFolder", fields: [primaryFolderId], references: [id])

  ownerId String?
  owner   UserIdentity? @relation("DocumentOwner", fields: [ownerId], references: [id])

  // §15 — the revision currently presented as "the document". Kept as an
  // explicit pointer so a shortcut download resolves without walking the chain.
  currentRevisionId String?        @unique
  currentRevision   DocumentFile?  @relation("DocumentCurrentRevision", fields: [currentRevisionId], references: [id])
  revisions         DocumentFile[] @relation("DocumentRevisions")

  // §12 Controls group.
  confidentiality   String    @default("NORMAL") // NORMAL | CONFIDENTIAL | RESTRICTED
  requiredReading   Boolean   @default(false)
  expiresAt         DateTime?
  retentionCategory String?
  retentionEndAt    DateTime?
  legalHold         Boolean   @default(false)
  // §28 — applied to previews/derivatives; the original file is never altered.
  watermarkState    String? // DRAFT | TRANZIT | UNDER_REVIEW | APPROVED | ISSUED | CONFIDENTIAL | VOID

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  folderRefs      DocumentFolderRef[]
  links           DocumentLink[]
  comments        DocumentComment[]
  activities      DocumentActivity[]
  favorites       DocumentFavorite[]
  readReceipts    DocumentReadReceipt[]
  collectionItems DocumentCollectionItem[]
  dependsOn       DocumentDependency[]     @relation("DependencySource")
  dependedOnBy    DocumentDependency[]     @relation("DependencyTarget")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, primaryFolderId])
  @@index([tenantId, archivedAt])
}

// §16 — a document reference in a folder. `isPrimary` marks the folder shown
// as the document's home; every other row is a shortcut. Removing a shortcut
// never deletes the document.
model DocumentFolderRef {
  id          String   @id @default(cuid())
  tenantId    String
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  isPrimary   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([documentId, folderId])
  @@index([tenantId, folderId])
}

// §13 Linked records — generic business relation, kept separate from folder
// placement so linking a document to a Unit does not move it in the tree.
model DocumentLink {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // PROJECT | UNIT | CLIENT | TASK | MEETING | APPROVAL | CONTRACT | FINANCE |
  // LEGAL | EMPLOYEE | COMPANY | ASSET
  entityType   String
  entityId     String
  relationType String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
}

// §21 — document-level and revision-specific discussion.
model DocumentComment {
  id         String            @id @default(cuid())
  tenantId   String
  documentId String
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Null for a document-level comment; set when the comment is pinned to one
  // exact revision.
  revisionId String?
  authorId   String
  author     UserIdentity      @relation("DocumentCommentAuthor", fields: [authorId], references: [id])
  body       String
  parentId   String?
  parent     DocumentComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies    DocumentComment[] @relation("CommentThread")
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([tenantId, documentId])
}

// §25 — depends-on / affected-by graph driving impact warnings when an
// upstream approved document receives a new revision.
model DocumentDependency {
  id             String   @id @default(cuid())
  tenantId       String
  documentId     String
  document       Document @relation("DependencySource", fields: [documentId], references: [id], onDelete: Cascade)
  dependsOnId    String
  dependsOn      Document @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)
  dependencyType String   @default("DEPENDS_ON") // DEPENDS_ON | AFFECTED_BY | COORDINATED_WITH
  createdAt      DateTime @default(now())

  @@unique([documentId, dependsOnId])
  @@index([tenantId, dependsOnId])
}

// §26.2 — a named package of document references (Sales Package, Handover
// Package, Permit Submission). Never duplicates files.
model DocumentCollection {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  ownerId   String?
  createdAt DateTime @default(now())

  items DocumentCollectionItem[]

  @@index([tenantId])
}

model DocumentCollectionItem {
  id           String             @id @default(cuid())
  collectionId String
  collection   DocumentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Pins the package to one exact revision where required (tender/handover).
  revisionId   String?
  sortOrder    Int                @default(0)

  @@unique([collectionId, documentId])
}

// §7.4 / DOC-MOD-003 — private per-user Star. Never notifies, never changes
// document state.
model DocumentFavorite {
  id         String       @id @default(cuid())
  tenantId   String
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       UserIdentity @relation("DocumentFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([documentId, userId])
  @@index([tenantId, userId])
}

// §27 — required reading assignment and open/acknowledge receipts.
model DocumentReadReceipt {
  id             String       @id @default(cuid())
  tenantId       String
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId     String?
  userId         String
  user           UserIdentity @relation("DocumentReadReceiptUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt     DateTime?
  openedAt       DateTime?
  acknowledgedAt DateTime?

  @@unique([documentId, userId])
  @@index([tenantId, userId])
}

// §44 — chronological, append-only document timeline.
model DocumentActivity {
  id         String        @id @default(cuid())
  tenantId   String
  documentId String
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId String?
  actorId    String?
  actor      UserIdentity? @relation("DocumentActivityActor", fields: [actorId], references: [id])
  // CREATED | METADATA_CHANGED | FOLDER_MOVED | SHORTCUT_ADDED | SHORTCUT_REMOVED |
  // LINK_ADDED | LINK_REMOVED | REVISION_UPLOADED | STATUS_CHANGED | REVIEW_REQUESTED |
  // APPROVAL_REQUESTED | APPROVAL_RESULT | COMMENT_ADDED | COMMENT_RESOLVED |
  // DOWNLOADED | OPENED | PROMOTED_FROM_TRANZIT | ARCHIVED | RESTORED |
  // EXPIRATION_CHANGED | REQUIRED_READING_ASSIGNED | REQUIRED_READING_ACKNOWLEDGED
  eventType  String
  summary    String
  payload    String? // JSON
  createdAt  DateTime      @default(now())

  @@index([tenantId, documentId, createdAt])
}

// §19.3 — personal saved view (folder context + filters + layout).
model DocumentSavedView {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id])
  layout    String   @default("LIST") // LIST | GRID | TIMELINE | FOLDER
  filters   String? // JSON
  sort      String? // JSON
  columns   String? // JSON
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
}

// =========================================================================
// Platform Configuration — shared infrastructure
// =========================================================================
// Mandated by 7 of the 8 module PRDs (Inventory §60, Teams §32, CRM §41,
// Contracts §44, Finance §39, Assets §19, Documents' config-driven folder
// templates): every module, page, section, widget, feature, workflow, action
// and report must be independently enable/disable-able, and disabled items
// must disappear from navigation, search, APIs and layouts — no dead links,
// no blank spaces.
//
// One row per *explicit* override. Absence means "inherit": from the parent
// node, then from the catalog default (enabled). That keeps the table small
// and makes "enable everything" the zero-row state.
model PlatformConfigSetting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Null = tenant-wide default. Set = company-specific override, which wins
  // over the tenant row (Inventory §60 "company-specific override", Teams
  // §32, and the group-inheritance requirement).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Non-null mirror of companyId used for the uniqueness constraint: SQL does
  // not treat two NULLs as equal, so a unique index over a nullable companyId
  // would silently permit duplicate tenant-wide rows for the same node. The
  // sentinel "TENANT" keeps one-row-per-scope actually enforced.
  scope String @default("TENANT")

  // Dotted catalog key from src/lib/platform-config.ts, e.g.
  // "documents", "documents.feature.tranzit", "inventory.action.post_movement".
  nodeKey String
  enabled Boolean @default(true)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, scope, nodeKey])
  @@index([tenantId, companyId])
}
