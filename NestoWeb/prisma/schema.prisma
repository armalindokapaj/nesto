model Company {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  legalName       String?
  isParent        Boolean   @default(false)
  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies  Company[] @relation("CompanyHierarchy")
  logoUrl         String?
  countryCode     String    @default("AL")
  planName        String    @default("Enterprise")
  seatLimit       Int       @default(50)
  createdAt       DateTime  @default(now())

  branches                  Branch[]
  projects                  Project[]
  units                     Unit[]
  procurementSuppliers      Supplier[]
  purchaseRequests          PurchaseRequest[]
  procurementPackages       ProcurementPackage[]
  supplierCategories        SupplierCategory[]
  reportDefinitions         ReportDefinition[]
  procurementRfqs           ProcurementRfq[]
  supplierQuotations        SupplierQuotation[]
  procurementPurchaseOrders PurchaseOrder[]
  procurementDeliveries     ProcurementDelivery[]
  procurementComparisons    ProcurementComparison[]
  workPackages              WorkPackage[]
  scheduleVersions          WorkScheduleVersion[]
  dailySiteReports          DailySiteReport[]
  workConstraints           WorkConstraint[]
  workDelayEvents           WorkDelayEvent[]
  measurementSheets         WorkMeasurementSheet[]

  // --- PRD_Finance_Dashboard (additive) -----------------------------------
  spendingBills SpendingBill[]
  budgets       Budget[]
  loans         Loan[]
  investments   Investment[]

  // --- PRD_HR_Payroll_Workforce (additive) ---------------------------------
  employmentRelationships EmploymentRelationship[]
  payrollGroups           PayrollGroup[]

  // --- Platform Configuration ----------------------------------------------
  platformConfigSettings PlatformConfigSetting[]
}

model Branch {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  address            String?
  isRegisteredBranch Boolean  @default(false)
  createdAt          DateTime @default(now())
}

// Global login identity — one record per person, may hold memberships in
// multiple tenants (Section 3: "one login, many contexts").
model UserIdentity {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  avatarColor  String   @default("#B8860B")
  createdAt    DateTime @default(now())
  // PRD_9 §6 — belongs to the identity, not a tenant membership, so the
  // preference (and role-derived Creative flavor) follows the user across
  // devices and workspaces. PLATFORM_DEFAULT | NIGHT | CREATIVE
  theme        String   @default("PLATFORM_DEFAULT")

  memberships                  CompanyMembership[]
  projectMembers               ProjectMember[]
  createdTasks                 Task[]                   @relation("TaskCreator")
  responsibleTasks             Task[]                   @relation("TaskResponsible")
  taskContributions            TaskContribution[]
  comments                     Comment[]
  notifications                Notification[]
  employeeRecord               Employee?
  teamMemberships              TeamMember[]
  uploadedDocuments            DocumentFile[]
  documentApprovals            DocumentFile[]           @relation("DocumentApprover")
  organisedMeetings            Meeting[]
  postedLedgerEntries          FinancialLedgerEntry[]
  notificationPreferences      NotificationPreference[]
  suggestions                  Suggestion[]
  hrAppointments               HrAppointment[]
  createdClients               Client[]
  hseReports                   HseReport[]
  purchaseOrdersRequested      PurchaseOrder[]
  purchaseRequestsCreated      PurchaseRequest[]
  procurementPackagesCreated   ProcurementPackage[]
  procurementRfqsCreated       ProcurementRfq[]
  supplierQuotationsCreated    SupplierQuotation[]
  procurementDeliveriesCreated ProcurementDelivery[]
  procurementActivitiesActed   ProcurementActivity[]

  // --- PRD_4 Cross-Department Task Orchestration -----------------------
  taskManagerFor             Task[]                         @relation("TaskManager")
  decisionOwnerFor           Task[]                         @relation("TaskDecisionOwner")
  finalApproverFor           Task[]                         @relation("TaskFinalApprover")
  departmentOwnerFor         TaskDepartment[]               @relation("TaskDepartmentOwner")
  taskParticipations         TaskParticipant[]              @relation("TaskParticipantUser")
  taskEventsActed            TaskEvent[]                    @relation("TaskEventActor")
  taskApprovalsGiven         TaskApproval[]                 @relation("TaskApprover")
  taskApprovalsDelegatedToMe TaskApproval[]                 @relation("TaskApprovalDelegate")
  involvementRequestsMade    DepartmentInvolvementRequest[] @relation("InvolvementRequester")
  involvementRequestsHandled DepartmentInvolvementRequest[] @relation("InvolvementResponder")
  escalationsRaised          TaskEscalation[]               @relation("EscalationFrom")
  escalationsReceived        TaskEscalation[]               @relation("EscalationTo")
  delayExplanationsGiven     TaskDelayExplanation[]         @relation("DelayExplanationAuthor")
  contractLinksCreated       TaskContractLink[]             @relation("ContractLinkCreator")
  contractorAssignmentsMade  TaskContractorAssignment[]     @relation("ContractorAssignmentAssignedBy")
  taskInspectionsPerformed   TaskInspection[]               @relation("TaskInspector")
  taskCompletionsRecorded    TaskCompletionRecord[]         @relation("TaskCompletedBy")
  taskReopeningsRecorded     TaskReopeningRecord[]          @relation("TaskReopenedBy")
  stagesSkipped              TaskStage[]                    @relation("StageSkippedBy")
  contractorProfile          Contractor?                    @relation("ContractorLogin")

  // --- PRD_Tasks_Module (additive: Star + Checklist) --------------------
  taskStars              TaskStar[]          @relation("TaskStarUser")
  taskChecklistOwned     TaskChecklistItem[] @relation("TaskChecklistOwner")
  taskChecklistCompleted TaskChecklistItem[] @relation("TaskChecklistCompletedBy")
  taskChecklistCreated   TaskChecklistItem[] @relation("TaskChecklistCreatedBy")

  // --- PRD_Teams_Module (additive: type, lead, member role) --------------
  teamsLed Team[] @relation("TeamLead")

  // --- PRD_CRM_Module (additive) -----------------------------------------
  clientsOwned                   Client[]                 @relation("ClientOwner")
  contactsOwned                  Contact[]                @relation("ContactOwner")
  clientNotesAuthored            ClientNote[]             @relation("ClientNoteAuthor")
  opportunitiesOwned             Opportunity[]            @relation("OpportunityOwner")
  leadsOwned                     Lead[]                   @relation("LeadOwner")
  clientStars                    ClientStar[]             @relation("ClientStarUser")
  unitRelationshipsAsSalesperson ClientUnitRelationship[] @relation("ClientUnitRelationshipSalesperson")
  unitRelationshipsCreated       ClientUnitRelationship[] @relation("ClientUnitRelationshipCreatedBy")
  crmCommunicationsLogged        CrmCommunication[]       @relation("CrmCommunicationLoggedBy")
  supportCasesAssigned           SupportCase[]            @relation("SupportCaseAssignedTo")
  supportCasesCreated            SupportCase[]            @relation("SupportCaseCreatedBy")
  crmActivityEventsActed         CrmActivityEvent[]       @relation("CrmActivityEventActor")

  // --- PRD_Finance_Dashboard (additive) -----------------------------------
  spendingBillsSubmitted        SpendingBill[]   @relation("SpendingBillSubmitter")
  spendingBillsSuperiorApproved SpendingBill[]   @relation("SpendingBillSuperiorApprover")
  spendingBillsFinanceApproved  SpendingBill[]   @relation("SpendingBillFinanceApprover")
  budgetsCreated                Budget[]         @relation("BudgetCreatedBy")
  budgetRevisionsMade           BudgetRevision[] @relation("BudgetRevisionRevisedBy")
  loansCreated                  Loan[]           @relation("LoanCreatedBy")
  investmentsCreated            Investment[]     @relation("InvestmentCreatedBy")

  // --- PRD_Architect_Dashboard / PRD_Engineer_Dashboard (additive) --------
  drawingsAuthored           Drawing[]            @relation("DrawingAuthor")
  drawingRevisionsAuthored   DrawingRevision[]    @relation("DrawingRevisionAuthor")
  rfisResponded              RFI[]                @relation("RfiRespondedBy")
  submittalsSubmitted        Submittal[]          @relation("SubmittalSubmitter")
  submittalsReviewed         Submittal[]          @relation("SubmittalReviewer")
  engineeringPackagesOwned   EngineeringPackage[] @relation("EngineeringPackageOwner")
  specificationsAuthored     Specification[]      @relation("SpecificationAuthor")
  calculationsAuthored       Calculation[]        @relation("CalculationAuthor")
  calculationsChecked        Calculation[]        @relation("CalculationChecker")
  inspectionsRequested       InspectionRequest[]  @relation("InspectionRequester")
  inspectionsAssigned        InspectionRequest[]  @relation("InspectionInspector")
  inspectionResultsIssued    InspectionRequest[]  @relation("InspectionResultBy")
  coordinationIssuesCreated  CoordinationIssue[]  @relation("CoordinationIssueCreatedBy")
  coordinationIssuesAssigned CoordinationIssue[]  @relation("CoordinationIssueAssignedTo")
  clientRequestsAssigned     ClientRequest[]      @relation("ClientRequestAssignedArchitect")
  clientRequestsCreated      ClientRequest[]      @relation("ClientRequestCreatedBy")

  // --- PRD_Contracts_Module (additive) -----------------------------------
  contractsResponsibleFor  Contract[]           @relation("ContractResponsible")
  contractObligationsOwned ContractObligation[] @relation("ContractObligationOwner")
  contractActivityActed    ContractActivity[]   @relation("ContractActivityActor")
  contractStars            ContractStar[]       @relation("ContractStarUser")

  // --- PRD_Finance_Module (additive: Accounting Core) --------------------
  journalEntriesCreated JournalEntry[]    @relation("JournalEntryCreatedBy")
  journalEntriesPosted  JournalEntry[]    @relation("JournalEntryPostedBy")
  financeActivityActed  FinanceActivity[] @relation("FinanceActivityActor")

  // --- PRD_Inventory_Module (additive) ------------------------------------
  warehousesManaged         Warehouse[]         @relation("WarehouseManager")
  inventoryMovementsPosted  InventoryMovement[] @relation("InventoryMovementPostedBy")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")

  // --- PRD_Inventory_Dashboard (additive) ---------------------------------
  inventoryMovementsRecipient   InventoryMovement[]  @relation("InventoryMovementRecipient")
  inventoryMovementsConfirmedBy InventoryMovement[]  @relation("InventoryMovementConfirmedBy")
  stockReservationsRequested    StockReservation[]   @relation("StockReservationRequestedBy")
  inventoryCountsCreated        InventoryCount[]     @relation("InventoryCountCreatedBy")
  inventoryCountsApproved       InventoryCount[]     @relation("InventoryCountApprovedBy")
  inventoryCountLinesCounted    InventoryCountLine[] @relation("InventoryCountLineCountedBy")
  dailyClosesConfirmed          DailyClose[]         @relation("DailyCloseConfirmedBy")
  inventoryActivityActed        InventoryActivity[]  @relation("InventoryActivityActor")

  // --- PRD_6 Public Sign-Up / Platform Approval -------------------------
  // A single flag on the existing company-scoped identity, not a separate
  // tenant-independent Platform Admin account model (that's PRD_7's fuller
  // scope) — enough to gate a minimal /platform/applications review queue.
  isPlatformAdmin            Boolean              @default(false)
  reviewedApplications       ProfileApplication[] @relation("ApplicationReviewer")
  applicationReviewsAuthored ApplicationReview[]  @relation("ApplicationReviewAuthor")
  profileInvitationsSent     ProfileInvitation[]

  // --- PRD_9 Personal Calendar / Leave / Reminders -----------------------
  agendaEvents         AgendaEvent[]
  reminderPreferences  ReminderPreference[]
  createdMilestones    ProjectMilestone[]
  leaveRequestsCreated LeaveRequest[]       @relation("LeaveCreatedBy")
  leaveRequestsDecided LeaveRequest[]       @relation("LeaveDecidedBy")

  // --- Salary History ----------------------------------------------------
  salaryRecordsCreated SalaryRecord[] @relation("SalaryRecordCreatedBy")
  salaryRecordsUpdated SalaryRecord[] @relation("SalaryRecordUpdatedBy")

  // --- Training Module -----------------------------------------------------
  trainingsAssigned EmployeeTraining[] @relation("TrainingAssignedBy")

  // --- PRD_18 Document Passport / Blue Ticket -------------------------------
  documentApprovalsGiven DocumentApproval[]

  // --- PRD_Rework_1 Projects Module & Project Page Redesign ----------------
  projectPins                ProjectPin[]
  uploadedProjectRenders     ProjectRender[]
  uploadedProjectPhotos      ProjectPhoto[]
  projectWorkPackagesCreated ProjectWorkPackage[]
  projectApprovalsRequested  ProjectApproval[]    @relation("ApprovalRequester")
  projectApprovalsToApprove  ProjectApproval[]    @relation("ApprovalApprover")

  // --- PRD_Units / PRD_Unit_Page Real Estate Inventory ----------------------
  uploadedUnitRenders     UnitRender[]
  unitActivityEventsActed UnitActivityEvent[]

  // --- PRD_Documents_Module ------------------------------------------------
  documentsOwned       Document[]            @relation("DocumentOwner")
  documentComments     DocumentComment[]     @relation("DocumentCommentAuthor")
  documentFavorites    DocumentFavorite[]    @relation("DocumentFavoriteUser")
  documentReadReceipts DocumentReadReceipt[] @relation("DocumentReadReceiptUser")
  documentActivities   DocumentActivity[]    @relation("DocumentActivityActor")

  // --- PRD_HR_Payroll_Workforce (additive) ---------------------------------
  employmentRelationshipsCreated EmploymentRelationship[] @relation("EmploymentRelationshipCreatedBy")
  hrActivityActed                HrActivity[]             @relation("HrActivityActor")

  // --- PRD_Government_Legal_Compliance (additive) --------------------------
  permitsCreated            Permit[]               @relation("PermitCreatedBy")
  permitAmendmentsCreated   PermitAmendment[]      @relation("PermitAmendmentCreatedBy")
  legalReadinessStatusesSet LegalReadinessStatus[] @relation("LegalReadinessSetBy")
  legalActivityActed        LegalActivity[]        @relation("LegalActivityActor")

  // --- PRD_HSE_Module (additive) --------------------------------------------
  hazardsIdentified       Hazard[]         @relation("HazardIdentifiedBy")
  riskAssessmentsApproved RiskAssessment[] @relation("RiskAssessmentApprovedBy")
  riskAssessmentsCreated  RiskAssessment[] @relation("RiskAssessmentCreatedBy")
  permitsToWorkRequested  PermitToWork[]   @relation("PermitToWorkRequestedBy")
  permitsToWorkIssued     PermitToWork[]   @relation("PermitToWorkIssuedBy")
  stopWorkOrdersIssued    StopWorkOrder[]  @relation("StopWorkIssuedBy")
  stopWorkOrdersReleased  StopWorkOrder[]  @relation("StopWorkReleasedBy")
  hseActivityActed        HseActivity[]    @relation("HseActivityActor")

  // --- PRD_HSE_Module Phase 1 rework (additive) -----------------------------
  hseInspectionsPerformed      HseInspection[]       @relation("HseInspectionInspector")
  hseObservationsReported      HseObservation[]      @relation("HseObservationReportedBy")
  hseIncidentsReported         HseIncident[]         @relation("HseIncidentReportedBy")
  hseIncidentsInvestigated     HseIncident[]         @relation("HseIncidentInvestigator")
  hseCorrectiveActionsOwned    HseCorrectiveAction[] @relation("HseCorrectiveActionOwner")
  hseCorrectiveActionsVerified HseCorrectiveAction[] @relation("HseCorrectiveActionVerifiedBy")
  hseInductionsConducted       HseInduction[]        @relation("HseInductionConductedBy")
  hseToolboxTalksConducted     HseToolboxTalk[]      @relation("HseToolboxTalkConductedBy")

  // --- PRD_Reporting_Analytics Phase 1 (additive) ---------------------------
  reportExecutions       ReportExecution[]   @relation("ReportExecutedBy")
  analyticsActivityActed AnalyticsActivity[] @relation("AnalyticsActivityActor")

  // --- PRD_BIM_3D_Digital_Twin adapted Phase 1 (additive) --------------------
  bimModelVersionsUploaded BimModelVersion[] @relation("BimModelVersionUploadedBy")
  bimObjectLinksCreated    BimObjectLink[]   @relation("BimObjectLinkCreatedBy")

  // --- PRD_HR_Payroll_Workforce Phase 2 (additive: Payroll) ----------------
  payrollRunsCreated   PayrollRun[]      @relation("PayrollRunCreatedBy")
  payrollRunsLocked    PayrollRun[]      @relation("PayrollRunLockedBy")
  payrollActivityActed PayrollActivity[] @relation("PayrollActivityActor")

  // --- PRD_HR_Dashboard Timesheets (additive) -------------------------------
  timesheetsVerified Timesheet[] @relation("TimesheetVerifiedBy")

  // --- PRD_Procurement_Dashboard (additive) ---------------------------------
  comparisonsCreated        ProcurementComparison[]      @relation("ComparisonCreatedBy")
  comparisonScoresEvaluated ProcurementComparisonScore[] @relation("ComparisonScoreEvaluatedBy")
  awardsPrepared            AwardRecommendation[]        @relation("AwardPreparedBy")
  awardsDecided             AwardRecommendation[]        @relation("AwardDecidedBy")

  // --- PRD_QAQC_Dashboard (additive) ------------------------------------
  ncrsRaised        Ncr[]          @relation("NcrRaisedBy")
  ncrsVerified      Ncr[]          @relation("NcrVerifiedBy")
  defectsRaised     Defect[]       @relation("DefectRaisedBy")
  defectsAssigned   Defect[]       @relation("DefectAssignedTo")
  defectsVerified   Defect[]       @relation("DefectVerifiedBy")
  qaqcActivityActed QaqcActivity[] @relation("QaqcActivityActor")

  // --- PRD_Approvals_Workflow_Engine Phase 1 (additive) --------------------
  workflowInstancesSubmitted WorkflowInstance[] @relation("WorkflowInstanceSubmittedBy")
  workflowDecisionsMade      WorkflowDecision[] @relation("WorkflowDecisionDecidedBy")

  // --- PRD_Complete_Role_Permission_Matrix — capability grants (additive) --
  capabilityGrantsReceived UserCapabilityGrant[] @relation("UserCapabilityGrantUser")
  capabilityGrantsIssued   UserCapabilityGrant[] @relation("UserCapabilityGrantGrantedBy")

  // --- PRD_Mobile_Offline_Platform Phase 1 (additive: device registry) -----
  registeredDevices RegisteredDevice[] @relation("RegisteredDeviceUser")

  // --- PRD_Client_Supplier_Portals Phase 1 (additive) -----------------------
  portalMemberships PortalMembership[] @relation("PortalMembershipUser")
}

// Links an identity to a tenant workspace with a role, department and access mode.
model CompanyMembership {
