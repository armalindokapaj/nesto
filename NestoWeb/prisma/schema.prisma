// ---------------------------------------------------------------------------
// PRD_2 — Dimensions: reusable analytical tags attached to records (§7).
// Visibility/permissions are unaffected — dimensions are for reporting only.
// ---------------------------------------------------------------------------

model DimensionDefinition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code     String // PROJECT | BRANCH | DEPARTMENT | COST_CENTER | PHASE | TRADE | ...
  label    String

  values DimensionValue[]

  @@unique([tenantId, code])
}

model DimensionValue {
  id           String              @id @default(cuid())
  definitionId String
  definition   DimensionDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  label        String

  recordDimensions RecordDimension[]
}

model RecordDimension {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType       String // "Invoice" | "Task" | ...
  entityId         String
  dimensionValueId String
  dimensionValue   DimensionValue @relation(fields: [dimensionValueId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, dimensionValueId])
}

// ---------------------------------------------------------------------------
// PRD_2 — Posting lifecycle & immutable Financial Ledger (§8, §10), built as
// a concrete vertical slice on Invoices. Stock/Contract/Progress/Time ledgers
// follow the identical pattern in a later phase — PRD_2's own rollout plan
// (§17.2) expects "posting_and_ledgers" to land module by module, not all at
// once, so this isn't a shortcut, it's the specified rollout shape.
// ---------------------------------------------------------------------------

model FinancialLedgerEntry {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice                @relation(fields: [invoiceId], references: [id])
  amount          Float
  currency        String                 @default("EUR")
  postedAt        DateTime               @default(now())
  postedById      String
  postedBy        UserIdentity           @relation(fields: [postedById], references: [id])
  reversesEntryId String?
  reversesEntry   FinancialLedgerEntry?  @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy      FinancialLedgerEntry[] @relation("Reversal")
}

// ---------------------------------------------------------------------------
// PRD_6 — Professional and Contractor Public Sign-Up. Deliberately outside
// the Tenant graph: a PublicAccount is not a company member and must never
// be reachable through tenant-scoped queries (public profile data and
// private company data stay separated per §2's non-interference rule).
// Approval never grants private workspace access — that's a distinct,
// separate ProfileInvitation a Company Admin sends afterward (§21).
// ---------------------------------------------------------------------------

model PublicAccount {
  id                String    @id @default(cuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  preferredLanguage String    @default("sq")
  country           String
  timeZone          String
  accountType       String // PROFESSIONAL | CONTRACTOR
  status            String    @default("DRAFT")
  // DRAFT | EMAIL_VERIFICATION_REQUIRED | PROFILE_INCOMPLETE | READY_TO_SUBMIT |
  // PENDING_PLATFORM_REVIEW | CHANGES_REQUESTED | RESUBMITTED | APPROVED |
  // APPROVED_WITH_RESTRICTIONS | REJECTED | SUSPENDED | DEACTIVATED
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  professionalProfile     ProfessionalProfile?
  contractorProfile       ContractorProfile?
  documents               ProfileDocument[]
  portfolioProjects       PortfolioProject[]
  application             ProfileApplication?
  auditEvents             ProfileAuditEvent[]
  emailVerificationTokens EmailVerificationToken[]
  invitations             ProfileInvitation[]
}

model EmailVerificationToken {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  token           String        @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime      @default(now())
}

model ProfessionalProfile {
  id                     String        @id @default(cuid())
  publicAccountId        String        @unique
  publicAccount          PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  firstName              String?
  lastName               String?
  title                  String?
  primaryProfession      String?
  photoUrl               String?
  country                String?
  city                   String?
  headline               String?
  summary                String?
  yearsExperience        Int?
  employmentStatus       String? // EMPLOYED | SELF_EMPLOYED | FREELANCE | SEEKING_WORK | OTHER
  availabilityStatus     String? // AVAILABLE_NOW | AVAILABLE_FROM | NOT_AVAILABLE | OPEN_TO_OFFERS
  professionalEmail      String?
  phone                  String?
  website                String?
  linkedin               String?
  portfolioWebsite       String?
  addressVisibility      String        @default("PRIVATE") // PRIVATE | APPROVED_COMPANIES | SELECTED_COMPANIES | PUBLIC
  preferredContactMethod String?
  engagementTypes        String? // JSON array
  relocationAvailable    Boolean?
  expectedSalary         String?
  preferredProjectTypes  String? // JSON array
  preferredCompanyTypes  String? // JSON array
  workAuthorization      String?
  noticePeriod           String?
  availabilityDate       DateTime?

  experiences    ProfessionalExperience[]
  educations     ProfessionalEducation[]
  certifications ProfessionalCertification[]
  skills         ProfessionalSkill[]
}

model ProfessionalExperience {
  id               String              @id @default(cuid())
  profileId        String
  profile          ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  employer         String
  position         String
  employmentType   String?
  country          String?
  city             String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean             @default(false)
  description      String
  createdAt        DateTime            @default(now())
}

model ProfessionalEducation {
  id             String              @id @default(cuid())
  profileId      String
  profile        ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution    String
  degree         String
  fieldOfStudy   String
  country        String?
  startDate      DateTime
  graduationDate DateTime?
  ongoing        Boolean             @default(false)
  createdAt      DateTime            @default(now())
}

model ProfessionalCertification {
  id                  String              @id @default(cuid())
  profileId           String
  profile             ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String
  certificateNumber   String?
  issueDate           DateTime?
  expiryDate          DateTime?
  country             String?
  verificationUrl     String?
  createdAt           DateTime            @default(now())
}

// Professional, software and language skills share one flexible list rather
// than three rigid taxonomy tables — §8.6 keeps software/language skills
// optional and open-ended, so one categorized list captures the requirement
// without a hard-coded managed taxonomy this platform doesn't have yet.
model ProfessionalSkill {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String              @default("PROFESSIONAL") // PROFESSIONAL | SOFTWARE | LANGUAGE
  level     String?
}

model ContractorProfile {
  id                        String        @id @default(cuid())
  publicAccountId           String        @unique
  publicAccount             PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  contractorType            String? // REGISTERED_COMPANY | SOLE_TRADER | INDEPENDENT_CONTRACTOR | SPECIALIST_SUBCONTRACTOR | SUPPLIER_INSTALLER
  legalBusinessName         String?
  tradingName               String?
  registrationNumber        String?
  vatNumber                 String?
  countryOfRegistration     String?
  legalStructure            String?
  foundingYear              Int?
  headquarters              String?
  mainContactPerson         String?
  businessEmail             String?
  businessPhone             String?
  website                   String?
  companySize               String?
  shortDescription          String?
  fullDescription           String?
  primaryService            String?
  additionalServices        String? // JSON array
  countriesServed           String? // JSON array
  maxProjectDistance        String?
  internationalAvailability Boolean?
  typicalProjectSize        String?
  minContractValue          Float?
  maxContractValue          Float?
  activeTeams               String?
  equipmentCapacity         String?

  contacts ContractorContact[]
}

model ContractorContact {
  id        String            @id @default(cuid())
  profileId String
  profile   ContractorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  role      String // OWNER | COMMERCIAL | TENDER | PROJECT_MANAGER | SITE_MANAGER | HSE | FINANCE | LEGAL
  email     String?
  phone     String?
  createdAt DateTime          @default(now())
}

// Shared portfolio entry for both account types (§8.8/§9.6) — a Professional
// shows personal contribution, a Contractor shows company-executed scope;
// same shape, same review/visibility rules either way.
model PortfolioProject {
  id                 String        @id @default(cuid())
  publicAccountId    String
  publicAccount      PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  title              String
  projectType        String
  location           String?
  completionYear     Int?
  clientOrEmployer   String?
  role               String
  description        String
  status             String        @default("COMPLETED") // CONCEPT | ONGOING | COMPLETED | CONFIDENTIAL
  coverImageUrl      String?
  contractValue      Float?
  startDate          DateTime?
  completionDate     DateTime?
  teamSize           Int?
  publicVisibility   Boolean       @default(true)
  ownershipConfirmed Boolean       @default(false)
  createdAt          DateTime      @default(now())
}

// Covers CVs, company profiles, certificates, licenses, registration/VAT,
// insurance and other applicant-uploaded evidence (§8.3/§9.5) with the same
// never-overwrite revision chain used elsewhere in this app (DocumentFile).
model ProfileDocument {
  id                 String           @id @default(cuid())
  publicAccountId    String
  publicAccount      PublicAccount    @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  category           String // CV | COMPANY_PROFILE | PORTFOLIO | CERTIFICATION | LICENSE | REGISTRATION | VAT | INSURANCE | HSE_QAQC | NDA | ORG_CHART | OTHER
  name               String
  version            Int              @default(1)
  supersedesId       String?          @unique
  supersedes         ProfileDocument? @relation("ProfileDocumentRevision", fields: [supersedesId], references: [id])
  supersededBy       ProfileDocument? @relation("ProfileDocumentRevision")
  isActive           Boolean          @default(true)
  visibility         String           @default("PRIVATE")
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String           @default("UNVERIFIED") // UNVERIFIED | SUBMITTED | VERIFIED | DISPUTED
  uploadedAt         DateTime         @default(now())
}

model ProfileApplication {
  id                    String        @id @default(cuid())
  publicAccountId       String        @unique
  publicAccount         PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  applicationNumber     String        @unique
  status                String        @default("PENDING_PLATFORM_REVIEW")
  submittedAt           DateTime      @default(now())
  reviewerId            String?
  reviewer              UserIdentity? @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  decisionReason        String?
  decidedAt             DateTime?
  restrictions          String? // JSON array, set when APPROVED_WITH_RESTRICTIONS
  approvedProfileNumber String? // permanent number-series value, set on approval

  reviews ApplicationReview[]
}

model ApplicationReview {
  id              String             @id @default(cuid())
  applicationId   String
  application     ProfileApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        UserIdentity       @relation("ApplicationReviewAuthor", fields: [reviewerId], references: [id])
  action          String // APPROVE | APPROVE_WITH_RESTRICTIONS | REQUEST_CHANGES | REQUEST_DOCUMENTS | REJECT | SUSPEND | REACTIVATE
  reason          String?
  fieldsRequested String? // JSON array of field/section keys, for REQUEST_CHANGES/REQUEST_DOCUMENTS
  createdAt       DateTime           @default(now())
}

// Append-only, mirrors TaskEvent's discipline (§24 — "events cannot be
// deleted; corrections create new events"). Separate from the tenant-scoped
// AuditEvent/TimelineEvent tables since PublicAccount has no tenant.
model ProfileAuditEvent {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  actorType       String // APPLICANT | PLATFORM_ADMIN | SYSTEM
  actorId         String? // PublicAccount.id or UserIdentity.id depending on actorType
  eventType       String
  summary         String
  previousStatus  String?
  newStatus       String?
  createdAt       DateTime      @default(now())
}

// §21's data-model hook for "Company Admin invites an approved public
// profile into a workspace." The invitation UI itself (company-side search +
// send) is out of scope for this pass — this just gives the relationship a
// real, queryable home so it isn't bolted on awkwardly later.
model ProfileInvitation {
  id              String        @id @default(cuid())
  publicAccountId String
  publicAccount   PublicAccount @relation(fields: [publicAccountId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedById     String
  invitedBy       UserIdentity  @relation(fields: [invitedById], references: [id])
  proposedRole    String
  status          String        @default("PENDING") // PENDING | ACCEPTED | DECLINED | REVOKED
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// PRD_9 — Personal Calendar, HR Leave Workflow, Reminders, Adaptive Themes.
// Team Availability (shared colleague-leave visibility) and external
// Google/Outlook sync are explicitly deferred — the PRD itself blocks their
// release until population/conflict-resolution rules are defined.
// ---------------------------------------------------------------------------

// A private, per-user agenda item — the one calendar item type with no other
// source-of-truth record to link back to (§3.1 "Personal agenda" row).
// Always scoped to its own userId; never shared, so it needs no separate
// visibility rules the way leave/tasks/meetings do.
model AgendaEvent {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  startAt   DateTime
  endAt     DateTime?
  location  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// §3.1 "Project milestone" row — didn't exist as a model before PRD_9.
model ProjectMilestone {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  createdById String
  createdBy   UserIdentity @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

// §5.1 — per-user, per-item-type reminder lead time. Deliberately separate
// from NotificationPreference (that model is about which *channel* fires for
// an event category; this is about *how long before* a calendar item).
model ReminderPreference {
  id            String       @id @default(cuid())
  userId        String
  user          UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType      String // MEETING | TASK | DEADLINE | AGENDA | INSPECTION
  minutesBefore Int          @default(30)

  @@unique([userId, itemType])
}

// =========================================================================
// PRD_Documents_Module — Documents Module and Document Page
// =========================================================================
// Architectural note: the pre-existing DocumentFile model already stores file
// bytes, a checksum, an uploader snapshot and a `supersedes` revision chain,
// and is referenced throughout the (frozen) Projects module. Rather than
// restructure it into the PRD's Document + DocumentRevision pair — which would
// mean editing frozen Project code — this layer is **additive**: `Document` is
// the PRD's permanent record (the Passport), and each DocumentFile row becomes
// one immutable revision of it via the optional `documentId` back-reference.
// Call sites that never adopt Documents keep working unchanged.

// §8 Hybrid folder architecture. Folders are an organisation layer only —
// business relationships live in DocumentLink, so one Document can appear in
// many folders through DocumentFolderRef with no file duplication.
model Folder {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")

  // SYSTEM folders are generated from a platform record (§8.1) and cannot be
  // freely detached; CUSTOM folders are user-created (§8.2).
  folderType       String    @default("CUSTOM") // SYSTEM | CUSTOM
  // Which record a SYSTEM folder was generated from: PROJECT | UNIT | CLIENT |
  // TASK | MEETING | APPROVAL | FINANCE | LEGAL | HR | COMPANY | ASSET | USER.
  sourceEntityType String?
  sourceEntityId   String?
  name             String
  // Stable key for the platform's default roots (§9) and the per-project
  // subfolder template (§9.1) — lets seeding and lookup be idempotent.
  systemKey        String?
  sortOrder        Int       @default(0)
  archivedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())

  documents  Document[]          @relation("DocumentPrimaryFolder")
  folderRefs DocumentFolderRef[]
  savedViews DocumentSavedView[]

  @@unique([tenantId, systemKey])
  @@index([tenantId, parentId])
  @@index([tenantId, folderType])
}

// §12 Document Passport — the permanent metadata/business identity of a
// document, independent of file bytes or current folder. Survives move,
// shortcut, revision, archive and Tranzit promotion (§12 closing rule).
model Document {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title    String
  // §20 — generated or manually entered; unique per tenant when present.
  code     String?
  docType  String  @default("GENERAL")
  category String  @default("General")

  // §14 lifecycle. DRAFT | TRANZIT | INTERNAL_REVIEW | AWAITING_APPROVAL |
  // APPROVED | ISSUED | NEEDS_REVISION | REJECTED | SUPERSEDED | ARCHIVED | VOID
  status String @default("DRAFT")

  primaryFolderId String?
  primaryFolder   Folder? @relation("DocumentPrimaryFolder", fields: [primaryFolderId], references: [id])

  ownerId String?
  owner   UserIdentity? @relation("DocumentOwner", fields: [ownerId], references: [id])

  // §15 — the revision currently presented as "the document". Kept as an
  // explicit pointer so a shortcut download resolves without walking the chain.
  currentRevisionId String?        @unique
  currentRevision   DocumentFile?  @relation("DocumentCurrentRevision", fields: [currentRevisionId], references: [id])
  revisions         DocumentFile[] @relation("DocumentRevisions")

  // §12 Controls group.
  confidentiality   String    @default("NORMAL") // NORMAL | CONFIDENTIAL | RESTRICTED
  requiredReading   Boolean   @default(false)
  expiresAt         DateTime?
  retentionCategory String?
  retentionEndAt    DateTime?
  legalHold         Boolean   @default(false)
  // §28 — applied to previews/derivatives; the original file is never altered.
  watermarkState    String? // DRAFT | TRANZIT | UNDER_REVIEW | APPROVED | ISSUED | CONFIDENTIAL | VOID

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  folderRefs      DocumentFolderRef[]
  links           DocumentLink[]
  comments        DocumentComment[]
  activities      DocumentActivity[]
  favorites       DocumentFavorite[]
  readReceipts    DocumentReadReceipt[]
  collectionItems DocumentCollectionItem[]
  dependsOn       DocumentDependency[]     @relation("DependencySource")
  dependedOnBy    DocumentDependency[]     @relation("DependencyTarget")

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, primaryFolderId])
  @@index([tenantId, archivedAt])
}

// §16 — a document reference in a folder. `isPrimary` marks the folder shown
// as the document's home; every other row is a shortcut. Removing a shortcut
// never deletes the document.
model DocumentFolderRef {
  id          String   @id @default(cuid())
  tenantId    String
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  isPrimary   Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([documentId, folderId])
  @@index([tenantId, folderId])
}

// §13 Linked records — generic business relation, kept separate from folder
// placement so linking a document to a Unit does not move it in the tree.
model DocumentLink {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // PROJECT | UNIT | CLIENT | TASK | MEETING | APPROVAL | CONTRACT | FINANCE |
  // LEGAL | EMPLOYEE | COMPANY | ASSET
  entityType   String
  entityId     String
  relationType String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([tenantId, entityType, entityId])
}

// §21 — document-level and revision-specific discussion.
model DocumentComment {
  id         String            @id @default(cuid())
  tenantId   String
  documentId String
  document   Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Null for a document-level comment; set when the comment is pinned to one
  // exact revision.
  revisionId String?
  authorId   String
  author     UserIdentity      @relation("DocumentCommentAuthor", fields: [authorId], references: [id])
  body       String
  parentId   String?
  parent     DocumentComment?  @relation("CommentThread", fields: [parentId], references: [id])
  replies    DocumentComment[] @relation("CommentThread")
  resolvedAt DateTime?
  createdAt  DateTime          @default(now())

  @@index([tenantId, documentId])
}

// §25 — depends-on / affected-by graph driving impact warnings when an
// upstream approved document receives a new revision.
model DocumentDependency {
  id             String   @id @default(cuid())
  tenantId       String
  documentId     String
  document       Document @relation("DependencySource", fields: [documentId], references: [id], onDelete: Cascade)
  dependsOnId    String
  dependsOn      Document @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)
  dependencyType String   @default("DEPENDS_ON") // DEPENDS_ON | AFFECTED_BY | COORDINATED_WITH
  createdAt      DateTime @default(now())

  @@unique([documentId, dependsOnId])
  @@index([tenantId, dependsOnId])
}

// §26.2 — a named package of document references (Sales Package, Handover
// Package, Permit Submission). Never duplicates files.
model DocumentCollection {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  ownerId   String?
  createdAt DateTime @default(now())

  items DocumentCollectionItem[]

  @@index([tenantId])
}

model DocumentCollectionItem {
  id           String             @id @default(cuid())
  collectionId String
  collection   DocumentCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Pins the package to one exact revision where required (tender/handover).
  revisionId   String?
  sortOrder    Int                @default(0)

  @@unique([collectionId, documentId])
}

// §7.4 / DOC-MOD-003 — private per-user Star. Never notifies, never changes
// document state.
model DocumentFavorite {
  id         String       @id @default(cuid())
  tenantId   String
  documentId String
  document   Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       UserIdentity @relation("DocumentFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([documentId, userId])
  @@index([tenantId, userId])
}

// §27 — required reading assignment and open/acknowledge receipts.
model DocumentReadReceipt {
  id             String       @id @default(cuid())
  tenantId       String
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId     String?
  userId         String
  user           UserIdentity @relation("DocumentReadReceiptUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAt     DateTime?
  openedAt       DateTime?
  acknowledgedAt DateTime?

  @@unique([documentId, userId])
  @@index([tenantId, userId])
}

// §44 — chronological, append-only document timeline.
model DocumentActivity {
  id         String        @id @default(cuid())
  tenantId   String
  documentId String
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionId String?
  actorId    String?
  actor      UserIdentity? @relation("DocumentActivityActor", fields: [actorId], references: [id])
  // CREATED | METADATA_CHANGED | FOLDER_MOVED | SHORTCUT_ADDED | SHORTCUT_REMOVED |
  // LINK_ADDED | LINK_REMOVED | REVISION_UPLOADED | STATUS_CHANGED | REVIEW_REQUESTED |
  // APPROVAL_REQUESTED | APPROVAL_RESULT | COMMENT_ADDED | COMMENT_RESOLVED |
  // DOWNLOADED | OPENED | PROMOTED_FROM_TRANZIT | ARCHIVED | RESTORED |
  // EXPIRATION_CHANGED | REQUIRED_READING_ASSIGNED | REQUIRED_READING_ACKNOWLEDGED
  eventType  String
  summary    String
  payload    String? // JSON
  createdAt  DateTime      @default(now())

  @@index([tenantId, documentId, createdAt])
}

// §19.3 — personal saved view (folder context + filters + layout).
model DocumentSavedView {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  name      String
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id])
  layout    String   @default("LIST") // LIST | GRID | TIMELINE | FOLDER
  filters   String? // JSON
  sort      String? // JSON
  columns   String? // JSON
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
}

// =========================================================================
// Platform Configuration — shared infrastructure
// =========================================================================
// Mandated by 7 of the 8 module PRDs (Inventory §60, Teams §32, CRM §41,
// Contracts §44, Finance §39, Assets §19, Documents' config-driven folder
// templates): every module, page, section, widget, feature, workflow, action
// and report must be independently enable/disable-able, and disabled items
// must disappear from navigation, search, APIs and layouts — no dead links,
// no blank spaces.
//
// One row per *explicit* override. Absence means "inherit": from the parent
// node, then from the catalog default (enabled). That keeps the table small
// and makes "enable everything" the zero-row state.
model PlatformConfigSetting {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Null = tenant-wide default. Set = company-specific override, which wins
  // over the tenant row (Inventory §60 "company-specific override", Teams
  // §32, and the group-inheritance requirement).
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Non-null mirror of companyId used for the uniqueness constraint: SQL does
  // not treat two NULLs as equal, so a unique index over a nullable companyId
  // would silently permit duplicate tenant-wide rows for the same node. The
  // sentinel "TENANT" keeps one-row-per-scope actually enforced.
  scope String @default("TENANT")

  // Dotted catalog key from src/lib/platform-config.ts, e.g.
  // "documents", "documents.feature.tranzit", "inventory.action.post_movement".
  nodeKey String
  enabled Boolean @default(true)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, scope, nodeKey])
  @@index([tenantId, companyId])
}

// ---------------------------------------------------------------------------
// PRD_Inventory_Module — additive. §65 Data Ownership Rules: Inventory owns
// stock identity, quantity, location and movements; Procurement owns
// purchasing (Supplier/PurchaseOrder/ProcurementDelivery already exist,
// built separately — a Receipt movement here references a delivery by bare
// sourceModule/sourceId, no Prisma relation, same pattern used everywhere
// else this session); Finance owns valuation postings (deferred, no
// InventoryCostLayer yet); Assets owns long-lived assets *after* conversion
// from inventory (not built here). §21 "Stock balances are derived from
// immutable movement records ... must always be reproducible" — mirrors the
// Finance JournalEntry/JournalLine "posted is immutable, only reversible"
// pattern from the same schema section above.
//
// Phase-1 scope: Product master, Categories, a plain Unit of Measure list,
// Warehouses with an optional bin hierarchy, and the append-only Movement
// ledger with derived StockBalance. Deferred: UOM conversions, Batch/Lot and
// Serial tracking, Reservations, Cycle Counts, Reorder Rules, BOM/Kits,
// costing layers — all specialized extensions on top of this core.
// ---------------------------------------------------------------------------

// §15 — configurable hierarchy, not an enum.
model ProductCategory {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  parentId  String?
  parent    ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("ProductCategoryHierarchy")
  status    String            @default("ACTIVE")
  createdAt DateTime          @default(now())

  products Product[]

  @@unique([tenantId, code])
}

// §14 — kept as a flat lookup for Phase-1; ProductUOM's per-product
// conversion factors are deferred, so every product's stock is counted in
// its own baseUom directly.
model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  symbol    String
  precision Int      @default(0)
  createdAt DateTime @default(now())

  products      Product[]
  movementLines MovementLine[]

  @@unique([tenantId, symbol])
}

// §13 Product Identity and Master Data.
model Product {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku          String
  name         String
  description  String?
  categoryId   String?
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  baseUomId    String?
  baseUom      UnitOfMeasure?   @relation(fields: [baseUomId], references: [id])
  // NONE | BATCH | SERIAL — governs which tracking fields a later phase's
  // movement lines would require; Phase-1 records the intent without
  // enforcing it (no BatchLot/SerialNumber models yet).
  trackingType String           @default("NONE")
  barcode      String?
  brand        String?
  status       String           @default("ACTIVE") // ACTIVE | INACTIVE | DISCONTINUED
  createdAt    DateTime         @default(now())

  movementLines       MovementLine[]
  stockBalances       StockBalance[]
  stockReservations   StockReservation[]
  inventoryCountLines InventoryCountLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
}

// §18 Warehouse Model.
model Warehouse {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  address   String?
  managerId String?
  manager   UserIdentity? @relation("WarehouseManager", fields: [managerId], references: [id])
  status    String        @default("ACTIVE")
  createdAt DateTime      @default(now())

  locations         InventoryLocation[]
  stockBalances     StockBalance[]
  movementLinesFrom MovementLine[]      @relation("MovementLineFromWarehouse")
  movementLinesTo   MovementLine[]      @relation("MovementLineToWarehouse")
  stockReservations StockReservation[]
  inventoryCounts   InventoryCount[]
  dailyCloses       DailyClose[]

  @@unique([tenantId, code])
}

// §20 — an optional bin/location hierarchy within a warehouse; Phase-1's
// StockBalance/MovementLine operate at warehouse granularity, this exists
// so a later phase can drill into locations without a schema change.
model InventoryLocation {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      InventoryLocation?  @relation("InventoryLocationHierarchy", fields: [parentId], references: [id])
  children    InventoryLocation[] @relation("InventoryLocationHierarchy")
  code        String
  type        String              @default("BIN")
  status      String              @default("ACTIVE")

  @@unique([warehouseId, code])
}

// §24/§25/INV-MOV-002 — the movement document header. "Posted stock
// movements are immutable. Corrections use reversing movements" — the exact
// same guarantee src/server/finance-module.ts's JournalEntry enforces;
// postStockMovement()/reverseStockMovement() in src/server/inventory-module.ts
// mirror postJournalEntry()/reverseJournalEntry() deliberately.
model InventoryMovement {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number             String
  // RECEIPT | ISSUE | TRANSFER | ADJUSTMENT_INCREASE | ADJUSTMENT_DECREASE |
  // RETURN_IN | RETURN_OUT
  type               String
  date               DateTime           @default(now())
  reason             String?
  // Where this came from if not entered directly (e.g. "ProcurementDelivery"
  // + a ProcurementDelivery id) — bare reference, no Prisma relation, same
  // pattern as every cross-module link this session.
  sourceModule       String?
  sourceId           String?
  status             String             @default("DRAFT") // DRAFT | POSTED | CANCELLED | REVERSED
  postedAt           DateTime?
  postedById         String?
  postedBy           UserIdentity?      @relation("InventoryMovementPostedBy", fields: [postedById], references: [id])
  reversesMovementId String?            @unique
  reversesMovement   InventoryMovement? @relation("InventoryMovementReversal", fields: [reversesMovementId], references: [id])
  reversedBy         InventoryMovement? @relation("InventoryMovementReversal")
  createdById        String
  createdBy          UserIdentity       @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime           @default(now())

  // PRD_Inventory_Dashboard — Tagged Goods Issue / Transfer Receipt
  // confirmation. Only ISSUE and TRANSFER movements addressed to a named
  // recipient use this; RECEIPT/ADJUSTMENT movements leave it NOT_REQUIRED.
  // Posting still happens the normal way — confirmation is a downstream
  // acknowledgement by the receiving party, never a gate on posting itself.
  projectId          String?
  project            Project?      @relation(fields: [projectId], references: [id])
  recipientId        String?
  recipient          UserIdentity? @relation("InventoryMovementRecipient", fields: [recipientId], references: [id])
  confirmationStatus String        @default("NOT_REQUIRED") // NOT_REQUIRED | PENDING | CONFIRMED | DISPUTED
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        UserIdentity? @relation("InventoryMovementConfirmedBy", fields: [confirmedById], references: [id])
  disputeReason      String?

  lines                 MovementLine[]
  fulfilledReservations StockReservation[]
  adjustmentForCounts   InventoryCount[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, confirmationStatus])
}

// §24 MovementLine — one product quantity moving between warehouses (or
// receiving into / issuing out of one, when the other side is null).
model MovementLine {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movementId      String
  movement        InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  qty             Float
  uomId           String?
  uom             UnitOfMeasure?    @relation(fields: [uomId], references: [id])
  unitCost        Float?
  fromWarehouseId String?
  fromWarehouse   Warehouse?        @relation("MovementLineFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String?
  toWarehouse     Warehouse?        @relation("MovementLineToWarehouse", fields: [toWarehouseId], references: [id])
  // PRD_Inventory_Dashboard §Expiration — recorded at receipt when the
  // product's trackingType calls for it; Phase-1 has no BatchLot model, so
  // this lives directly on the line rather than a lot record.
  expiryDate      DateTime?

  @@index([tenantId, movementId])
  @@index([tenantId, productId])
}

// §21/§22 — the cached, derived balance. Always reproducible by replaying
// posted movements (see recomputeStockBalance() in inventory-module.ts);
// never the source of truth, only a read-optimized projection of it.
model StockBalance {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand       Float     @default(0)
  reserved     Float     @default(0)
  blocked      Float     @default(0)
  updatedAt    DateTime  @updatedAt
  // PRD_Inventory_Dashboard §Reorder — per product/warehouse; null means the
  // pair is not reorder-managed and never appears on the Reorder page.
  reorderPoint Float?
  reorderQty   Float?

  @@unique([productId, warehouseId])
  @@index([tenantId, warehouseId])
}

// Audit timeline — same pattern as Contract/Document/Task/Finance.
model InventoryActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "InventoryMovement" | "Product" | "Warehouse"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("InventoryActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// PRD_Inventory_Dashboard §Reservations — soft-holds a quantity against a
// project/purpose before any movement exists; StockBalance.reserved is the
// running total this drives. Never itself moves stock — only ever released
// (cancelled/expired) or fulfilled by a real posted movement.
model StockReservation {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId         String
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id])
  productId           String
  product             Product            @relation(fields: [productId], references: [id])
  qty                 Float
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id])
  purpose             String?
  status              String             @default("ACTIVE") // ACTIVE | FULFILLED | CANCELLED | EXPIRED
  expiresAt           DateTime?
  fulfilledMovementId String?
  fulfilledMovement   InventoryMovement? @relation(fields: [fulfilledMovementId], references: [id])
  requestedById       String
  requestedBy         UserIdentity       @relation("StockReservationRequestedBy", fields: [requestedById], references: [id])
  createdAt           DateTime           @default(now())

  @@index([tenantId, status])
  @@index([tenantId, productId, warehouseId])
}

// PRD_Inventory_Dashboard §Counts (Control) — a cycle or full physical count.
// Blind by default (counters don't see the system quantity while entering
// counts); variances are only posted to stock via a real ADJUSTMENT
// movement created at approval, never by editing StockBalance directly.
model InventoryCount {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId          String
  warehouse            Warehouse          @relation(fields: [warehouseId], references: [id])
  type                 String             @default("CYCLE") // CYCLE | PHYSICAL
  blind                Boolean            @default(true)
  status               String             @default("PLANNED") // PLANNED | IN_PROGRESS | SUBMITTED | APPROVED | CANCELLED
  scheduledDate        DateTime?
  startedAt            DateTime?
  submittedAt          DateTime?
  approvedAt           DateTime?
  createdById          String
  createdBy            UserIdentity       @relation("InventoryCountCreatedBy", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           UserIdentity?      @relation("InventoryCountApprovedBy", fields: [approvedById], references: [id])
  adjustmentMovementId String?
  adjustmentMovement   InventoryMovement? @relation(fields: [adjustmentMovementId], references: [id])
  createdAt            DateTime           @default(now())

  lines InventoryCountLine[]

  @@index([tenantId, status])
  @@index([tenantId, warehouseId])
}

model InventoryCountLine {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  countId        String
  count          InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  systemQty      Float
  countedQty     Float?
  varianceReason String?
  countedById    String?
  countedBy      UserIdentity?  @relation("InventoryCountLineCountedBy", fields: [countedById], references: [id])
  countedAt      DateTime?

  @@index([tenantId, countId])
}

// PRD_Inventory_Dashboard §Daily Close — one row per warehouse per work date;
// a lightweight end-of-day attestation, not a ledger period lock (Finance
// already owns period closing). ATTENTION_REQUIRED covers unconfirmed
// deliveries/unresolved disputes/open counts still outstanding at close.
model DailyClose {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId        String
  warehouse          Warehouse     @relation(fields: [warehouseId], references: [id])
  workDate           DateTime
  status             String        @default("DUE") // DUE | NO_MOVEMENT | COMPLETE | ATTENTION_REQUIRED
  movementsCount     Int           @default(0)
  discrepanciesCount Int           @default(0)
  notes              String?
  confirmedById      String?
  confirmedBy        UserIdentity? @relation("DailyCloseConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt        DateTime?
  createdAt          DateTime      @default(now())

  @@unique([warehouseId, workDate])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// PRD_HR_Payroll_Workforce — Phase 1 (HR foundation). Additive alongside the
// existing Employee/SalaryRecord/LeaveRequest/EmployeeTraining rows — those
// keep working unchanged. This adds the PRD's effective-dated employment
// core: "HR governs employment" as a permanently separate concern from
// Payroll (calculates compensation — not built here, Phase 3 in the PRD's own
// sequencing) and from the public professional profile (ProfessionalProfile
// — "who this person is"). Confidentiality is permission-ready
// (confidentialityZone) but only coarse HR/FULL gating is enforced in Phase 1
// (module_prd_conventions rule 2).
// ---------------------------------------------------------------------------

model EmploymentRelationship {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])

  employmentType String    @default("EMPLOYEE") // EMPLOYEE | CONTRACTOR | EXTERNAL
  contractType   String    @default("FULL_TIME") // FULL_TIME | PART_TIME | FIXED_TERM | SEASONAL
  jobTitle       String
  department     String
  reportsToId    String?
  reportsTo      Employee? @relation("EmploymentReportsTo", fields: [reportsToId], references: [id])

  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | TRANSFERRED | TERMINATED

  // Intercompany transfer creates a NEW relationship, never mutates the old
  // one — this link preserves the chain for history/reporting.
  transferredFromId String?                 @unique
  transferredFrom   EmploymentRelationship? @relation("EmploymentTransfer", fields: [transferredFromId], references: [id])
  transferredTo     EmploymentRelationship? @relation("EmploymentTransfer")

  confidentialityZone String  @default("INTERNAL_PROFESSIONAL") // PUBLIC_PROFESSIONAL | INTERNAL_PROFESSIONAL | HR_CONFIDENTIAL
  notes               String?

  createdById String
  createdBy   UserIdentity @relation("EmploymentRelationshipCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payrollRunLines PayrollRunLine[]
  timesheets      Timesheet[]

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model HrActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "EmploymentRelationship" | "Employee"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("HrActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_Government_Legal_Compliance — Phase 1 (regulatory/permits foundation).
// New domain, no prior code. Projects module is FROZEN (projects_module_frozen)
// — every projectId below is a plain scalar reference, never a Prisma
// relation, so nothing here touches the Project model. "Files are evidence,
// not the business object": structured permit/authority data lives here; any
// scanned document stays a linked DocumentFile.
// ---------------------------------------------------------------------------

model LegalAuthority {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    String   @default("MUNICIPAL") // MUNICIPAL | NATIONAL | UTILITY | FIRE | ENVIRONMENTAL | OTHER
  contactInfo String?
  createdAt   DateTime @default(now())

  permits Permit[]

  @@index([tenantId])
}

// Immutable once ISSUED — corrections happen via a new PermitAmendment row,
// never by editing these fields in place ("no silent overwrites").
model Permit {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String // scalar reference only — Projects module is frozen
  authorityId String
  authority   LegalAuthority @relation(fields: [authorityId], references: [id])

  permitType           String // BUILDING | ENVIRONMENTAL | OCCUPANCY | DEMOLITION | UTILITY_CONNECTION | OTHER
  referenceNumber      String?
  status               String    @default("DRAFT") // DRAFT | SUBMITTED | ISSUED | REJECTED | EXPIRED | REVOKED
  issuedDate           DateTime?
  expiryDate           DateTime?
  confidentialityLevel String    @default("STANDARD") // STANDARD | RESTRICTED | CONFIDENTIAL

  createdById String
  createdBy   UserIdentity @relation("PermitCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  conditions PermitCondition[]
  amendments PermitAmendment[]

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model PermitCondition {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitId    String
  permit      Permit    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  description String
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN | SATISFIED | OVERDUE
  createdAt   DateTime  @default(now())

  @@index([tenantId, permitId])
}

model PermitAmendment {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permitId      String
  permit        Permit       @relation(fields: [permitId], references: [id], onDelete: Cascade)
  description   String
  newExpiryDate DateTime?
  createdById   String
  createdBy     UserIdentity @relation("PermitAmendmentCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, permitId])
}

// One row per project — the cached Legal Readiness Gate that Work Progress /
// Projects are meant to check before allowing work. Phase 1: settable by a
// Legal-permissioned user (manual) — the PRD's full automatic engine is later
// work. READY | READY_WITH_CONDITIONS | RESTRICTED | BLOCKED | UNKNOWN.
model LegalReadinessStatus {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String        @unique // scalar reference only — Projects module is frozen
  status    String        @default("UNKNOWN")
  reason    String?
  setById   String?
  setBy     UserIdentity? @relation("LegalReadinessSetBy", fields: [setById], references: [id])
  updatedAt DateTime      @updatedAt

  @@index([tenantId])
}

model LegalActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "Permit" | "LegalAuthority" | "LegalReadinessStatus" | "LegalCase"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("LegalActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_Government_Legal_Compliance — Cases, Disputes & Legal Hold, this PRD's
// Phase 3 layer (regulatory/permits foundation from Phase 1 already exists
// above). Scoped to the entities that actually change behaviour: LegalCase
// covers the PRD's Claim/Dispute/LegalCase family under one status-tracked
// record (caseType distinguishes them), and the confidentiality ladder is
// collapsed from the PRD's 7 named tiers to 2 enforcement buckets — role-
// visible (STANDARD/RESTRICTED) vs grant-required (everything else,
// CONFIDENTIAL and up) — because the behaviour that actually matters is
// binary: "does LEGAL role membership alone see this, or does it require an
// explicit LegalCaseAccess grant." Not built: LegalOpinion/PowerOfAttorney,
// RegulatoryInspection, ComplianceObligation, LegalNotice, Fine/Penalty/
// Appeal, insurance/property-legal records — later PRD phases.
//
// LegalHold is a registry only — Documents has no delete action yet to
// enforce against (checked before building), so there is nothing to wire a
// block into today; the hold record exists and is ready for that hook once
// Documents grows one, same "registry + logged intent, enforcement deferred"
// boundary already used for IT Admin (no live SSO) and BIM (no live viewer).
// ---------------------------------------------------------------------------

model LegalCase {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseNumber          String
  title               String
  caseType            String // LITIGATION | CLAIM | DISPUTE | REGULATORY | OTHER
  status              String    @default("OPEN") // OPEN | IN_PROGRESS | ON_HOLD | RESOLVED | CLOSED
  // Soft reference — Projects module is FROZEN, never a Prisma relation.
  projectId           String?
  counterparty        String?
  summary             String?
  confidentialityTier String    @default("STANDARD") // STANDARD | RESTRICTED | CONFIDENTIAL | LEGAL_PRIVILEGED | EXECUTIVE | LITIGATION_RESTRICTED | EXTERNAL_COUNSEL_ONLY
  openedById          String
  openedAt            DateTime  @default(now())
  closedAt            DateTime?

  accessGrants LegalCaseAccess[]
  holds        LegalHold[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
}

// The PRD's own rule: "project access does not automatically grant case
// access." A grant is independent of project-team membership and of
// COMPANY_SETTINGS/USER_MANAGEMENT — it is checked in addition to, not
// instead of, the LEGAL role gate in canViewLegalCase().
model LegalCaseAccess {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId      String
  legalCase   LegalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String
  grantedById String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([caseId, userId])
}

model LegalHold {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId       String?
  legalCase    LegalCase? @relation(fields: [caseId], references: [id])
  scope        String // free-text description of what the hold covers
  targetType   String? // soft reference, e.g. "Document" — no FK, see schema note above
  targetId     String?
  status       String     @default("ACTIVE") // ACTIVE | RELEASED
  placedById   String
  placedAt     DateTime   @default(now())
  releasedById String?
  releasedAt   DateTime?

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// PRD_HSE_Module — Phase 1 (hazards, risk assessments, permits-to-work,
// stop-work). Additive alongside the existing HseReport (incident reports,
// kept as-is). projectId below is a plain scalar reference — Projects is
// frozen. Reuses the existing HSE_REPORTS resource for gating (the whole HSE
// domain now, not just reports — see permissions.ts).
// ---------------------------------------------------------------------------

model Hazard {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String
  title          String
  description    String
  category       String       @default("GENERAL") // GENERAL | ELECTRICAL | HEIGHT | CONFINED_SPACE | CHEMICAL | MECHANICAL | ENVIRONMENTAL
  likelihood     String       @default("POSSIBLE") // RARE | UNLIKELY | POSSIBLE | LIKELY | ALMOST_CERTAIN
  severity       String       @default("MODERATE") // MINOR | MODERATE | MAJOR | CATASTROPHIC
  // Hierarchy of Controls — critical rule: must not default to PPE when a
  // stronger control is available. Highest control actually applied.
  controlLevel   String       @default("ADMINISTRATIVE") // ELIMINATE | SUBSTITUTE | ENGINEERING | ADMINISTRATIVE | PPE
  controlNotes   String?
  status         String       @default("OPEN") // OPEN | CONTROLLED | CLOSED
  identifiedById String
  identifiedBy   UserIdentity @relation("HazardIdentifiedBy", fields: [identifiedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  riskAssessments RiskAssessment[]

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model RiskAssessment {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  hazardId     String?
  hazard       Hazard?       @relation(fields: [hazardId], references: [id])
  title        String
  status       String        @default("DRAFT") // DRAFT | APPROVED | EXPIRED
  validFrom    DateTime?
  validTo      DateTime?
  approvedById String?
  approvedBy   UserIdentity? @relation("RiskAssessmentApprovedBy", fields: [approvedById], references: [id])
  createdById  String
  createdBy    UserIdentity  @relation("RiskAssessmentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model PermitToWork {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String
  permitType    String // HOT_WORK | CONFINED_SPACE_ENTRY | WORKING_AT_HEIGHT | EXCAVATION | ELECTRICAL_ISOLATION | LIFTING | RADIOGRAPHY | DEMOLITION | OTHER
  status        String        @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED | CLOSED | EXPIRED
  description   String?
  validFrom     DateTime?
  validTo       DateTime?
  requestedById String
  requestedBy   UserIdentity  @relation("PermitToWorkRequestedBy", fields: [requestedById], references: [id])
  issuedById    String?
  issuedBy      UserIdentity? @relation("PermitToWorkIssuedBy", fields: [issuedById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// Can block scope at project / zone / work-package / contractor / asset /
// permit / activity / material granularity — scopeRef is a free-text pointer
// (no hard FK; the referenced record may live in any module) for Phase 1.
// Cannot be silently released: release requires releasedById + releasedAt.
model StopWorkOrder {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  scopeType    String        @default("PROJECT") // PROJECT | ZONE | WORK_PACKAGE | CONTRACTOR | ASSET | PERMIT | ACTIVITY | MATERIAL
  scopeRef     String?
  reason       String
  status       String        @default("ACTIVE") // ACTIVE | RELEASED
  issuedById   String
  issuedBy     UserIdentity  @relation("StopWorkIssuedBy", fields: [issuedById], references: [id])
  issuedAt     DateTime      @default(now())
  releasedById String?
  releasedBy   UserIdentity? @relation("StopWorkReleasedBy", fields: [releasedById], references: [id])
  releasedAt   DateTime?
  releaseNotes String?

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model HseActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "Hazard" | "RiskAssessment" | "PermitToWork" | "StopWorkOrder" | "HseReport"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("HseActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_HSE_Module §49.1 "Phase 1 - Operational Foundation" rework (additive,
// 2026-08-06) — the pieces of the new, more comprehensive PRD's own Phase 1
// that the first HSE pass (Hazard/RiskAssessment/PermitToWork/StopWorkOrder)
// didn't cover: Inspections & Observations, Incidents/Investigations/Actions,
// Inductions & Toolbox Talks, Emergency contacts. Same conventions as above:
// projectId is a plain scalar (Projects module is frozen), events land in the
// shared HseActivity log, gated by the existing HSE_REPORTS resource.
// ---------------------------------------------------------------------------

model HseInspection {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  number      String
  type        String       @default("SITE_SAFETY") // SITE_SAFETY | SCAFFOLD | EQUIPMENT | ELECTRICAL | ENVIRONMENTAL | OTHER
  location    String?
  outcome     String       @default("PENDING") // PENDING | PASS | CONDITIONAL | FAIL
  findings    String?
  status      String       @default("DRAFT") // DRAFT | COMPLETED
  inspectedAt DateTime     @default(now())
  inspectorId String
  inspector   UserIdentity @relation("HseInspectionInspector", fields: [inspectorId], references: [id])
  createdAt   DateTime     @default(now())

  correctiveActions HseCorrectiveAction[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model HseObservation {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  number       String
  type         String       @default("UNSAFE_ACT") // SAFE_ACT | UNSAFE_ACT | SAFE_CONDITION | UNSAFE_CONDITION | NEAR_MISS
  description  String
  location     String?
  severity     String       @default("LOW") // LOW | MEDIUM | HIGH
  status       String       @default("OPEN") // OPEN | ACTIONED | CLOSED
  actionTaken  String?
  reportedById String
  reportedBy   UserIdentity @relation("HseObservationReportedBy", fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// Formal incident record — deliberately separate from the older, generic
// HseReport (kept as-is, still used elsewhere): this carries the
// classification/investigation/closure workflow the PRD's "Incidents,
// Investigations and Actions" Phase-1 line actually needs.
model HseIncident {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId        String
  number           String
  classification   String        @default("NEAR_MISS") // NEAR_MISS | FIRST_AID | MEDICAL_TREATMENT | LOST_TIME | FATALITY | PROPERTY_DAMAGE | ENVIRONMENTAL
  title            String
  description      String
  occurredAt       DateTime
  location         String?
  injuredPersonRef String? // free-text — no separate PII model in Phase 1
  status           String        @default("REPORTED") // REPORTED | UNDER_INVESTIGATION | ACTION_PENDING | CLOSED
  rootCause        String?
  closedAt         DateTime?
  reportedById     String
  reportedBy       UserIdentity  @relation("HseIncidentReportedBy", fields: [reportedById], references: [id])
  investigatorId   String?
  investigator     UserIdentity? @relation("HseIncidentInvestigator", fields: [investigatorId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  correctiveActions HseCorrectiveAction[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// Corrective actions can come out of an incident, an inspection or an
// observation — exactly one parent is expected, enforced at the server layer
// (Prisma has no cross-field XOR constraint).
model HseCorrectiveAction {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentId   String?
  incident     HseIncident?   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  inspectionId String?
  inspection   HseInspection? @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description  String
  dueDate      DateTime?
  status       String         @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED
  completedAt  DateTime?
  ownerId      String
  owner        UserIdentity   @relation("HseCorrectiveActionOwner", fields: [ownerId], references: [id])
  verifiedById String?
  verifiedBy   UserIdentity?  @relation("HseCorrectiveActionVerifiedBy", fields: [verifiedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([tenantId, status])
}

model HseInduction {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String
  workerName    String
  workerCompany String?
  topicsCovered String?
  conductedAt   DateTime     @default(now())
  expiresAt     DateTime?
  conductedById String
  conductedBy   UserIdentity @relation("HseInductionConductedBy", fields: [conductedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, projectId])
}

model HseToolboxTalk {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String
  topic         String
  notes         String?
  attendeeCount Int          @default(0)
  conductedAt   DateTime     @default(now())
  conductedById String
  conductedBy   UserIdentity @relation("HseToolboxTalkConductedBy", fields: [conductedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([tenantId, projectId])
}

model HseEmergencyContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  role      String?
  phone     String
  type      String   @default("OTHER") // AMBULANCE | FIRE | POLICE | HOSPITAL | SITE_MANAGER | CLIENT | OTHER
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_HR_Payroll_Workforce — Phase 2 (Payroll: locked runs, pass-through
// calculation). Scope decision 2026-08-06: tax/contribution calculation is
// deliberately pass-through only — gross/net are taken directly from the
// employee's CURRENT SalaryRecord, same numbers as today, no invented tax
// law. Locking a run does NOT post to Finance yet ("Payroll computes,
// Finance posts" is the PRD's own boundary — deferred, matching Inventory's
// posting-ready-events pattern rather than posting directly). Every run line
// still carries a calculation trace per the PRD's "no black-box numbers"
// rule, even though the formula is intentionally trivial for now.
// ---------------------------------------------------------------------------

model PayrollGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  frequency String   @default("MONTHLY") // MONTHLY | BIWEEKLY | WEEKLY | ANNUAL
  currency  String   @default("EUR")
  createdAt DateTime @default(now())

  runs PayrollRun[]

  @@index([tenantId, companyId])
}

// Locked runs are immutable — DRAFT/CALCULATED lines can be recalculated,
// LOCKED lines never change. A correction to a locked run is a new run that
// references it via adjustsRunId, never a reopen of the original.
model PayrollRun {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollGroupId String
  payrollGroup   PayrollGroup @relation(fields: [payrollGroupId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  status      String   @default("DRAFT") // DRAFT | CALCULATED | LOCKED | CANCELLED

  adjustsRunId String?      @unique
  adjustsRun   PayrollRun?  @relation("PayrollRunAdjustment", fields: [adjustsRunId], references: [id])
  adjustments  PayrollRun[] @relation("PayrollRunAdjustment")

  createdById String
  createdBy   UserIdentity  @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  lockedById  String?
  lockedBy    UserIdentity? @relation("PayrollRunLockedBy", fields: [lockedById], references: [id])
  lockedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lines PayrollRunLine[]

  @@index([tenantId, payrollGroupId])
  @@index([tenantId, status])
}

model PayrollRunLine {
  id                       String                  @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunId             String
  payrollRun               PayrollRun              @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId               String
  employee                 Employee                @relation(fields: [employeeId], references: [id])
  employmentRelationshipId String?
  employmentRelationship   EmploymentRelationship? @relation(fields: [employmentRelationshipId], references: [id])
  salaryRecordId           String?
  salaryRecord             SalaryRecord?           @relation(fields: [salaryRecordId], references: [id])

  grossSalary      Float
  netSalary        Float
  currency         String @default("EUR")
  // Phase 2 is intentionally trivial ("source: SalaryRecord X, formula:
  // pass-through, rounding: none") — Phase 3 would replace this with the
  // real multi-step engine (earnings/deductions/taxes/employer costs).
  calculationTrace String

  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([tenantId, employeeId])
}

model PayrollActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "PayrollRun" | "PayrollGroup"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("PayrollActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_HR_Dashboard — Timesheets / Project Labour (additive). Bridges
// Workforce (Attendance/Shifts) and Payroll/Finance without ever treating
// project physical progress as proof of payable time — hours are entered
// and verified here independently of Work Progress module reporting.
// ---------------------------------------------------------------------------

model Timesheet {
  id              String                 @id @default(cuid())
  tenantId        String
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employmentId    String
  employment      EmploymentRelationship @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  weekStartDate   DateTime
  status          String                 @default("DRAFT") // DRAFT | SUBMITTED | VERIFIED | REJECTED | LOCKED
  totalHours      Float                  @default(0)
  submittedAt     DateTime?
  verifiedById    String?
  verifiedBy      UserIdentity?          @relation("TimesheetVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  lines TimesheetLine[]

  @@unique([employmentId, weekStartDate])
  @@index([tenantId, status])
}

// One row per day/project/task split within a Timesheet — this is the grain
// Project Labour (Hours/Allocation/Capacity) aggregates over; a line with no
// projectId is non-billable/internal time, excluded from Project Labour.
model TimesheetLine {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  taskId      String?
  costCode    String?
  hours       Float
  description String?

  @@index([tenantId, timesheetId])
  @@index([tenantId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_Reporting_Analytics — Phase 1. Scope simplification decided 2026-08-06:
// live Prisma queries against the operational tables, no separate CDC
// warehouse. These four models are the module's own bookkeeping (what
// metrics/reports exist, who ran what) — they never cache the actual report
// rows, so there is nothing here that can go stale relative to source data.
// ---------------------------------------------------------------------------

// A catalogued KPI — "every key KPI has a visible formula, source and scope"
// (a rule repeated in every module PRD this platform has built). Seeded
// idempotently by ensureMetricCatalogue(); resolved live by analytics.ts,
// never stored as a value here.
model MetricDefinition {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key            String // stable machine key, e.g. "PROJECTS_ON_TIME_PCT"
  label          String
  description    String?
  category       String // PROJECTS | FINANCE | HR | PROCUREMENT | WORK_PROGRESS | HSE
  unit           String   @default("COUNT") // COUNT | PERCENT | CURRENCY | DAYS
  formulaSummary String
  sourceModule   String
  createdAt      DateTime @default(now())

  @@unique([tenantId, key])
  @@index([tenantId, category])
}

// A saved, re-runnable report — deliberately just a named pointer to one of
// a fixed set of server-side report kinds plus optional filters, not a
// free-form query builder (that's later work).
model ReportDefinition {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  kind        String // PROJECTS_STATUS | FINANCE_BUDGET_VS_ACTUAL | HR_HEADCOUNT | PROCUREMENT_SPEND | WORK_PROGRESS_STATUS | HSE_SAFETY
  filtersJson String?
  createdById String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  executions ReportExecution[]

  @@index([tenantId, kind])
}

// One row per run — records that a report ran and what it returned, not the
// rows themselves (rows are always re-queried live, per the CDC-warehouse
// simplification above).
model ReportExecution {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportDefinitionId String
  reportDefinition   ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  executedById       String
  executedBy         UserIdentity     @relation("ReportExecutedBy", fields: [executedById], references: [id])
  rowCount           Int              @default(0)
  executedAt         DateTime         @default(now())
  // Phase 2/3 — opt-in freeze. Null/false is the Phase 1 default (rows
  // always re-queried live); issuing one snapshot freezes that run's exact
  // result so it can never change even if the underlying data does later.
  resultJson         String?
  issued             Boolean          @default(false)
  issuedAt           DateTime?
  issuedById         String?

  @@index([tenantId, reportDefinitionId])
}

model AnalyticsActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "ReportDefinition" | "MetricDefinition"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("AnalyticsActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_Notifications_Event_Centre — Phase 1 "Core event + inbox" slice only
// (catalogue + policy engine + governed publish), decided 2026-08-06. The
// full PRD (~30 entities: recipient-rule DSL, digests, escalation,
// announcements, external channels, dead-letter queue) is platform-wide
// meta-infrastructure, same category as the set-aside PRD_15 — deliberately
// not attempted here. This does NOT replace the existing ad-hoc
// `db.notification.create` call sites scattered across the app (task
// mentions, HR leave, auth invites, document approvals) — those keep
// working as-is; `publishEvent` below is new, governed infrastructure for
// call sites that adopt it going forward, not a retrofit of the old ones.
// ---------------------------------------------------------------------------

// The catalogue of known event types — "source modules record what
// happened" (the PRD's permanent rule). Seeded idempotently, same pattern
// as MetricDefinition/ensureMetricCatalogue above.
model EventCatalogueEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String // stable machine key, e.g. "WORK_PROGRESS.PACKAGE_ACCEPTED"
  label       String
  description String?
  module      String
  // STANDARD | INTERNAL | RESTRICTED | CONFIDENTIAL | LEGAL_PRIVILEGED |
  // PAYROLL_RESTRICTED | MEDICAL_RESTRICTED | EMERGENCY (PRD §11 sensitivity classes)
  sensitivity String   @default("STANDARD")
  createdAt   DateTime @default(now())

  policy NotificationPolicy?

  @@unique([tenantId, key])
  @@index([tenantId, module])
}

// One row per event key — "Policy & recipient resolution" layer, kept
// deliberately thin for Phase 1 (in-app only, no condition/recipient-rule
// DSL yet): can this event be muted, and is in-app delivery on at all.
// Mandatory events bypass NotificationPreference the same way Emergency
// outranks everything in the PRD's precedence ladder.
model NotificationPolicy {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventKey     String
  eventEntry   EventCatalogueEntry @relation(fields: [tenantId, eventKey], references: [tenantId, key], onDelete: Cascade)
  mandatory    Boolean             @default(false)
  inAppEnabled Boolean             @default(true)
  updatedById  String?
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, eventKey])
}

// ---------------------------------------------------------------------------
// PRD_BIM_3D_Digital_Twin — adapted Phase-1 scope decided 2026-08-06:
// **registry and metadata only, no live 3D viewer.** The full PRD (29
// entities) requires a WebGL2/WebGPU renderer, sandboxed geometry-conversion
// workers and object-identity matching across revisions — none of which
// exist anywhere in this stack, and the PRD itself leaves the rendering
// stack/parser technology as an open decision. This slice gives every other
// module something real to link against (a stable model + object reference)
// without pretending a viewer exists. Uploaded files are stored the same
// soft-`documentId`-reference way as WorkProgressEvidence/SupplierDocument —
// BIM never owns the bytes, Documents does.
// ---------------------------------------------------------------------------

model BimModel {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String
  name        String
  discipline  String   @default("ARCHITECTURAL") // ARCHITECTURAL | STRUCTURAL | MEP | LANDSCAPE | CIVIL | OTHER
  status      String   @default("DRAFT") // DRAFT | VALIDATED | PUBLISHED | ARCHIVED
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions           BimModelVersion[]
  links              BimObjectLink[]
  coordinationIssues CoordinationIssue[]

  @@index([tenantId, projectId])
}

// One row per uploaded revision — IFC/glTF intake in the full PRD; here just
// the registry record + a soft pointer to the source file in Documents.
// Never overwrites a prior version (same immutable-revision rule as every
// other module's revision chain in this codebase).
model BimModelVersion {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelId       String
  model         BimModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  versionNumber Int
  documentId    String? // soft reference — the source IFC/glTF file lives in Documents
  fileName      String?
  status        String       @default("UPLOADED") // UPLOADED | VALIDATED | CONVERSION_FAILED | READY
  notes         String?
  uploadedById  String
  uploadedBy    UserIdentity @relation("BimModelVersionUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([modelId, versionNumber])
}

// The one mechanism other modules actually need from BIM at this stage: a
// stable, typed pointer from a model (optionally down to one named object
// within it) to a record in any other module — Task, WorkPackage, Asset,
// Unit, HseHazard, etc. No geometry, no identity-matching confidence score;
// `objectRef` is a free-text element/GUID identifier for Phase 1.
model BimObjectLink {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modelId     String
  model       BimModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  objectRef   String? // element GUID/tag within the model; null = links the whole model
  entityType  String // TASK | WORK_PACKAGE | ASSET | UNIT | HSE_HAZARD | DOCUMENT | OTHER
  entityId    String
  relation    String       @default("RELATES_TO") // RELATES_TO | REPRESENTS | AFFECTS
  createdById String
  createdBy   UserIdentity @relation("BimObjectLinkCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([tenantId, modelId])
  @@index([tenantId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// PRD_Approvals_Workflow_Engine — Phase 1 "Approval foundation" only (per the
// PRD's own §54 phase plan). Sequential routing, a work-item queue, immutable
// decisions, and audit — no parallel/quorum paths, no visual builder, no
// durable-timer/SLA engine, no BPMN-compatibility layer. Modeled as a real
// state machine (not a bool flag) because "approved" and "source finalized"
// are deliberately distinct statuses (WF-FR-015): a workflow can be fully
// approved yet still waiting on the owning module to apply its own
// transition. Source modules stay in full control of their own state; this
// engine only owns routing + decisions, exactly like the PRD's ownership
// boundary requires.
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key              String // stable machine key, e.g. "HSE_INCIDENT_CLOSURE"
  name             String
  sourceModule     String
  sourceEntityType String
  isActive         Boolean  @default(true)
  createdById      String
  createdAt        DateTime @default(now())

  stages    WorkflowStageTemplate[]
  instances WorkflowInstance[]

  @@unique([tenantId, key])
  @@index([tenantId, sourceModule, sourceEntityType])
}

model WorkflowStageTemplate {
  id                   String             @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  sequence             Int
  name                 String
  // Exactly one of these is set — a role-wide approval slot, or one named approver.
  approverRole         String?
  approverUserId       String?
  createdAt            DateTime           @default(now())

  @@unique([workflowDefinitionId, sequence])
}

model WorkflowInstance {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  sourceModule         String
  sourceEntityType     String
  sourceEntityId       String
  sourceRecordVersion  Int                @default(1)
  // PENDING | APPROVED | REJECTED | CANCELLED | SOURCE_FINALIZATION_PENDING | COMPLETED
  status               String             @default("PENDING")
  currentStageSequence Int?
  submittedById        String
  submittedBy          UserIdentity       @relation("WorkflowInstanceSubmittedBy", fields: [submittedById], references: [id])
  submittedAt          DateTime           @default(now())
  completedAt          DateTime?
  correlationId        String?
  createdAt            DateTime           @default(now())

  stages    WorkflowStageInstance[]
  decisions WorkflowDecision[]

  // WF-FR-002 idempotency: at most one non-terminal instance per source record.
  @@index([tenantId, sourceModule, sourceEntityType, sourceEntityId])
  @@index([tenantId, status])
}

model WorkflowStageInstance {
  id                 String           @id @default(cuid())
  workflowInstanceId String
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  sequence           Int
  name               String
  approverRole       String?
  approverUserId     String?
  // PENDING | ACTIVE | APPROVED | REJECTED | SKIPPED
  status             String           @default("PENDING")
  decidedById        String?
  decidedAt          DateTime?
  createdAt          DateTime         @default(now())

  decisions WorkflowDecision[]

  @@unique([workflowInstanceId, sequence])
}

// Immutable by construction — no update/delete server action is ever exposed
// for this model (WF-FR-008/WF-FR-038: corrections happen via a new decision
// on a returned/resubmitted stage, never by editing history).
model WorkflowDecision {
  id                 String                @id @default(cuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowInstanceId String
  workflowInstance   WorkflowInstance      @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stageInstanceId    String
  stageInstance      WorkflowStageInstance @relation(fields: [stageInstanceId], references: [id], onDelete: Cascade)
  decidedById        String
  decidedBy          UserIdentity          @relation("WorkflowDecisionDecidedBy", fields: [decidedById], references: [id])
  decision           String // APPROVE | REJECT | RETURN
  comment            String?
  decidedAt          DateTime              @default(now())

  @@index([tenantId, workflowInstanceId])
}

// ---------------------------------------------------------------------------
// PRD_Complete_Role_Permission_Matrix — the PRD's own capability-key model
// (§10/§33, format "<domain>.<resource>.<action>") is the formally-specified
// replacement for src/lib/permissions.ts's coarse can(role, RESOURCE, LEVEL).
// Adopting it in full (60+ roles, field policy, SoD engine, break-glass) is a
// multi-quarter platform rebuild per that PRD's own phase plan. What ships
// here is the addressable primitive underneath it: a capability-key registry
// (src/lib/capabilities.ts, in-code, mirrors CONFIG_NODES/RESOURCES) with
// default per-role grants, PLUS this table for the one thing a static role
// matrix can never express — an explicit, audited, per-user grant beyond
// (or narrower than) role defaults. Existing can()/RESOURCES is untouched;
// this is an additive, narrower-scope layer alongside it, exactly the way
// the PRD's own Appendix A keys (hse.stop_work.release, hr.compensation.view,
// workflow.instance.override) were the concrete motivating cases.
// ---------------------------------------------------------------------------

model UserCapabilityGrant {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          UserIdentity @relation("UserCapabilityGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  capabilityKey String
  grantedById   String
  grantedBy     UserIdentity @relation("UserCapabilityGrantGrantedBy", fields: [grantedById], references: [id])
  grantedAt     DateTime     @default(now())
  revokedAt     DateTime?

  @@unique([userId, capabilityKey])
  @@index([tenantId, capabilityKey])
}

// ---------------------------------------------------------------------------
// PRD_IT_Administration_Integrations_Service_Management — Phase 1 "IT
// Foundation" only (§57): protected IT department, device/licence registry,
// Service Desk. Zero external-provider dependency by design — no real SSO/
// M365/Google/webhook adapters (Phases 2-4 of that PRD), matching the same
// "registry + logged action, no real external call" scope-down already used
// for BIM (no live viewer) and Notifications (no external channels).
// ---------------------------------------------------------------------------

model ItDepartmentProfile {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode      String   @default("BASIC") // BASIC | MANAGED
  createdAt DateTime @default(now())
}

model ItDevice {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetId      String? // soft reference — the physical asset record lives in the Assets module
  name         String
  deviceType   String // LAPTOP | DESKTOP | MOBILE | TABLET | SERVER | NETWORK | OTHER
  ownerUserId  String?
  serialNumber String?
  status       String   @default("ACTIVE") // ACTIVE | RETIRED | LOST | IN_REPAIR
  notes        String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
}

model SoftwareLicence {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productName String
  vendor      String?
  seatsTotal  Int
  expiresAt   DateTime?
  costPerSeat Float?
  notes       String?
  createdById String
  createdAt   DateTime  @default(now())

  assignments LicenceAssignment[]

  @@index([tenantId])
}

model LicenceAssignment {
  id         String          @id @default(cuid())
  licenceId  String
  licence    SoftwareLicence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime        @default(now())
  revokedAt  DateTime?

  @@index([licenceId])
}

model ItServiceTicket {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  ticketType    String // REQUEST | INCIDENT | PROBLEM | CHANGE
  title         String
  description   String?
  priority      String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status        String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  requestedById String
  assignedToId  String?
  resolvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  comments ItTicketComment[]

  @@index([tenantId, status])
  @@index([tenantId, ticketType])
}

model ItTicketComment {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    ItServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  body      String
  createdAt DateTime        @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// PRD_Mobile_Offline_Platform — Phase 1 "Responsive foundation" only (§51):
// device registration + online-only responsive access. No offline engine
// (encrypted local DB, workspaces, sync deltas, offline commands, conflict
// resolution — Phase 2+) because that PRD itself assumes a native-mobile-
// first surface (OS keystore, background sync, push tokens) this Next.js web
// app doesn't have; building a fake offline layer would violate more
// invariants (AC-002 "inaccessible after revocation") than it satisfies.
// ---------------------------------------------------------------------------

model RegisteredDevice {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         UserIdentity @relation("RegisteredDeviceUser", fields: [userId], references: [id], onDelete: Cascade)
  platform     String // IOS | ANDROID | WEB
  deviceLabel  String
  status       String       @default("ACTIVE") // ACTIVE | REVOKED
  registeredAt DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  revokedAt    DateTime?

  @@index([tenantId, userId])
}

// ---------------------------------------------------------------------------
// PRD_Client_Supplier_Portals — Phase 1 "Shared foundation" only (§60),
// scoped further: rather than standing up a second external-facing
// authentication system (its own accounts/sessions/MFA — a materially large
// build), this reuses the existing CLIENT/CONTRACTOR UserIdentity login the
// app already has (PRD_10) and adds the registry layer a real portal needs
// on top of it — which external organization a person belongs to, and which
// projects that organization is explicitly granted. No e-signature, payment
// gateway, or external IdP (PRD's own "self-contained initial release").
// ---------------------------------------------------------------------------

model ExternalOrganization {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  orgType          String // CLIENT | SUPPLIER
  linkedClientId   String? // soft reference to an existing Client record
  linkedSupplierId String? // soft reference to an existing Supplier record
  status           String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdById      String
  createdAt        DateTime @default(now())

  memberships  PortalMembership[]
  accessGrants BusinessAccessRelationship[]

  @@index([tenantId, orgType])
}

model PortalMembership {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalOrgId String
  externalOrg   ExternalOrganization @relation(fields: [externalOrgId], references: [id], onDelete: Cascade)
  userId        String
  user          UserIdentity         @relation("PortalMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  portalRole    String               @default("MEMBER") // ADMIN | MEMBER | VIEWER — org-internal role, distinct from platform Role
  status        String               @default("ACTIVE") // ACTIVE | REMOVED
  addedById     String
  addedAt       DateTime             @default(now())

  @@unique([externalOrgId, userId])
}

model BusinessAccessRelationship {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalOrgId String
  externalOrg   ExternalOrganization @relation(fields: [externalOrgId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedById   String
  grantedAt     DateTime             @default(now())
  revokedAt     DateTime?

  @@unique([externalOrgId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_HR_Payroll_Workforce — Recruitment, the remaining slice of that PRD's
// own Phase-1 "HR foundation" (§ delivery phase 1 lists "employees, org,
// contracts, recruitment, onboarding"; EmploymentRelationship shipped
// 2026-08-06, this closes the recruitment half). Scoped to the pipeline
// itself — Vacancy -> Candidate -> Offer, immutable stage history. No
// onboarding checklist/plan (a later phase-1 sub-item) and no automatic
// Candidate -> Employee/EmploymentRelationship conversion on hire — HR
// records the hire manually via the existing Employee/EmploymentRelationship
// flow, same "modules stay in control of their own state" boundary the
// Workflow Engine uses (WF-FR-015).
// ---------------------------------------------------------------------------

model Vacancy {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title      String
  department String?
  position   String?
  headcount  Int      @default(1)
  status     String   @default("OPEN") // OPEN | ON_HOLD | FILLED | CANCELLED
  openedById String
  createdAt  DateTime @default(now())

  candidates Candidate[]

  @@index([tenantId, status])
}

model Candidate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vacancyId String
  vacancy   Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fullName  String
  email     String?
  phone     String?
  source    String?
  // APPLIED | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED
  stage     String   @default("APPLIED")
  notes     String?
  addedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageEvents CandidateStageEvent[]
  offers      Offer[]

  @@index([tenantId, vacancyId])
  @@index([tenantId, stage])
}

// Immutable by construction — a stage change always appends an event and
// updates Candidate.stage; history is never edited, matching the same
// discipline as WorkflowDecision/PayrollActivity.
model CandidateStageEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromStage   String?
  toStage     String
  note        String?
  actedById   String
  actedAt     DateTime  @default(now())

  @@index([tenantId, candidateId])
}

model Offer {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position     String
  compensation Float?
  currency     String    @default("EUR")
  status       String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | WITHDRAWN
  extendedById String
  extendedAt   DateTime  @default(now())
  respondedAt  DateTime?

  @@index([tenantId, candidateId])
}

// ---------------------------------------------------------------------------
// PRD_HR_Payroll_Workforce — Attendance & Scheduling, the last remaining
// "Coming Soon" stub in the app. Scoped to the PRD's own Phase-2 "workforce
// ops" list, narrowed the same way Payroll Phase-2 narrowed the calc engine
// and Recruitment narrowed onboarding: schedules + attendance only, no
// Timesheet/TimesheetLine (that ties into project labour cost, which is
// Work Progress's own PRD boundary — building it here would blur the
// "modules stay in control of their own state" line the Workflow Engine and
// Portal Access already draw). AttendanceEvent is an immutable ledger (same
// discipline as Inventory movements / WorkflowDecision) — daily/period
// summaries are derived at read time, not stored, so there is no separate
// AttendanceDay write path to keep in sync.
// ---------------------------------------------------------------------------

model ShiftDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  startTime   String // "HH:MM", local to the tenant — no timezone modeling in Phase 1
  endTime     String
  daysOfWeek  String // comma-separated: "MON,TUE,WED,THU,FRI"
  createdById String
  createdAt   DateTime @default(now())

  assignments ScheduleAssignment[]

  @@index([tenantId])
}

// Effective-dated, same "close current, open new" discipline as
// EmploymentRelationship — assigning a new shift closes the employee's prior
// ACTIVE assignment rather than editing it.
model ScheduleAssignment {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftDefinitionId  String
  shiftDefinition    ShiftDefinition @relation(fields: [shiftDefinitionId], references: [id])
  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  status             String          @default("ACTIVE") // ACTIVE | ENDED
  assignedById       String
  createdAt          DateTime        @default(now())

  @@index([tenantId, employeeId, status])
}

// Immutable by construction — no update/delete action is ever exposed; a
// mistaken clock event is corrected by recording the matching counter-event,
// never by editing history.
model AttendanceEvent {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String // CLOCK_IN | CLOCK_OUT
  occurredAt   DateTime @default(now())
  recordedById String
  createdAt    DateTime @default(now())

  @@index([tenantId, employeeId, occurredAt])
}

// ---------------------------------------------------------------------------
// Tasks — gap-fill (PRD_Tasks_Module's remaining deferred items): watching,
// generic cross-entity links, simple recurrence, and per-user saved views.
// Additive; the existing participant-based visibility model is untouched —
// watching/linking never grants access, same "following never grants record
// access" rule the Notifications PRD states explicitly.
// ---------------------------------------------------------------------------

model TaskWatcher {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([tenantId, userId])
}

model TaskLink {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  entityType   String // PROJECT | CLIENT | CONTRACT | ASSET | TASK | OTHER
  entityId     String
  relationType String? // free text, e.g. "blocks", "relates to"
  createdById  String
  createdAt    DateTime @default(now())

  @@index([tenantId, taskId])
  @@index([tenantId, entityType, entityId])
}

// Simple recurrence: no background scheduler exists in this stack, so the
// next occurrence is generated lazily (checked/advanced when the task list
// loads, or on completion of the previous occurrence) rather than by a real
// cron job — same "no infra that isn't actually here" discipline as
// everywhere else this session.
model TaskRecurrence {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateTaskId      String    @unique
  templateTask        Task      @relation("TaskRecurrenceTemplate", fields: [templateTaskId], references: [id], onDelete: Cascade)
  frequency           String // DAILY | WEEKLY | MONTHLY
  interval            Int       @default(1)
  active              Boolean   @default(true)
  nextRunAt           DateTime
  lastGeneratedAt     DateTime?
  lastGeneratedTaskId String?
  createdById         String
  createdAt           DateTime  @default(now())

  @@index([tenantId, active, nextRunAt])
}

model TaskSavedView {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  layout      String // LIST | BOARD | CALENDAR | TIMELINE
  filtersJson String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([tenantId, userId])
}

// ---------------------------------------------------------------------------
// Notifications / Event Centre — Phase 2 "Personal control" and Phase 3
// "Enterprise comms" from the PRD's own phase plan, on top of the Phase 1
// core (EventCatalogueEntry/NotificationPolicy) already shipped. Phase 4
// "External channels" is represented by NotificationDeliveryLog only — this
// app has no real SMTP/push/SMS provider credentials, so external sends are
// composed and logged as SIMULATED, never actually dispatched; same
// "registry + logged intent, no live external call" boundary already used
// for IT Admin (no SSO) and BIM (no live viewer).
// ---------------------------------------------------------------------------

model NotificationQuietHours {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @unique
  timezone  String   @default("UTC") // IANA name, e.g. "Europe/Tirane" — survives DST, per the PRD
  startTime String   @default("22:00") // HH:MM, local to `timezone`
  endTime   String   @default("07:00")
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model DigestRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String   @unique
  frequency String   @default("OFF") // OFF | DAILY | WEEKLY
  timeOfDay String   @default("08:00")
  updatedAt DateTime @updatedAt
}

model Announcement {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  body          String
  audienceType  String    @default("ALL") // ALL | ROLE | DEPARTMENT
  audienceValue String?
  mandatoryAck  Boolean   @default(false)
  publishedById String
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime?

  acks AnnouncementAck[]

  @@index([tenantId, publishedAt])
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  ackedAt        DateTime     @default(now())

  @@unique([announcementId, userId])
}

// Activation gated by the capability-key registry (capabilities.ts /
// UserCapabilityGrant) — "only configured emergency roles may activate one",
// the same explicit-per-user-grant primitive built for exactly this kind of
// case.
model EmergencyAlert {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  body          String
  activatedById String
  activatedAt   DateTime  @default(now())
  resolvedById  String?
  resolvedAt    DateTime?

  @@index([tenantId, resolvedAt])
}

model NotificationDeliveryLog {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipientUserId String
  channel         String // EMAIL | PUSH | SMS
  status          String   @default("SIMULATED") // SIMULATED — no real provider is wired up; see server note
  subject         String?
  redactedPreview String? // the minimized/safe external-channel text, never the raw sensitive body
  createdAt       DateTime @default(now())

  @@index([tenantId, recipientUserId])
}

// ---------------------------------------------------------------------------
// Reporting & Analytics — Phase 2/3 slice: issued/immutable report snapshots
// (freezing a ReportExecution's result on demand, opt-in — the live-query
// default from Phase 1 is untouched for every execution that doesn't issue)
// and a manually-maintained currency rate table for consolidated totals.
// Forecasting is a simple linear run-rate projection computed in
// server/analytics.ts, not a new stored entity.
// ---------------------------------------------------------------------------

model CurrencyRate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency String
  toCurrency   String
  rate         Float
  asOf         DateTime @default(now())
  setById      String

  @@index([tenantId, fromCurrency, toCurrency])
}

// ---------------------------------------------------------------------------
// PRD_Platform_UI_UX_Architecture §18 Universal Draft Mode. Scoped to the
// underlying primitive only — one draft slot per (user, form), never
// touching business state (creating one never reserves a code/number,
// notifies anyone, or changes any other record). Piloted on exactly one
// existing form (Create Client) rather than retrofitting every save path in
// the app at once — mass-migrating dozens of already-stable forms' save
// behavior in one pass is a materially different (and much riskier) change
// than adding a new, isolated, opt-in surface.
// ---------------------------------------------------------------------------

model RecordDraft {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  // Stable key per form, e.g. "client.create" — not per-record, since a
  // draft by definition doesn't have a record yet.
  formKey   String
  payload   String // JSON — the form's field values, verbatim
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, formKey])
}
