  workPackage        WorkPackage?        @relation(fields: [workPackageId], references: [id])
  progressUpdateId   String?
  progressUpdate     WorkProgressUpdate? @relation(fields: [progressUpdateId], references: [id])
  type               String              @default("PHOTO")
  title              String
