}

model WorkProgressActivity {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String?
  entityType     String
  entityId       String
  eventType      String
  summary        String
  actorId        String
  previousStatus String?
  nextStatus     String?
  correlationId  String
  createdAt      DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

// ---------------------------------------------------------------------------
// PRD_1 additional master entities — Card-page entities per PRD_2 §4.3's
// required catalog (Company/Project/Employee/Contractor/Contract/Drawing
// already exist above; this section adds the remaining ones).
// ---------------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  // --- PRD_Teams_Module (additive) ---------------------------------------
  // §5 — a free string, not an enum: "Team types are configurable and must
  // not be hard-coded." TEAM_TYPE_SUGGESTIONS in teams-module.ts seeds the
  // picker with the PRD's starter list; admins may enter any custom value.
  teamType   String?
  leadId     String?
  lead       UserIdentity? @relation("TeamLead", fields: [leadId], references: [id])
  archivedAt DateTime?

  members TeamMember[]
}

model TeamMember {
  id        String       @id @default(cuid())
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  // §6 — describes responsibility *within the team*; explicitly does not
  // replace or alter the user's employment position (Team Roles ≠ job title).
  role String @default("MEMBER") // LEADER | DEPUTY_LEADER | COORDINATOR | REVIEWER | CONTRIBUTOR | SPECIALIST | EXTERNAL_MEMBER | OBSERVER | MEMBER | <custom>

  @@unique([teamId, userId])
}

// Sales-owned client relationship record — deliberately separate from
// Contractor (a different resource, "CLIENTS" vs "COMPANY_NETWORK", so a
// role can be granted one without the other; Sales has CLIENTS but not
// COMPANY_NETWORK, matching that clients and contractors are unrelated
// counterparties from the company's side of the table).
model Client {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  email       String?
  phone       String?
  status      String       @default("ACTIVE") // ACTIVE | PROSPECT | INACTIVE
  createdById String
  createdBy   UserIdentity @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  projects  Project[]
  documents DocumentFile[]
  tasks     Task[]

  // --- PRD_CRM_Module (additive) ------------------------------------------
  // §7 — configurable, not an enum, same pattern as Team Type.
  clientType             String?
  // §11 Client Page Header "Assigned salesperson" / §14 "account owner".
  ownerId                String?
  owner                  UserIdentity? @relation("ClientOwner", fields: [ownerId], references: [id])
  // §18 — how this client first reached the company; configurable string.
  source                 String?
  country                String?
  preferredContactMethod String?
  archivedAt             DateTime?

  contacts          Contact[]
  notes             ClientNote[]
  opportunities     Opportunity[]
  leads             Lead[]
  stars             ClientStar[]
  unitRelationships ClientUnitRelationship[]
  communications    CrmCommunication[]
  supportCases      SupportCase[]
  activityEvents    CrmActivityEvent[]
  clientRequests    ClientRequest[]

  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// PRD_CRM_Module — additive layer. §46 Data Ownership Rules: CRM owns
// clients, contacts, leads, opportunities, pipelines and notes; it never
// owns units/contracts/finance/documents/tasks, all of which stay
// source-linked (projectId/contractId-style FKs) rather than duplicated.
// Phase-1 scope: Contacts, Notes, Leads and a configurable Sales Pipeline —
// Reservation/ClientPurchase/Communication/SupportCase/Referral/CRMActivity
// are deferred (they read from Units/Contracts/Finance, which aren't wired
// for that yet).
// ---------------------------------------------------------------------------

// §15/§16 — a person tied to a client (an individual client may itself act
// as its own primary contact; a company client typically has several).
model Contact {
  id                     String        @id @default(cuid())
  tenantId               String
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId               String
  client                 Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                   String
  title                  String?
  department             String?
  email                  String?
  phone                  String?
  preferredContactMethod String?
  // §16 — configurable, not an enum (Decision Maker | Legal Representative |
  // Finance Contact | Technical Contact | Sales Contact | Executive Sponsor |
  // Assistant | Family Member | Advisor | custom).
  role                   String?
  decisionInfluence      String?
  status                 String        @default("ACTIVE")
  notes                  String?
  relationshipOwnerId    String?
  relationshipOwner      UserIdentity? @relation("ContactOwner", fields: [relationshipOwnerId], references: [id])
  createdAt              DateTime      @default(now())

  opportunities  Opportunity[]
  communications CrmCommunication[]

  @@index([tenantId, clientId])
}

// §32 — an internal note, distinct from a Communication log (deferred).
model ClientNote {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    UserIdentity @relation("ClientNoteAuthor", fields: [authorId], references: [id])
  body      String
  pinned    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId])
}

// §21 — "Pipeline stages are managed through Platform Configuration" in the
// full PRD; Phase-1 keeps them as tenant-editable rows rather than wiring
// the Platform Configuration node tree for per-stage config.
model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  stages        PipelineStage[]
  opportunities Opportunity[]
}

// §22 — the default example (Lead, Contacted, Qualified, Meeting, Site
// Visit, Negotiation, Reservation, Contract, Deposit Paid, Completed, After
// Sales) is seeded by ensureDefaultPipeline(), not hard-coded here.
model PipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  orderNo     Int
  probability Int      @default(0)
  status      String   @default("ACTIVE")

  opportunities Opportunity[]

  @@unique([pipelineId, orderNo])
}

// §20 — a qualified deal in progress, tied to a Client (and optionally a
// Project/Unit of interest via a source-linked id, no duplication of Units
// module data).
model Opportunity {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?      @relation(fields: [contactId], references: [id])
  // Deliberately a bare id, no Prisma relation() — Projects is frozen and
  // must not gain a back-relation field. Same "source-linked, not owned"
  // pattern as DocumentLink/TaskLink's generic entityId references.
  projectId       String?
  title           String
  estimatedValue  Float?
  expectedCloseAt DateTime?
  ownerId         String?
  owner           UserIdentity? @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipelineId      String
  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId         String
  stage           PipelineStage @relation(fields: [stageId], references: [id])
  // §21 — separate from pipeline stage: a deal can only be OPEN, WON or LOST.
  status          String        @default("OPEN") // OPEN | WON | LOST
  lostReason      String?
  stageEnteredAt  DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, clientId])
}

// §17/§18/§19 — pre-qualification: may exist before a full Client record
// does. "Convert" creates/links a Client and an Opportunity (teams-module.ts
// style additive service, see convertLead()).
model Lead {
  id                     String        @id @default(cuid())
  tenantId               String
  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title                  String
  clientId               String?
  client                 Client?       @relation(fields: [clientId], references: [id])
  personName             String?
  personEmail            String?
  personPhone            String?
  // §18 — configurable, not an enum.
  source                 String?
  campaign               String?
  ownerId                String?
  owner                  UserIdentity? @relation("LeadOwner", fields: [ownerId], references: [id])
  interest               String?
  estimatedValue         Float?
  // NEW | CONTACTED | QUALIFIED | DISQUALIFIED | CONVERTED | LOST
  status                 String        @default("NEW")
  priority               String        @default("NORMAL") // LOW | NORMAL | HIGH
  nextActionAt           DateTime?
  qualificationScore     Int?
  qualificationNotes     String?
  lostReason             String?
  convertedOpportunityId String?       @unique
  createdAt              DateTime      @default(now())

  @@index([tenantId, status])
}

// §9 — Personal Star, same private/per-user pattern as Documents/Tasks.
model ClientStar {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation("ClientStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([clientId, userId])
  @@index([tenantId, userId])
}

// PRD_Sales_Dashboard §12/§13 — the Reservations and Sales & Units widgets
// need one real client-unit relationship record; this is the "Reservation/
// ClientPurchase" deferred slice the CRM module's Phase-1 comment above
// flagged. One row per relationship stage (a client can be INTERESTED then
// later RESERVED then PURCHASED — each transition is a new row, not an
// overwrite, so the Sales & Units widget can count each stage historically).
// Reservation-specific fields are populated only when type is RESERVED;
// sale fields only when PURCHASED/RENTED. Unit availability/pricing truth
// stays owned by Unit — this never becomes a second source of it.
model ClientUnitRelationship {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  type              String // INTERESTED | VIEWED | RESERVED | PURCHASED | RENTED | RELEASED
  // Populated for RESERVED rows.
  reservationDate   DateTime?
  expirationDate    DateTime?
  depositAmount     Float?
  depositStatus     String? // UNPAID | PARTIAL | PAID | REFUNDED
  reservationStatus String? // ACTIVE | EXPIRED | CONVERTED | RELEASED
  // Populated for PURCHASED/RENTED rows.
  askingPrice       Float?
  discount          Float?
  finalPrice        Float?
  saleDate          DateTime?

  salespersonId String?
  salesperson   UserIdentity? @relation("ClientUnitRelationshipSalesperson", fields: [salespersonId], references: [id])
  createdById   String
  createdBy     UserIdentity  @relation("ClientUnitRelationshipCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId, clientId])
  @@index([tenantId, unitId])
  @@index([tenantId, type])
}

// PRD_Sales_Dashboard §17 — CRM communication log (Work > Communications
// sidebar item). Distinct from ClientNote (an internal note); this records
// an actual contact touchpoint with the client.
model CrmCommunication {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  channel    String // CALL | EMAIL | WHATSAPP | SMS | MEETING | IN_PERSON | OTHER
  direction  String   @default("OUTBOUND") // INBOUND | OUTBOUND
  subject    String?
  notes      String
  occurredAt DateTime @default(now())

  loggedById String
  loggedBy   UserIdentity @relation("CrmCommunicationLoggedBy", fields: [loggedById], references: [id])
  createdAt  DateTime     @default(now())

  @@index([tenantId, clientId])
}

// PRD_Sales_Dashboard §6 — After Sales > Support sidebar item.
model SupportCase {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  subject     String
  description String?
  priority    String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status      String  @default("OPEN") // OPEN | IN_PROGRESS | WAITING_ON_CLIENT | RESOLVED | CLOSED

  assignedToId String?
  assignedTo   UserIdentity? @relation("SupportCaseAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    UserIdentity  @relation("SupportCaseCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@index([tenantId, clientId])
  @@index([tenantId, status])
}

// PRD_Sales_Dashboard §17 — Recent Activity widget. Per-module activity
// table, same pattern as UnitActivityEvent/ContractActivity rather than the
// DomainEvent outbox (which is reserved for cross-module reactions like
// ContractApproved -> Finance Structure; this feed has no reactions, it's
// pure read history).
model CrmActivityEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // LEAD_CREATED | CONTACT_ADDED | MEETING_SCHEDULED | SITE_VISIT |
  // OPPORTUNITY_CREATED | OPPORTUNITY_STAGE_CHANGED | OPPORTUNITY_WON |
  // OPPORTUNITY_LOST | RESERVATION_CREATED | CONTRACT_LINKED |
  // PAYMENT_RECORDED | UNIT_SALE | DOCUMENT_UPLOADED | APPROVAL |
  // SUPPORT_CASE_OPENED | CLIENT_STATUS_CHANGED | COMMUNICATION_LOGGED
  eventType  String
  summary    String
  entityType String? // LEAD | OPPORTUNITY | UNIT | CONTRACT | SUPPORT_CASE | ...
  entityId   String?

  actorId   String
  actor     UserIdentity @relation("CrmActivityEventActor", fields: [actorId], references: [id])
  createdAt DateTime     @default(now())

  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
}

model Contractor {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String // Number Series: CTR-{SEQ6}
  name        String
  tradeType   String
  email       String?
  phone       String?
  // Local business identifiers — NIPT is Albania's tax identification number.
  taxId       String?
  bankAccount String?
  status      String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  riskRating  String   @default("LOW") // LOW | MEDIUM | HIGH
  createdAt   DateTime @default(now())

  // PRD_4 §10/§14 — an optional portal login for this contractor, restricted
  // to their own TaskContractorAssignments (CTO-100 task-scoped access).
  // Most contractor profiles have no login at all; this is opt-in per contractor.
  userId String?       @unique
  user   UserIdentity? @relation("ContractorLogin", fields: [userId], references: [id])

  contracts    Contract[]
  assignments  TaskContractorAssignment[]
  workPackages ProjectWorkPackage[]

  @@index([tenantId, status])
}

model Contract {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id])
  contractorId String?
  contractor   Contractor? @relation(fields: [contractorId], references: [id])
  number       String // Number Series: CON-{YYYY}-{SEQ5}
  title        String
  value        Float
  currency     String      @default("EUR")
  // Controlled lifecycle (Audit 2 §7) — the only writer of this field is
  // src/server/contract-lifecycle.ts's transition guard, not ad-hoc updates.
  // DRAFT -> ACTIVE (approveContract) -> COMPLETED (auto, once posted
  // PAYMENT invoices reach the contract value) | TERMINATED.
  status       String      @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | TERMINATED
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime    @default(now())

  taskLinks       TaskContractLink[]
  taskAssignments TaskContractorAssignment[]
  invoices        Invoice[]

  // --- PRD_Contracts_Module (additive) ------------------------------------
  // §11 — configurable, not an enum, same pattern as Team/Client Type.
  contractType      String?
  // §9 Contract Header "Responsible user" — distinct from the party-level
  // responsibility captured on ContractObligation.
  responsibleUserId String?
  responsibleUser   UserIdentity? @relation("ContractResponsible", fields: [responsibleUserId], references: [id])
  archivedAt        DateTime?

  parties     ContractParty[]
  obligations ContractObligation[]
  milestones  ContractMilestone[]
  activity    ContractActivity[]
  stars       ContractStar[]

  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_Contracts_Module — additive layer. §49 Data Ownership Rules: Contracts
// owns legal terms, party roles, obligations, milestones, deliverables,
// amendments, renewals, terminations, claims and template structure; Finance
// owns invoices/payments (Invoice already exists and links here); Documents
// owns files (reused via the existing DocumentLink entityType="CONTRACT",
// no new model); Companies/CRM own canonical party records (referenced here
// by bare id, not FK, same "source-linked not owned" pattern as
// DocumentLink/TaskLink/Opportunity.projectId).
//
// Phase-1 scope: multi-party support (today's Contract has a single
// contractorId FK), Obligations, Milestones and an Activity timeline. The
// contract lifecycle status machine (src/server/contract-lifecycle.ts, the
// Audit 2 reference workflow) is NOT touched — Clause library, Payment
// Schedule, Approval/Signature tracking, Amendments/Renewals/Terminations,
// Claims, Guarantees, Compliance and Templates are deferred.
// ---------------------------------------------------------------------------

// §14/§15 — "Company or individual"; party_entity_type is deliberately a
// bare reference (COMPANY | CLIENT | CONTACT | CONTRACTOR | EMPLOYEE), not a
// Prisma relation, so this never has to be re-pointed as canonical party
// records move between modules.
model ContractParty {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId         String
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyEntityType    String? // COMPANY | CLIENT | CONTACT | CONTRACTOR | EMPLOYEE | EXTERNAL
  partyEntityId      String?
  // §15 — configurable, not an enum (Client/Buyer/Seller/Employer/
  // Contractor/Subcontractor/Supplier/Consultant/Tenant/Landlord/Lender/
  // Borrower/Insurer/Beneficiary/Guarantor/custom).
  role               String
  legalName          String
  representativeName String?
  email              String?
  phone              String?
  signingAuthority   Boolean  @default(false)
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())

  obligations ContractObligation[]
  milestones  ContractMilestone[]

  @@index([tenantId, contractId])
}

// §20 — attributable to a party, auditable.
model ContractObligation {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId       String
  contract         Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  partyId          String?
  party            ContractParty? @relation(fields: [partyId], references: [id])
  title            String
  description      String?
  ownerId          String?
  owner            UserIdentity?  @relation("ContractObligationOwner", fields: [ownerId], references: [id])
  dueAt            DateTime?
  priority         String         @default("NORMAL") // LOW | NORMAL | HIGH
  status           String         @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | OVERDUE | WAIVED
  evidenceRequired Boolean        @default(false)
  completedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, contractId])
}

// §21 — planned vs actual date, optional payment trigger.
model ContractMilestone {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  plannedAt      DateTime?
  actualAt       DateTime?
  partyId        String?
  party          ContractParty? @relation(fields: [partyId], references: [id])
  paymentTrigger Boolean        @default(false)
  status         String         @default("PENDING") // PENDING | DUE | COMPLETED | DELAYED
  createdAt      DateTime       @default(now())

  @@index([tenantId, contractId])
}

// §39 Activity Timeline.
model ContractActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      UserIdentity? @relation("ContractActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, contractId])
}

// §7 Personal Star — same private/per-user pattern as Documents/Tasks/CRM.
model ContractStar {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId     String
  user       UserIdentity @relation("ContractStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([contractId, userId])
  @@index([tenantId, userId])
}

model DocumentFile {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?         @relation(fields: [projectId], references: [id])
  taskId            String?
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Employee Profile — CV/certification/work-contract attachments. Reuses
  // this same document model rather than a parallel one (matches every other
  // "attach a file" feature in the app), with `visibility` gating who besides
  // the uploader can see it: COMPANY (default, the profile directory) or
  // PRIVATE_HR (work contracts — only the employee themselves and HR).
  employeeId        String?
  employee          Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // PRD_Rework_1 — an existing project document picked as an Approval's
  // attachment, rather than a separate upload path/blob table.
  projectApprovalId String?
  projectApproval   ProjectApproval? @relation(fields: [projectApprovalId], references: [id])
  // PRD_Units / PRD_Unit_Page — a unit's floor plan, technical drawings and
  // other attachments, same optional-FK pattern as every other polymorphic
  // owner on this model.
  unitId            String?
  unit              Unit?            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  visibility        String           @default("COMPANY")
  name              String
  category          String           @default("General")
  // PRD_4 §8.2 categories (INITIAL_EVIDENCE | TECHNICAL_ASSESSMENT | DRAWING |
  // CALCULATION | SPECIFICATION | QUOTATION | PURCHASE_ORDER | CONTRACT |
  // CONTRACT_VARIATION | METHOD_STATEMENT | SAFETY_DOCUMENT | INSPECTION |
  // COMPLETION_EVIDENCE | INVOICE | PAYMENT_EVIDENCE | FINAL_RECORD) apply when
  // taskId is set; pre-existing free-text categories are unaffected otherwise.
  version           Int              @default(1)
  status            String           @default("DRAFT")
  // DRAFT | SUBMITTED | APPROVED (pre-existing) plus PRD_4 §8.3's fuller set when
  // task-attached: SUPPORTING | UNDER_REVIEW | REJECTED | SUPERSEDED | OFFICIAL | ARCHIVED
  uploadedById      String
  uploadedBy        UserIdentity     @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime         @default(now())

  // CTO-060 — an approved/official file is never overwritten; a changed
  // upload creates a new revision linked to the one it supersedes.
  supersedesId     String?       @unique
  supersedes       DocumentFile? @relation("DocumentRevision", fields: [supersedesId], references: [id])
  supersededBy     DocumentFile? @relation("DocumentRevision")
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       UserIdentity? @relation("DocumentApprover", fields: [approvedById], references: [id])
  taskStageId      String?
  taskDepartmentId String?

  // PRD_18 §12 Document Passport — the actual file. Nullable so the two
  // placeholder-document call sites (project/task creation "expected
  // document" checklist entries, no upload yet) keep working unmodified.
  fileData         Bytes?
  fileMimeType     String?
  fileSize         Int?
  checksum         String? // SHA-256 hex of fileData
  // Mandatory (enforced at the action layer) when supersedesId is set —
  // "what changed and why" per §13's revision-submission rule.
  revisionComment  String?
  // JSON ActorSnapshot (src/lib/actor-snapshot.ts) frozen at upload time —
  // survives the uploader's later role/company changes, per §12 "Immutable
  // origin".
  uploaderSnapshot String?

  approvals DocumentApproval[]

  // PRD_Documents_Module — when set, this row is one immutable revision of a
  // Document (the Passport record). Optional so every pre-existing call site
  // that treats DocumentFile as a standalone attachment keeps working.
  documentId   String?
  document     Document? @relation("DocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  // §15 — revision code/number, unique within one Document.
  revisionCode String?
  currentOf    Document? @relation("DocumentCurrentRevision")

  @@index([tenantId, projectId])
  @@index([tenantId, taskId])
  @@index([tenantId, clientId])
  @@index([tenantId, unitId])
  @@index([tenantId, documentId])
}

// PRD_18 §13 Blue Approval Ticket — an append-only decision ledger bound to
// one exact DocumentFile revision (not a mutable "approved" flag), so a
// REQUEST_CHANGES round can precede the eventual APPROVE without losing
// either decision's history.
model DocumentApproval {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentFileId   String
  documentFile     DocumentFile @relation(fields: [documentFileId], references: [id], onDelete: Cascade)
  approverId       String
  approver         UserIdentity @relation(fields: [approverId], references: [id])
  // JSON ActorSnapshot at decision time.
  approverSnapshot String
  decision         String // APPROVE | REQUEST_CHANGES | REJECT
  comment          String?
  createdAt        DateTime     @default(now())

  @@index([tenantId, documentFileId])
}

