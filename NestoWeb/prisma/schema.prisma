// Nesto — Phase 0/1 data model.
//
// Datasource was SQLite for zero-dependency local development. Deployed to
// Vercel + Neon Postgres on 2026-08-07; every tenant-owned model carries a
// `tenantId` column so the switch was a config change, not a schema rewrite.
// Status/role fields remain plain strings (validated at the app layer via
// lib/constants.ts) rather than Prisma enums — kept as-is post-migration
// since both DBs support the convention unmodified.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

