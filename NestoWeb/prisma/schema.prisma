// ---------------------------------------------------------------------------
// PRD_Units / PRD_Unit_Page — Real Estate Inventory (Pass 1)
// ---------------------------------------------------------------------------
// Pass 1 covers the inventory grid + a basic single-unit workspace (overview,
// component-based pricing, documents/renders, a thin activity log). The full
// sales workflow (holds, reservations, payments, linked packages, client
// changes, handover, split/merge) is Pass 2 — deliberately not modeled yet.

model ProjectStructure {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      String   @default("BUILDING") // BUILDING | BLOCK | TOWER | PHASE | ZONE
  order     Int      @default(0)
  createdAt DateTime @default(now())

  floors ProjectFloor[]
  units  Unit[]

  @@unique([projectId, name])
  @@index([tenantId, projectId])
}

model ProjectFloor {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structureId String
  structure   ProjectStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  label       String // "Ground Floor", "Level 3"
  level       Int // signed, for sorting — basements negative
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  units Unit[]

  @@unique([structureId, label])
  @@index([tenantId, structureId])
}

model Unit {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  structureId String?
  structure   ProjectStructure? @relation(fields: [structureId], references: [id])
  floorId     String?
  floor       ProjectFloor?     @relation(fields: [floorId], references: [id])

  code        String
  type        String // APARTMENT | VILLA | OFFICE | PARKING | RETAIL | STORAGE | HOTEL_ROOM | LAND_PLOT | CUSTOM
  displayName String?

  orientation String?
  view        String?
  features    String?
  notes       String?

  // Physical build progress — distinct from lifecycleStatus (the sales state machine).
  constructionStatus String? // PLANNED | UNDER_CONSTRUCTION | COMPLETED
  lifecycleStatus    String  @default("DRAFT")

  currency        String  @default("EUR")
  fixedAdjustment Float   @default(0)
  // JSON string of type-specific field values, keyed by the hardcoded per-type
  // schema in lib/constants.ts (UNIT_TYPE_FIELDS) — matches DomainEvent.payload's
  // existing String-for-JSON convention rather than introducing the Json scalar.
  typeFields      String?

  pinnedRenderId String?     @unique
  pinnedRender   UnitRender? @relation("UnitPinnedRender", fields: [pinnedRenderId], references: [id], onDelete: SetNull)

  // Optimistic concurrency — compare-and-swap on every update.
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  areaComponents      UnitAreaComponent[]
  renders             UnitRender[]             @relation("UnitRenderGallery")
  documentFiles       DocumentFile[]
  activityEvents      UnitActivityEvent[]
  clientRelationships ClientUnitRelationship[]

  @@unique([projectId, code])
  @@index([tenantId, projectId])
  @@index([tenantId, structureId])
  @@index([tenantId, floorId])
  @@index([tenantId, lifecycleStatus])
}

model UnitAreaComponent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  componentType   String // INTERNAL | BALCONY | TERRACE | GARDEN | STORAGE | CUSTOM
  label           String
  areaM2          Float
  pricePerM2      Float
  // Exactly one true per unit — an application-layer invariant (Prisma/SQLite
  // can't express "exactly one" declaratively), enforced transactionally
  // whenever a unit's component set is written. Main must always have
  // includedInTotal true, or a "final total" edit becomes a silent no-op.
  isMain          Boolean @default(false)
  includedInTotal Boolean @default(true)
  order           Int     @default(0)

  // subtotal is NEVER stored — always areaM2 * pricePerM2, computed at read
  // time. No staleness risk, matches PRD_Unit_Page §6's "not a separate
  // source of truth" language for derived pricing values.

  @@index([tenantId, unitId])
}

model UnitRender {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit         @relation("UnitRenderGallery", fields: [unitId], references: [id], onDelete: Cascade)
  fileData     Bytes
  fileMimeType String
  fileSize     Int
  checksum     String
  uploadedById String
  uploadedBy   UserIdentity @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  pinnedByUnit Unit? @relation("UnitPinnedRender")

  @@index([tenantId, unitId])
}

model UnitActivityEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId   String
  unit     Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // Pass 1 subset: UNIT_CREATED | UNIT_UPDATED | STATUS_CHANGED | ARCHIVED |
  // RESTORED. Pass 2 adds sales/payment/handover/split/merge event types.
  eventType String
  actorId   String
  actor     UserIdentity @relation(fields: [actorId], references: [id])
  summary   String
  metadata  String?
  createdAt DateTime     @default(now())

  @@index([tenantId, unitId])
}

model Task {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code              String
  title             String
  description       String?
  visibility        String        @default("COMPANY_PUBLIC") // PRIVATE | DEPARTMENT_PUBLIC | COMPANY_PUBLIC
  status            String        @default("TO_DO") // TO_DO | IN_PROGRESS | REVIEW | APPROVED | COMPLETED | BLOCKED | ON_HOLD | NEEDS_REVISION | REJECTED | OVERDUE
  priority          String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  dueDate           DateTime?
  createdById       String
  createdBy         UserIdentity  @relation("TaskCreator", fields: [createdById], references: [id])
  mainResponsibleId String?
  mainResponsible   UserIdentity? @relation("TaskResponsible", fields: [mainResponsibleId], references: [id])
  // PRD_3 — set when this task was generated from a client comment @mention.
  // Permanent two-way link: the comment is never deleted/rewritten when the
  // task changes, and vice versa (CCT-003, CCT-044).
  sourceCommentId   String?       @unique
  sourceComment     Comment?      @relation("TaskSourceComment", fields: [sourceCommentId], references: [id])
  // Accountable "department" for a department-only or department+individual
  // mention, using the same Role vocabulary the rest of the app already
  // treats as departments (ARCHITECT, LEGAL, FINANCE, ...) rather than
  // introducing a separate Department entity.
  departmentRole    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // --- PRD_4 Cross-Department Task Orchestration -----------------------
  // A task becomes "orchestrated" the moment it has stages attached
  // (task-orchestration.ts's startOrchestration()) — plain tasks (simple
  // checklist items, PRD_3 client-comment tasks) are unaffected and never
  // touch these fields. `status` above keeps its existing TO_DO/IN_PROGRESS/…
  // vocabulary for plain tasks; `orchestrationStatus` is a parallel field
  // using PRD_4 §6.3's richer parent-status vocabulary once orchestration
  // starts, so the two systems never collide on one column's meaning.
  orchestrationStatus  String? // DRAFT | SUBMITTED | UNDER_TRIAGE | ACTIVE | WAITING_FOR_INFORMATION |
  // WAITING_FOR_APPROVAL | WAITING_FOR_CONTRACT | WAITING_FOR_PROCUREMENT |
  // WAITING_FOR_CONTRACTOR | SCHEDULED | IN_EXECUTION | WAITING_FOR_INSPECTION |
  // UNDER_FINAL_VERIFICATION | COMPLETED | REJECTED | CANCELLED | REOPENED | ARCHIVED
  category             String? // free classification, e.g. "Facade Repair", "MEP Fault"
  severity             String? // LOW | MEDIUM | HIGH | CRITICAL — distinct from `priority` (2.1 Classification)
  riskLevel            String? // LOW | MEDIUM | HIGH
  locationDetail       String? // e.g. "Block A / East Facade / Levels 3-5" — free text; no Building/Unit model exists yet
  startDate            DateTime?
  forecastDate         DateTime?
  actualCompletionDate DateTime?
  taskManagerId        String?
  taskManager          UserIdentity? @relation("TaskManager", fields: [taskManagerId], references: [id])
  decisionOwnerId      String?
  decisionOwner        UserIdentity? @relation("TaskDecisionOwner", fields: [decisionOwnerId], references: [id])
  finalApproverId      String?
  finalApprover        UserIdentity? @relation("TaskFinalApprover", fields: [finalApproverId], references: [id])
  currentStageId       String?
  currentStage         TaskStage?    @relation("TaskCurrentStage", fields: [currentStageId], references: [id])

  contributions  TaskContribution[]
  dependsOn      TaskDependency[]    @relation("DependentTask")
  dependedOnBy   TaskDependency[]    @relation("DependsOnTask")
  documents      DocumentFile[]
  stars          TaskStar[]
  checklistItems TaskChecklistItem[]
  watchers       TaskWatcher[]
  links          TaskLink[]
  recurrence     TaskRecurrence?     @relation("TaskRecurrenceTemplate")

  stages                TaskStage[]                    @relation("TaskStages")
  departments           TaskDepartment[]
  participants          TaskParticipant[]
  events                TaskEvent[]
  approvals             TaskApproval[]
  involvementRequests   DepartmentInvolvementRequest[]
  escalations           TaskEscalation[]
  delayExplanations     TaskDelayExplanation[]
  contractLinks         TaskContractLink[]
  contractorAssignments TaskContractorAssignment[]
  inspections           TaskInspection[]
  completionRecords     TaskCompletionRecord[]
  reopeningRecords      TaskReopeningRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, projectId])
  @@index([tenantId, dueDate])
  @@index([mainResponsibleId])
}

// ---------------------------------------------------------------------------
// PRD_4 — Cross-Department Task Orchestration. Additive: governs a task's
// life *after* creation (assignment, department involvement, approvals,
// contracts, contractor execution, inspection, closure) without altering the
// plain-task rules PRD_1/PRD_3 already established. See Task.orchestrationStatus
// for how the two systems coexist on one Task row.
// ---------------------------------------------------------------------------

// One reusable reference workflow ships built-in (§6.2's reference flow,
// also §15's facade-repair walkthrough) rather than a full visual workflow-
// template builder — that configurable builder is Appendix A's P2-Advanced
// scope, explicitly out of this pass.
model TaskStage {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation("TaskStages", fields: [taskId], references: [id], onDelete: Cascade)
  key         String // stable machine key, e.g. "PM_TRIAGE", "ENGINEERING_ASSESSMENT"
  label       String
  sequence    Int
  isParallel  Boolean       @default(false)
  status      String        @default("PENDING") // PENDING | ACTIVE | WAITING | COMPLETED | SKIPPED | REJECTED
  skipReason  String?
  skippedById String?
  skippedBy   UserIdentity? @relation("StageSkippedBy", fields: [skippedById], references: [id])
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  currentForTask Task[] @relation("TaskCurrentStage")

  @@unique([taskId, key])
}

// CTO-003/CTO-011 — adding a department creates one accountable owner, not
// just a watcher.
model TaskDepartment {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  department      String // Role vocabulary (ENGINEER, ARCHITECT, PROCUREMENT, LEGAL, FINANCE, QAQC, HSE, PM, ...)
  ownerId         String
  owner           UserIdentity @relation("TaskDepartmentOwner", fields: [ownerId], references: [id])
  isMandatory     Boolean      @default(true)
  activatedReason String? // manual request reason, or the auto-routing rule name that activated it
  createdAt       DateTime     @default(now())

  deliverable DepartmentDeliverable?

  @@unique([taskId, department])
}

model DepartmentDeliverable {
  id                     String                  @id @default(cuid())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskDepartmentId       String                  @unique
  taskDepartment         TaskDepartment          @relation(fields: [taskDepartmentId], references: [id], onDelete: Cascade)
  requiredAction         String
  expectedOutput         String?
  deadline               DateTime?
  status                 String                  @default("NOT_STARTED")
  // NOT_STARTED | WAITING_FOR_DEPENDENCY | ACTIVE | INFORMATION_REQUESTED | SUBMITTED | UNDER_REVIEW |
  // APPROVED | REJECTED | REVISION_REQUIRED | NOT_REQUIRED | BLOCKED | COMPLETED
  requiresApproval       Boolean                 @default(true)
  notRequiredReason      String?
  submittedAt            DateTime?
  approvedAt             DateTime?
  blockedByDeliverableId String?
  blockedByDeliverable   DepartmentDeliverable?  @relation("DeliverableDependency", fields: [blockedByDeliverableId], references: [id])
  blocksDeliverables     DepartmentDeliverable[] @relation("DeliverableDependency")
  createdAt              DateTime                @default(now())

  approvals         TaskApproval[]
  delayExplanations TaskDelayExplanation[]
}

// Many-to-many contributors/reviewers/watchers. The single-owner roles
// (Task Manager, Decision Owner, Final Approver, Department Owner) are FKs
// above/on TaskDepartment per CTO-010/CTO-011 — exactly one accountable
// person, not a set.
model TaskParticipant {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     UserIdentity @relation("TaskParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  role     String // CONTRIBUTOR | REVIEWER | WATCHER
  addedAt  DateTime     @default(now())

  @@unique([taskId, userId, role])
}

// CTO-002/CTO-006/CTO-050 — append-only immutable timeline. The app layer
// only ever calls create() against this table; there is no update/delete path.
model TaskEvent {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         UserIdentity? @relation("TaskEventActor", fields: [actorId], references: [id])
  actorRole     String?
  eventType     String // TASK_CREATED | ORCHESTRATION_STARTED | STAGE_TRANSITION | DEPARTMENT_ACTIVATED |
  // DELIVERABLE_SUBMITTED | APPROVAL_RECORDED | FILE_UPLOADED | CONTRACT_LINKED |
  // CONTRACTOR_ASSIGNED | CONTRACTOR_ACTION | INSPECTION_RECORDED | DELAY_EXPLAINED |
  // ESCALATED | ESCALATION_ACKNOWLEDGED | TASK_COMPLETED | TASK_REOPENED
  summary       String
  previousState String?
  newState      String?
  metadata      String? // JSON-encoded string
  createdAt     DateTime      @default(now())

  @@index([taskId, createdAt])
}

// CTO-061 — a typed approval action, never a plain comment.
model TaskApproval {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverableId String?
  deliverable   DepartmentDeliverable? @relation(fields: [deliverableId], references: [id])
  approverId    String
  approver      UserIdentity           @relation("TaskApprover", fields: [approverId], references: [id])
  action        String // APPROVE | APPROVE_WITH_CONDITIONS | REJECT | REQUEST_REVISION | REQUEST_INFO | DELEGATE
  comment       String?
  conditions    String? // JSON-encoded array of required condition strings
  conditionsMet Boolean                @default(false)
  delegatedToId String?
  delegatedTo   UserIdentity?          @relation("TaskApprovalDelegate", fields: [delegatedToId], references: [id])
  fileId        String?
  createdAt     DateTime               @default(now())

  @@index([taskId])
  @@index([delegatedToId])
}

model DepartmentInvolvementRequest {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId             String
  task               Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        UserIdentity  @relation("InvolvementRequester", fields: [requestedById], references: [id])
  department         String
  reason             String
  requestedAction    String?
  desiredDeadline    DateTime?
  shouldBlock        Boolean       @default(true)
  status             String        @default("PENDING") // PENDING | ACTION_REQUIRED | COMMENT_ONLY | NOT_REQUIRED | INFO_REQUESTED | REDIRECTED
  response           String?
  redirectDepartment String?
  respondedById      String?
  respondedBy        UserIdentity? @relation("InvolvementResponder", fields: [respondedById], references: [id])
  respondedAt        DateTime?
  createdAt          DateTime      @default(now())
}

model TaskEscalation {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserId     String?
  fromUser       UserIdentity? @relation("EscalationFrom", fields: [fromUserId], references: [id])
  toUserId       String
  toUser         UserIdentity  @relation("EscalationTo", fields: [toUserId], references: [id])
  reason         String
  acknowledgedAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([toUserId])
}

model TaskDelayExplanation {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId             String
  task               Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliverableId      String?
  deliverable        DepartmentDeliverable? @relation(fields: [deliverableId], references: [id])
  cause              String
  progressPct        Int
  newExpectedDate    DateTime
  blockingDependency String?
  costImpact         Float?
  scheduleImpactDays Int?
  correctiveAction   String?
  authorId           String
  author             UserIdentity           @relation("DelayExplanationAuthor", fields: [authorId], references: [id])
  createdAt          DateTime               @default(now())
}

// Contracts/quotations/POs remain separate objects (§9) — this just links
// and records the routing decision, never duplicates the contract's data.
model TaskContractLink {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?    @relation(fields: [contractId], references: [id])
  decision    String // EXISTING_CONTRACT | VARIATION_REQUIRED | NEW_CONTRACT_REQUIRED | NOT_REQUIRED | FURTHER_ASSESSMENT
  reason      String?
  createdById String
  createdBy   UserIdentity @relation("ContractLinkCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

// The restricted external work package (§10) — a contractor sees only this,
// never the project/client/finance modules (CTO-100).
model TaskContractorAssignment {
  id                   String       @id @default(cuid())
  tenantId             String
  tenant               Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contractorId         String
  contractor           Contractor   @relation(fields: [contractorId], references: [id])
  contractId           String?
  contract             Contract?    @relation(fields: [contractId], references: [id])
  scope                String
  status               String       @default("ASSIGNED")
  // ASSIGNED | ACCEPTED | CLARIFICATION_REQUESTED | SCHEDULED | IN_PROGRESS | DELAYED | READY_FOR_INSPECTION | REWORK_REQUIRED | COMPLETED
  plannedStart         DateTime?
  deadline             DateTime?
  acceptedAt           DateTime?
  readyForInspectionAt DateTime?
  assignedById         String
  assignedBy           UserIdentity @relation("ContractorAssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt            DateTime     @default(now())
}

model TaskInspection {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedAt DateTime      @default(now())
  inspectorId String?
  inspector   UserIdentity? @relation("TaskInspector", fields: [inspectorId], references: [id])
  result      String? // PASSED | PASSED_WITH_OBSERVATIONS | FAILED | REWORK_REQUIRED | ADDITIONAL_INSPECTION_REQUIRED
  notes       String?
  inspectedAt DateTime?
  createdAt   DateTime      @default(now())
}

model TaskCompletionRecord {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedById String
  completedBy   UserIdentity @relation("TaskCompletedBy", fields: [completedById], references: [id])
  comment       String
  actualDate    DateTime     @default(now())
  gatesSnapshot String // JSON-encoded snapshot of the completion checklist at closure time
  createdAt     DateTime     @default(now())

  reopenings TaskReopeningRecord[]
}

// CTO-082 — reopening starts a new lifecycle segment; the prior completion
// record is never edited or deleted.
model TaskReopeningRecord {
  id                         String               @id @default(cuid())
  tenantId                   String
  tenant                     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId                     String
  task                       Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reopenedById               String
  reopenedBy                 UserIdentity         @relation("TaskReopenedBy", fields: [reopenedById], references: [id])
  reason                     String
  newIssue                   String?
  newDeadline                DateTime?
  riskImpact                 String?
  previousCompletionRecordId String
  previousCompletionRecord   TaskCompletionRecord @relation(fields: [previousCompletionRecordId], references: [id])
  createdAt                  DateTime             @default(now())
}

model TaskContribution {
  id          String       @id @default(cuid())
  taskId      String
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  String?
  deliverable String?
  status      String       @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  createdAt   DateTime     @default(now())
}

model TaskDependency {
  id            String @id @default(cuid())
  taskId        String
  task          Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOnTask Task   @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

// ---------------------------------------------------------------------------
// PRD_Tasks_Module — additive layer on top of the Task model above. §4's
// "participant-based privacy" is already enforced by canViewTask()
// (src/lib/project-access.ts, PRD_10) via Task.visibility/TaskParticipant;
// this only adds the collaborative surface the PRD's Task Page needs that
// didn't already exist: a private per-user Star (§14) and a shared,
// participant-editable Checklist (§9). Watchers reuse TaskParticipant's
// existing WATCHER role rather than a separate model; Activity reuses
// TaskEvent; discussion reuses the platform's generic Comment model
// (already wired to Task via listComments(tenantId, "Task", id)).
// ---------------------------------------------------------------------------

// §14 Personal Star — private, does not touch official priority, never
// notifies. Mirrors DocumentFavorite's shape.
model TaskStar {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation("TaskStarUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([taskId, userId])
  @@index([tenantId, userId])
}

// §9 Shared Checklist — collaborative To-Do items any participant may add,
// claim or complete. Every check/uncheck is also written to TaskEvent so it
// appears in the Activity Timeline (§9: "must appear ... with user and
// timestamp").
model TaskChecklistItem {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  ownerId       String?
  owner         UserIdentity? @relation("TaskChecklistOwner", fields: [ownerId], references: [id])
  dueAt         DateTime?
  notes         String?
  completed     Boolean       @default(false)
  completedById String?
  completedBy   UserIdentity? @relation("TaskChecklistCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  sortOrder     Int           @default(0)
  createdById   String
  createdBy     UserIdentity  @relation("TaskChecklistCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId, taskId])
}

// ---------------------------------------------------------------------------
// Collaboration: comments, timeline, notifications, audit
// ---------------------------------------------------------------------------

model Comment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId       String
  author         UserIdentity @relation(fields: [authorId], references: [id])
  body           String
  classification String? // DECISION | QUESTION | ISSUE | INFORMATION
  targetType     String // "Task" | "Project" | "Client" | ...
  targetId       String
  createdAt      DateTime     @default(now())

  // PRD_3 — a comment (currently only used on Client profiles) can spawn at
  // most one task via @mention; the FK lives on Task (see
  // Task.sourceCommentId) so this is the 1:1 reverse side.
  createdTask Task? @relation("TaskSourceComment")
}

model Suggestion {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime     @default(now())
}

model TimelineEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  eventType  String
  actorId    String?
  metadata   String? // JSON-encoded string
  createdAt  DateTime @default(now())
}

model Notification {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId, isRead])
}

// Per-user, per-event-category channel choice (Section 14 — "each user
// chooses channels, subject to company defaults and critical-event rules").
model NotificationPreference {
  id       String       @id @default(cuid())
  userId   String
  user     UserIdentity @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // TASKS | APPROVALS | FINANCE | PROJECTS
  inApp    Boolean      @default(true)
  email    Boolean      @default(false)
  whatsapp Boolean      @default(false)

  @@unique([userId, category])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Audit 2 §5 "Cross-Module Interaction Through Domain Events" — transactional
// outbox for the Contract Approved -> Finance Structure -> Payment Recorded
// reference workflow (src/lib/domain-events.ts). Written inside the SAME
// transaction as the state change that raised it, so the event can never be
// lost even if in-process dispatch fails right after commit; a row left
// PENDING/FAILED here is exactly what a future background worker would
// sweep and retry, without any schema change.
model DomainEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // e.g. "ContractApproved", "PaymentRecorded"
  payload     String // JSON
  status      String    @default("PENDING") // PENDING | PROCESSED | FAILED
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  // PRD_18 §11 context envelope — additive, nullable so pre-existing rows
  // and any future caller that omits context still work.
  correlationId   String? // links a business process across events/retries; defaults to this event's own id when root
  causationId     String? // the event that caused this one, if any
  actorUserId     String?
  actorSnapshot   String? // JSON ActorSnapshot at emit time
  sourceModule    String?
  sourceRecordId  String?
  owningCompanyId String?
  projectId       String?
  confidentiality String?

  @@index([tenantId, status])
  @@index([correlationId])
}

// ---------------------------------------------------------------------------
// Phase-1 dashboard support tables (minimal slices of Phase 2+ modules,
// just enough to render real Finance/HR/Architect dashboard data)
// ---------------------------------------------------------------------------

model FinanceAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  type     String // OPERATING | PAYROLL | SAVINGS | TAX | PETTY_CASH
  balance  Float
  currency String @default("EUR")
}

// ---------------------------------------------------------------------------
// PRD_Finance_Module — additive "Accounting Core" layer (§6-9): Chart of
// Accounts, Cost Centers, Fiscal Periods and double-entry Journal Entries.
// FinanceAccount above (bank/cash accounts with a running balance) and
// Invoice/FinancialLedgerEntry (the Contract-reaction posting pipeline, the
// tested Audit 2 reference workflow) are both untouched — this is a
// parallel general ledger for direct entries, not a replacement. §44 Data
// Ownership Rules: posted entries are never edited directly, only reversed.
//
// Deferred: BankAccount/BankTransaction reconciliation (FinanceAccount is
// today's stand-in), Invoice/InvoiceLine/Payment/PaymentAllocation (the
// existing Invoice model already covers this differently), Budget/
// BudgetLine/Forecast/TaxCode/AssetLedger/Loan — all lower priority for a
// first usable slice.
// ---------------------------------------------------------------------------

// §7 Chart of Accounts.
model Account {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  name               String
  type               String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  parentId           String?
  parent             Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children           Account[] @relation("AccountHierarchy")
  normalBalance      String    @default("DEBIT") // DEBIT | CREDIT
  currency           String    @default("EUR")
  postingAllowed     Boolean   @default(true)
  status             String    @default("ACTIVE") // ACTIVE | INACTIVE
  costCenterRequired Boolean   @default(false)
  projectRequired    Boolean   @default(false)
  createdAt          DateTime  @default(now())

  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

// A financial dimension (§7 "Cost center requirement"), kept as its own
// hierarchy rather than overloading Department/Team.
model CostCenter {
  id        String       @id @default(cuid())
  tenantId  String
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  parentId  String?
  parent    CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id])
  children  CostCenter[] @relation("CostCenterHierarchy")
  status    String       @default("ACTIVE")
  createdAt DateTime     @default(now())

  journalLines JournalLine[]

  @@unique([tenantId, code])
}

// §9 Fiscal Years and Periods — journals may only post into OPEN periods.
model FiscalPeriod {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g. "2026-08"
  startAt   DateTime
  endAt     DateTime
  status    String   @default("OPEN") // OPEN | SOFT_CLOSED | CLOSED | LOCKED
  createdAt DateTime @default(now())

  journalEntries JournalEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

// §8 Journal Entries — the accounting document; JournalLine below carries
// the actual debit/credit postings. "Posted journals are immutable": once
// status=POSTED, src/server/finance-module.ts refuses further edits to the
// entry or its lines; only reverseJournalEntry() (a new offsetting entry)
// is allowed.
model JournalEntry {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number          String
  date            DateTime      @default(now())
  periodId        String
  period          FiscalPeriod  @relation(fields: [periodId], references: [id])
  description     String
  // Where this entry came from, if not entered directly (e.g. "Contract" +
  // a ContractObligation id) — bare reference, no Prisma relation, same
  // "source-linked not owned" pattern used across every module this session.
  sourceModule    String?
  sourceId        String?
  status          String        @default("DRAFT") // DRAFT | APPROVED | POSTED | REVERSED
  postedAt        DateTime?
  postedById      String?
  postedBy        UserIdentity? @relation("JournalEntryPostedBy", fields: [postedById], references: [id])
  reversesEntryId String?       @unique
  reversesEntry   JournalEntry? @relation("JournalReversal", fields: [reversesEntryId], references: [id])
  reversedBy      JournalEntry? @relation("JournalReversal")
  createdById     String
  createdBy       UserIdentity  @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  lines JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, periodId])
}

// §8 Debit/credit line. "Every posted journal must balance: total debits
// equal total credits" — enforced in src/server/finance-module.ts before a
// journal is allowed to post, not at the schema level (SQLite has no
// CHECK-across-rows constraint).
model JournalLine {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  currency       String       @default("EUR")
  costCenterId   String?
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id])
  // Project dimension — bare id, no relation (Projects is frozen).
  projectId      String?
  description    String?

  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountId])
}

// §37 Audit — a generic timeline, reused across Finance entities the same
// way Contract/Task/Document each have their own.
model FinanceActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "JournalEntry" | "Account" | "FiscalPeriod"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("FinanceActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  // Set only on the type="PAYMENT" invoices auto-created by the
  // ContractApproved reaction (src/server/contract-lifecycle-reactions.ts)
  // as the contract's "Finance Structure" — not a client-facing field.
  contractId  String?
  contract    Contract? @relation(fields: [contractId], references: [id])
  number      String
  type        String // INVOICE | BILL | PAYMENT | EXPENSE
  description String?
  amount      Float
  currency    String    @default("EUR")
  status      String    @default("PENDING") // legacy: PAID | PENDING | SENT | OVERDUE | COMPLETED
  // PRD_2 posting lifecycle (§8.1) also uses this column:
  // DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | POSTED | REVERSED
  issuedDate  DateTime  @default(now())
  dueDate     DateTime?
  postedAt    DateTime?
  postedById  String?

  ledgerEntries FinancialLedgerEntry[]
  spendingBill  SpendingBill?

  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, contractId])
}

// ---------------------------------------------------------------------------
// PRD_Finance_Dashboard — additive layer. §46-ish Data Ownership: Finance
// owns Spending Bill (the operational request/approval/payment-preparation
// workflow) and Budget (baseline/actual/committed/variance); Projects,
// Contracts, Procurement and Units stay source-linked by bare id, never
// duplicated. Spending Bill is deliberately a distinct record type from
// Invoice/Expense (§12 "Spendings vs Expenses" — must not be merged).
// ---------------------------------------------------------------------------

// §11.2/§11.3 — the Spending Bill lifecycle. `status` drives the workflow;
// FinanceActivity (existing polymorphic entityType/entityId audit table)
// carries the audit trail rather than a dedicated table, same pattern as
// JournalEntry/Account/FiscalPeriod already use.
model SpendingBill {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  number          String // Number Series: SPD-{YYYY}-{SEQ5}
  category        String
  amount          Float
  currency        String    @default("EUR")
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  description     String?
  // Base64 data URL — same "no object storage anywhere" convention as the
  // Employee Profile CV/certification fields; §11.2 "Evidence attachment
  // required unless approved policy exception."
  evidenceDataUrl String?
  evidenceWaived  Boolean   @default(false)

  costCenter String?
  budgetId   String?
  budget     Budget? @relation(fields: [budgetId], references: [id])
  overBudget Boolean @default(false)

  status String @default("DRAFT")
  // DRAFT | SUBMITTED | PENDING_SUPERIOR | PENDING_FINANCE |
  // APPROVED_FOR_PAYMENT | PAID | REJECTED

  submitterId String
  submitter   UserIdentity @relation("SpendingBillSubmitter", fields: [submitterId], references: [id])

  superiorApproverId String?
  superiorApprover   UserIdentity? @relation("SpendingBillSuperiorApprover", fields: [superiorApproverId], references: [id])
  superiorDecidedAt  DateTime?

  financeApproverId String?
  financeApprover   UserIdentity? @relation("SpendingBillFinanceApprover", fields: [financeApproverId], references: [id])
  financeDecidedAt  DateTime?

  rejectionReason String?

  paidAt            DateTime?
  transferReference String?
  paymentId         String?   @unique
  payment           Invoice?  @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, companyId, status])
  @@index([tenantId, projectId])
}

// §13 Budget Integration. One row per (scope, period) — projectId null means
// a company-level budget. Revisions preserve the prior baseline (FIN-DASH-009)
// rather than overwriting `baselineAmount` in place.
model Budget {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  period         String // e.g. "2026" or "2026-Q3" — configurable label, not a date-range engine in v1
  baselineAmount Float
  currency       String  @default("EUR")
  costCenter     String?

  status String @default("ACTIVE") // ACTIVE | CLOSED

  createdById String
  createdBy   UserIdentity @relation("BudgetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  revisions     BudgetRevision[]
  spendingBills SpendingBill[]

  @@index([tenantId, companyId])
  @@index([tenantId, projectId])
}

model BudgetRevision {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  previousAmount Float
  newAmount      Float
  reason         String?

  revisedById String
  revisedBy   UserIdentity @relation("BudgetRevisionRevisedBy", fields: [revisedById], references: [id])
  revisedAt   DateTime     @default(now())

  @@index([tenantId, budgetId])
}

// §14 "Other" sidebar group — kept intentionally minimal (list + record,
// no amortization schedule engine) so the sidebar item isn't a dead link.
model Loan {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lender       String
  principal    Float
  currency     String    @default("EUR")
  interestRate Float?
  outstanding  Float
  startDate    DateTime
  maturityDate DateTime?
  status       String    @default("ACTIVE") // ACTIVE | PAID_OFF | DEFAULTED
  notes        String?

  createdById String
  createdBy   UserIdentity @relation("LoanCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([tenantId, companyId])
}

model Investment {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  type         String // EQUITY | BOND | DEPOSIT | REAL_ESTATE | OTHER
  amount       Float
  currency     String    @default("EUR")
  currentValue Float?
  startDate    DateTime
  maturityDate DateTime?
  status       String    @default("ACTIVE") // ACTIVE | MATURED | LIQUIDATED
  notes        String?

  createdById String
  createdBy   UserIdentity @relation("InvestmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([tenantId, companyId])
}

model Employee {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?       @unique
  user         UserIdentity? @relation(fields: [userId], references: [id])
  fullName     String
  position     String
  department   String
  hireDate     DateTime
  status       String        @default("ACTIVE") // ACTIVE | ON_LEAVE | TERMINATED
  avatarColor  String        @default("#1A1D23")
  birthday     DateTime?
  // Employee Profile — contact info shown to any active company member so
  // colleagues can reach out; a base64 data URL rather than a real file/blob
  // store, since this app has no object storage anywhere (every other
  // "document" feature is metadata-only) — this is the one place a real
  // inline image is actually rendered, so it needs real bytes, not just a name.
  phone        String?
  photoDataUrl String?
  // PRD_9 LEV-001 — "direct superior" for leave-request creation. Self-relation
  // rather than reusing CompanyMembership.managerId (a dormant, unused, un-typed
  // field with no clear FK target) since leave lives on Employee, not on the
  // tenant-membership record.
  managerId    String?
  manager      Employee?     @relation("EmployeeManager", fields: [managerId], references: [id])

  leaveRequests LeaveRequest[]
  reports       Employee[]         @relation("EmployeeManager")
  documents     DocumentFile[]
  // Salary History — see SalaryRecord below; access is gated to HR/Finance/
  // Admin/Owner via canViewSalary() in src/server/employee-profile.ts. Not
  // even the employee themselves sees this (unlike Work Contract/CV).
  salaryRecords SalaryRecord[]
  trainings     EmployeeTraining[]

  // --- PRD_HR_Payroll_Workforce (additive: EmploymentRelationship) --------
  employmentRelationships EmploymentRelationship[]
  reportsToRelationships  EmploymentRelationship[] @relation("EmploymentReportsTo")
  payrollRunLines         PayrollRunLine[]

  // --- PRD_HR_Payroll_Workforce — Attendance & Scheduling (additive) -------
  scheduleAssignments ScheduleAssignment[]
  attendanceEvents    AttendanceEvent[]

  @@index([tenantId, department])
}

// Time-boxed salary history — every change creates a new record; past
// records are never overwritten, only superseded (status flips CURRENT ->
// PREVIOUS and effectiveEndDate is set). HR is the single source of truth;
// Finance reads the CURRENT record directly for payroll/cost/forecast
// calculations rather than maintaining its own duplicate.
model SalaryRecord {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveStartDate DateTime
  effectiveEndDate   DateTime?
  currency           String        @default("EUR") // EUR | ALL
  grossSalary        Float
  netSalary          Float
  paymentFrequency   String        @default("MONTHLY") // MONTHLY | BIWEEKLY | WEEKLY | ANNUAL
  status             String        @default("CURRENT") // CURRENT | PREVIOUS
  notes              String?
  createdById        String
  createdBy          UserIdentity  @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          UserIdentity? @relation("SalaryRecordUpdatedBy", fields: [updatedById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payrollRunLines PayrollRunLine[]

  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, status])
}

// Per-company module registry — absence of a row means enabled (so
// existing tenants keep every feature they already had); only an explicit
// disabled row hides a module's nav items via visibleNavSections().
model CompanyModule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleKey])
}

// Employee-facing training records — HR assigns, each employee sees only
// their own (self-or-HR gate, mirrors canViewWorkContract).
model EmployeeTraining {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name          String
  provider      String?
  status        String       @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | COMPLETED | EXPIRED
  assignedById  String
  assignedBy    UserIdentity @relation("TrainingAssignedBy", fields: [assignedById], references: [id])
  dueDate       DateTime?
  completedDate DateTime?
  expiryDate    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, employeeId])
}

model LeaveRequest {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  status      String        @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reason      String?
  createdAt   DateTime      @default(now())
  // PRD_9 §4.1 — who created the request (the employee themselves, their
  // direct superior, or HR on someone's behalf) and, once decided, who at HR
  // decided it. Nullable: rows created before this PRD had no such actor.
  createdById String?
  createdBy   UserIdentity? @relation("LeaveCreatedBy", fields: [createdById], references: [id])
  decidedById String?
  decidedBy   UserIdentity? @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  updatedAt   DateTime      @updatedAt

  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}

model HrAppointment {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  type          String       @default("INTERVIEW") // INTERVIEW | INTERNAL | OTHER
  candidateName String?
  scheduledAt   DateTime
  notes         String?
  createdById   String
  createdBy     UserIdentity @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now())
}

// PRD_Architect_Dashboard / PRD_Engineer_Dashboard — additive enrichment.
// `packageName`/`revisionCode`/`status` stay as the original current-state
// columns (existing pages depend on them); DrawingRevision below adds the
// real history/comparison/supersession trail §17/§15.2 require, without
// touching those columns' meaning.
model Drawing {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageName  String
  discipline   String?
  revisionCode String
  status       String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | NEEDS_REVISION
  updatedAt    DateTime @updatedAt

  // --- additive ---
  drawingType     String? // FLOOR_PLAN | ELEVATION | SECTION | DETAIL | MATERIAL_SCHEDULE | RENDER | OTHER
  locationContext String? // building/floor/zone/unit free text
  authorId        String?
  author          UserIdentity? @relation("DrawingAuthor", fields: [authorId], references: [id])
  fileDataUrl     String?
  createdAt       DateTime      @default(now())

  revisions DrawingRevision[]

  @@index([tenantId, projectId])
}

model DrawingRevision {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  code        String
  description String?
  status      String  @default("DRAFT") // DRAFT | SUBMITTED | RETURNED | APPROVED | SUPERSEDED
  fileDataUrl String?

  authorId String
  author   UserIdentity @relation("DrawingRevisionAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, drawingId])
}

model RFI {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  title        String
  status       String    @default("OPEN") // OPEN | ANSWERED | OVERDUE
  assignedToId String?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())

  // --- additive: §18 RFI element requirements ---
  discipline    String?
  contextType   String? // DRAWING | SPECIFICATION | LOCATION | MODEL_OBJECT
  contextId     String?
  response      String?
  respondedById String?
  respondedBy   UserIdentity? @relation("RfiRespondedBy", fields: [respondedById], references: [id])
  respondedAt   DateTime?

  @@index([tenantId, projectId])
}

// ---------------------------------------------------------------------------
// PRD_Architect_Dashboard / PRD_Engineer_Dashboard — additive layer.
// Submittal is shared by both roles; Engineering Package/Specification/
// Calculation/InspectionRequest/CoordinationIssue are Engineer-side;
// ClientRequest is Architect-side. Every model here stays a thin
// project-linked record (bare Project/UserIdentity FKs only) — no
// duplication of Documents/Tasks/Workflow/BIM truth per both PRDs'
// "one source of truth" rule.
// ---------------------------------------------------------------------------

model Submittal {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number      String
  type        String // MATERIAL | TECHNICAL_DATA | CERTIFICATION | DESIGN | OTHER
  title       String
  discipline  String?
  description String?
  fileDataUrl String?

  submitterId String
  submitter   UserIdentity  @relation("SubmittalSubmitter", fields: [submitterId], references: [id])
  reviewerId  String?
  reviewer    UserIdentity? @relation("SubmittalReviewer", fields: [reviewerId], references: [id])

  status    String    @default("OPEN") // OPEN | IN_REVIEW | APPROVED | REJECTED | RETURNED
  dueDate   DateTime?
  decidedAt DateTime?
  comment   String?

  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model EngineeringPackage {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code       String
  title      String
  discipline String?
  scope      String?
  status     String    @default("OPEN") // OPEN | IN_PREPARATION | IN_REVIEW | APPROVED
  dueDate    DateTime?

  ownerId String?
  owner   UserIdentity? @relation("EngineeringPackageOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  specifications Specification[]
  calculations   Calculation[]

  @@index([tenantId, projectId])
}

model Specification {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageId String?
  package   EngineeringPackage? @relation(fields: [packageId], references: [id])

  code            String
  title           String
  discipline      String?
  category        String?
  scope           String?
  currentRevision String  @default("A")
  status          String  @default("DRAFT") // DRAFT | CURRENT | IN_REVIEW | RETURNED

  authorId    String?
  author      UserIdentity? @relation("SpecificationAuthor", fields: [authorId], references: [id])
  fileDataUrl String?

  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
}

model Calculation {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  packageId String?
  package   EngineeringPackage? @relation(fields: [packageId], references: [id])

  code           String
  title          String
  discipline     String?
  type           String?
  technicalScope String?
  assumptions    String?
  revision       String  @default("A")
  status         String  @default("DRAFT") // DRAFT | UNDER_REVIEW | RETURNED | APPROVED

  authorId    String?
  author      UserIdentity? @relation("CalculationAuthor", fields: [authorId], references: [id])
  checkerId   String?
  checker     UserIdentity? @relation("CalculationChecker", fields: [checkerId], references: [id])
  fileDataUrl String?

  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
}

// §20 — a genuine, intentionally minimal QA/QC module: this is the source
// of truth PRD_Engineer_Dashboard requires Inspections to defer to. Not the
// full PRD_HSE_Module-style QA/QC & Handover PRD referenced as an authority
// document — request -> schedule -> execute -> result only.
model InspectionRequest {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number         String
  workPackage    String?
  discipline     String?
  inspectionType String?
  location       String?
  quantity       String?

  requestedDate DateTime?
  plannedDate   DateTime?

  requesterId String
  requester   UserIdentity  @relation("InspectionRequester", fields: [requesterId], references: [id])
  inspectorId String?
  inspector   UserIdentity? @relation("InspectionInspector", fields: [inspectorId], references: [id])

  status String @default("REQUESTED") // REQUESTED | SCHEDULED | READY | IN_INSPECTION | RESULT_ISSUED | REINSPECTION_REQUIRED

  result        String? // PASS | PASS_WITH_COMMENTS | CONDITIONAL_ACCEPTANCE | PARTIAL_PASS | FAIL
  resultAt      DateTime?
  resultById    String?
  resultBy      UserIdentity? @relation("InspectionResultBy", fields: [resultById], references: [id])
  evidenceNotes String?

  correctiveTaskId String?

  createdAt DateTime @default(now())

  ncrs Ncr[]

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// PRD_QAQC_Dashboard §11 — Non-Conformance Report. Canonical lifecycle Draft
// -> Issued -> Containment -> Root Cause -> Corrective Plan -> Implementation
// -> Verification -> Closed; a Closed NCR is never edited in place — reopen
// creates a new open cycle on the same record with prior state preserved via
// QaqcActivity, same "close, never rewrite" pattern as issueInspectionResult.
model Ncr {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number               String
  projectId            String
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inspectionRequestId  String?
  inspectionRequest    InspectionRequest? @relation(fields: [inspectionRequestId], references: [id])
  discipline           String?
  location             String?
  description          String
  requirement          String? // the requirement/spec violated
  severity             String             @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status               String             @default("DRAFT") // DRAFT | ISSUED | CONTAINMENT | ROOT_CAUSE | CORRECTIVE_PLAN | IMPLEMENTATION | VERIFICATION | CLOSED | REOPENED
  containmentAction    String?
  rootCause            String?
  correctiveActionPlan String?
  dueDate              DateTime?
  raisedById           String
  raisedBy             UserIdentity       @relation("NcrRaisedBy", fields: [raisedById], references: [id])
  verifiedById         String?
  verifiedBy           UserIdentity?      @relation("NcrVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime           @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
}

// PRD_QAQC_Dashboard §13 — Defects/Snags/Punch share one lifecycle (Open ->
// Assigned -> In Correction -> Ready for Review -> Verified -> Closed) and
// one canonical record shape; `type` is the only thing distinguishing a
// Defect from a Snag/Punch item, matching the PRD's shared "Quality Issues"
// family rather than three parallel schemas.
model Defect {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number           String
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             String        @default("DEFECT") // DEFECT | SNAG | PUNCH
  location         String?
  description      String
  severity         String        @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status           String        @default("OPEN") // OPEN | ASSIGNED | IN_CORRECTION | READY_FOR_REVIEW | VERIFIED | CLOSED | REOPENED
  assignedToId     String?
  assignedTo       UserIdentity? @relation("DefectAssignedTo", fields: [assignedToId], references: [id])
  correctiveTaskId String?
  verifiedById     String?
  verifiedBy       UserIdentity? @relation("DefectVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  rejectionReason  String?
  closedAt         DateTime?
  raisedById       String
  raisedBy         UserIdentity  @relation("DefectRaisedBy", fields: [raisedById], references: [id])
  createdAt        DateTime      @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, projectId, status])
  @@index([tenantId, type])
}

// Audit timeline for NCR/Defect — same pattern as every other module's
// Activity model this session (InventoryActivity, HrActivity, ...).
model QaqcActivity {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String // "Ncr" | "Defect" | "InspectionRequest"
  entityId   String
  actorId    String?
  actor      UserIdentity? @relation("QaqcActivityActor", fields: [actorId], references: [id])
  eventType  String
  summary    String
  createdAt  DateTime      @default(now())

  @@index([tenantId, entityType, entityId])
}

// BIM-owned coordination issue (§21/§24). BCF-shaped but v1-minimal —
// viewpoint is a bare text/JSON reference, not a full BCF file exchange.
model CoordinationIssue {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bimModelId String?
  bimModel   BimModel? @relation(fields: [bimModelId], references: [id])

  title        String
  discipline   String?
  priority     String  @default("NORMAL") // LOW | NORMAL | HIGH | CRITICAL
  status       String  @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  viewpointRef String?

  createdById  String
  createdBy    UserIdentity  @relation("CoordinationIssueCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   UserIdentity? @relation("CoordinationIssueAssignedTo", fields: [assignedToId], references: [id])
  linkedTaskId String?

  createdAt DateTime @default(now())

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

// §20 Client Requests — Architect-side. Sales/CRM creates it (bare
// clientId/unitId refs, same "source-linked not owned" pattern as
// ClientUnitRelationship); Architecture owns the design work state.
model ClientRequest {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  unitId    String?

  requestType      String    @default("FLOOR_PLAN") // FLOOR_PLAN | CUSTOMISATION
  description      String?
  deliverablesNote String?
  dueDate          DateTime?

  assignedArchitectId String?
  assignedArchitect   UserIdentity? @relation("ClientRequestAssignedArchitect", fields: [assignedArchitectId], references: [id])

  status String @default("REQUESTED") // REQUESTED | IN_PROGRESS | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED

  createdById String
  createdBy   UserIdentity @relation("ClientRequestCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([tenantId, projectId])
  @@index([tenantId, status])
}

model HseReport {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String
  severity     String       @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status       String       @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  reportedById String
  reportedBy   UserIdentity @relation(fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Procurement — suppliers and purchase orders. Deliberately separate from
// Contractor/Contract (those are subcontractors executing project work;
// suppliers/POs are materials & goods purchasing), and gated by its own
// "PROCUREMENT" resource so it's a real, independent department like HR or
// Finance rather than a sub-feature bolted onto Contracts.
// ---------------------------------------------------------------------------

model Supplier {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId           String?
  company             Company?          @relation(fields: [companyId], references: [id])
  number              String // Number Series: SUP-{SEQ6}
  name                String
  legalName           String?
  tradingName         String?
  supplierType        String            @default("MATERIALS")
  category            String // e.g. Steel, Concrete, Electrical, MEP
  categoryId          String? // optional link into the SupplierCategory taxonomy; `category` remains the free-text label of record
  categoryRef         SupplierCategory? @relation(fields: [categoryId], references: [id])
  email               String?
  phone               String?
  website             String?
  taxId               String?
  registrationId      String?
  countryCode         String            @default("AL")
  address             String?
  paymentTerms        String?
  leadTimeDays        Int?
  currency            String            @default("EUR")
  qualificationStatus String            @default("NOT_STARTED")
  overallScore        Float?
  status              String            @default("PROSPECT") // PROSPECT | UNDER_QUALIFICATION | QUALIFIED | PREFERRED | SUSPENDED | BLACKLISTED | ARCHIVED
  notes               String?
  version             Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  archivedAt          DateTime?

  contacts             SupplierContact[]
  qualifications       SupplierQualification[]
  riskFlags            SupplierRiskFlag[]
  documents            SupplierDocument[]
  rfqInvitations       ProcurementRfqSupplier[]
  quotations           SupplierQuotation[]
  purchaseOrders       PurchaseOrder[]
  deliveries           ProcurementDelivery[]
  awardRecommendations AwardRecommendation[]
  spendingBills        SpendingBill[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, category])
}

model SupplierContact {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String   @default("PRIMARY")
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([tenantId, supplierId])
}

model SupplierQualification {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category   String?
  outcome    String // QUALIFIED | CONDITIONALLY_QUALIFIED | REJECTED | SUSPENDED | RENEWAL_REQUIRED
  score      Float?
  validFrom  DateTime?
  validUntil DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  @@index([tenantId, supplierId])
}

model SupplierRiskFlag {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type       String
  severity   String    @default("MEDIUM")
  summary    String
  status     String    @default("OPEN")
  reviewDate DateTime?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([tenantId, supplierId, status])
}

// PRD Procurement §27.2 Phase 1 "Foundation" — supplier categories are a
// dedicated, tenant-owned taxonomy (not just a free-text label) so
// scoping, reporting and future category-level approval rules have
// something structured to attach to. `Supplier.category` keeps carrying
// the display label for backward compatibility; `categoryId` is optional.
model SupplierCategory {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?           @relation(fields: [companyId], references: [id])
  code        String
  name        String
  description String?
  parentId    String?
  parent      SupplierCategory?  @relation("SupplierCategoryTree", fields: [parentId], references: [id])
  children    SupplierCategory[] @relation("SupplierCategoryTree")
  active      Boolean            @default(true)
  createdById String
  createdAt   DateTime           @default(now())

  suppliers Supplier[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

// PRD Procurement §27.2 Phase 1 "Foundation" — supplier documents with
// expiry tracking power the "Supplier Document Renewal" page; soft
// `documentId` reference mirrors the pattern used by WorkProgressEvidence
// rather than a hard FK into the Documents module.
model SupplierDocument {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        String    @default("OTHER") // REGISTRATION | INSURANCE | TAX_CERTIFICATE | ISO_CERTIFICATE | LICENSE | OTHER
  title       String
  documentId  String?
  url         String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  status      String    @default("VALID") // VALID | EXPIRING_SOON | EXPIRED | RENEWAL_REQUIRED
  notes       String?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([tenantId, supplierId])
  @@index([tenantId, expiresAt])
}

model PurchaseRequest {
  id               String       @id @default(cuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company      @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
  number           String
  title            String
  type             String       @default("CONSTRUCTION_MATERIAL")
  priority         String       @default("NORMAL")
  status           String       @default("DRAFT")
  justification    String?
  requiredBy       DateTime?
  deliveryLocation String?
  department       String?
  category         String?
  estimatedAmount  Float        @default(0)
  currency         String       @default("EUR")
  emergencyReason  String?
  riskStatement    String?
  snapshot         String?
  version          Int          @default(1)
  createdById      String
  createdBy        UserIdentity @relation(fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  archivedAt       DateTime?

  lines          PurchaseRequestLine[]
  package        ProcurementPackage?   @relation(fields: [packageId], references: [id])
  packageId      String?
  rfqs           ProcurementRfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status, requiredBy])
  @@index([tenantId, projectId])
}

model PurchaseRequestLine {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineNumber        Int
  lineType          String          @default("MATERIAL")
  description       String
  specification     String?
  quantity          Float
  unit              String
  estimatedUnitCost Float           @default(0)
  requiredBy        DateTime?
  deliveryLocation  String?
  createdAt         DateTime        @default(now())

  @@unique([requestId, lineNumber])
  @@index([tenantId, requestId])
}

model ProcurementPackage {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  number      String
  name        String
  type        String       @default("PROJECT_PACKAGE")
  status      String       @default("PLANNING")
  scope       String?
  targetValue Float        @default(0)
  currency    String       @default("EUR")
  awardTarget DateTime?
  riskLevel   String       @default("LOW")
  version     Int          @default(1)
  createdById String
  createdBy   UserIdentity @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requests       PurchaseRequest[]
  rfqs           ProcurementRfq[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model ProcurementRfq {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id])
  requestId      String?
  request        PurchaseRequest?    @relation(fields: [requestId], references: [id])
  packageId      String?
  package        ProcurementPackage? @relation(fields: [packageId], references: [id])
  number         String
  title          String
  type           String              @default("RFQ")
  status         String              @default("DRAFT")
  deadline       DateTime?
  instructions   String?
  issuedSnapshot String?
  version        Int                 @default(1)
  createdById    String
  createdBy      UserIdentity        @relation(fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines                ProcurementRfqLine[]
  suppliers            ProcurementRfqSupplier[]
  quotations           SupplierQuotation[]
  purchaseOrders       PurchaseOrder[]
  comparisons          ProcurementComparison[]
  awardRecommendations AwardRecommendation[]

  @@unique([tenantId, number])
  @@index([tenantId, status, deadline])
}

model ProcurementRfqLine {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfqId       String
  rfq         ProcurementRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  lineNumber  Int
  description String
  quantity    Float
  unit        String
  requiredBy  DateTime?

  quotationLines SupplierQuotationLine[]

  @@unique([rfqId, lineNumber])
  @@index([tenantId, rfqId])
}

model ProcurementRfqSupplier {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfqId         String
  rfq           ProcurementRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId    String
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  status        String         @default("PLANNED")
  invitedAt     DateTime?
  respondedAt   DateTime?
  declineReason String?

  @@unique([rfqId, supplierId])
  @@index([tenantId, supplierId])
}

model SupplierQuotation {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id])
  rfqId             String
  rfq               ProcurementRfq @relation(fields: [rfqId], references: [id])
  supplierId        String
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  number            String
  supplierReference String?
  status            String         @default("RECEIVED")
  currency          String         @default("EUR")
  subtotal          Float          @default(0)
  discount          Float          @default(0)
  tax               Float          @default(0)
  freight           Float          @default(0)
  total             Float          @default(0)
  validityDate      DateTime?
  leadTimeDays      Int?
  paymentTerms      String?
  technicalStatus   String         @default("PENDING")
  notes             String?
  revision          Int            @default(1)
  createdById       String
  createdBy         UserIdentity   @relation(fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())

  lines              SupplierQuotationLine[]
  purchaseOrders     PurchaseOrder[]
  comparisonScores   ProcurementComparisonScore[]
  recommendedByAward AwardRecommendation[]        @relation("RecommendedByAward")

  @@unique([tenantId, number])
  @@index([tenantId, rfqId, supplierId])
}

model SupplierQuotationLine {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationId  String
  quotation    SupplierQuotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineId    String?
  rfqLine      ProcurementRfqLine? @relation(fields: [rfqLineId], references: [id])
  description  String
  quantity     Float
  unit         String
  unitPrice    Float
  lineTotal    Float
  compliance   String              @default("COMPLIANT")
  leadTimeDays Int?

  @@index([tenantId, quotationId])
}

model PurchaseOrder {
  id                    String               @id @default(cuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId             String?
  company               Company?             @relation(fields: [companyId], references: [id])
  number                String // Number Series: PO-{YYYY}-{SEQ5}
  projectId             String?
  project               Project?             @relation(fields: [projectId], references: [id])
  supplierId            String
  supplier              Supplier             @relation(fields: [supplierId], references: [id])
  requestId             String?
  request               PurchaseRequest?     @relation(fields: [requestId], references: [id])
  packageId             String?
  package               ProcurementPackage?  @relation(fields: [packageId], references: [id])
  rfqId                 String?
  rfq                   ProcurementRfq?      @relation(fields: [rfqId], references: [id])
  quotationId           String?
  quotation             SupplierQuotation?   @relation(fields: [quotationId], references: [id])
  awardRecommendationId String?
  awardRecommendation   AwardRecommendation? @relation(fields: [awardRecommendationId], references: [id])
  title                 String?
  type                  String               @default("STANDARD")
  description           String
  amount                Float
  currency              String               @default("EUR")
  subtotal              Float                @default(0)
  discount              Float                @default(0)
  tax                   Float                @default(0)
  freight               Float                @default(0)
  status                String               @default("DRAFT") // DRAFT | ISSUED | ACKNOWLEDGED | PARTIALLY_FULFILLED | FULFILLED | CLOSED | ON_HOLD | CANCELLED | SUPERSEDED | ARCHIVED
  version               Int                  @default(1)
  issueDate             DateTime?
  requestedDeliveryDate DateTime?
  confirmedDeliveryDate DateTime?
  deliveryAddress       String?
  paymentTerms          String?
  supplierReference     String?
  acknowledgedAt        DateTime?
  issuedSnapshot        String?
  requestedById         String
  requestedBy           UserIdentity         @relation(fields: [requestedById], references: [id])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  archivedAt            DateTime?

  lines      PurchaseOrderLine[]
  revisions  PurchaseOrderRevision[]
  deliveries ProcurementDelivery[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNumber        Int
  lineType          String        @default("MATERIAL")
  description       String
  quantity          Float
  unit              String
  unitPrice         Float
  discount          Float         @default(0)
  tax               Float         @default(0)
  lineTotal         Float
  promisedDate      DateTime?
  deliveredQuantity Float         @default(0)
  acceptedQuantity  Float         @default(0)
  rejectedQuantity  Float         @default(0)

  deliveryLines ProcurementDeliveryLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([tenantId, purchaseOrderId])
}

model PurchaseOrderRevision {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  version         Int
  reason          String
  deltaAmount     Float         @default(0)
  snapshot        String
  createdAt       DateTime      @default(now())

  @@unique([purchaseOrderId, version])
  @@index([tenantId, purchaseOrderId])
}

model ProcurementDelivery {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id])
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId       String
  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  number           String
  status           String        @default("PLANNED")
  expectedAt       DateTime?
  actualArrival    DateTime?
  deliveryLocation String?
  carrierReference String?
  exceptionType    String?
  exceptionNote    String?
  createdById      String
  createdBy        UserIdentity  @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines ProcurementDeliveryLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, expectedAt])
}

model ProcurementDeliveryLine {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryId          String
  delivery            ProcurementDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [id])
  scheduledQuantity   Float
  arrivedQuantity     Float               @default(0)
  acceptedQuantity    Float               @default(0)
  rejectedQuantity    Float               @default(0)
  notes               String?

  @@index([tenantId, deliveryId])
}

// PRD_Procurement_Dashboard §10/§11 — Supplier Comparison + Award
// Recommendation, the dashboard's actual differentiator over the existing
// RFQ/Quotation module. A comparison scores every received quotation on the
// same PRD-fixed criteria set (§10.1); the recommendation is a separate
// record from the comparison so "prepare" and "decide" stay distinct roles
// (§10.3 separation of duties — the preparer is never forced to also be the
// decider, though nothing here stops the same person by policy choice).
model ProcurementComparison {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  rfqId       String
  rfq         ProcurementRfq @relation(fields: [rfqId], references: [id])
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id])
  status      String         @default("DRAFT") // DRAFT | SCORING | COMPLETED
  createdById String
  createdBy   UserIdentity   @relation("ComparisonCreatedBy", fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  scores ProcurementComparisonScore[]
  awards AwardRecommendation[]

  @@unique([tenantId, number])
  @@index([tenantId, rfqId])
}

// One row per supplier-quotation x criterion. Weight is fixed per criterion
// at 100/8 by default (PRD §10.2 "weights total 100% when weighted scoring
// is enabled") — Phase-1 keeps the 8-criterion set from §10.1 fixed rather
// than configurable.
model ProcurementComparisonScore {
  id            String                @id @default(cuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  comparisonId  String
  comparison    ProcurementComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  quotationId   String
  quotation     SupplierQuotation     @relation(fields: [quotationId], references: [id])
  criterion     String // PRICE | LEAD_TIME | COMPLIANCE | QUALITY | HSE | WARRANTY | PERFORMANCE | RISK
  weight        Float                 @default(12.5)
  score         Float // 0-100, evaluator-entered
  evaluatedById String
  evaluatedBy   UserIdentity          @relation("ComparisonScoreEvaluatedBy", fields: [evaluatedById], references: [id])
  evaluatedAt   DateTime              @default(now())

  @@unique([comparisonId, quotationId, criterion])
  @@index([tenantId, comparisonId])
}

// §11 Award lifecycle: Comparison -> Evaluation Complete -> Award
// Recommendation -> Workflow/direct Decision -> Selected/Returned/Rejected.
// Award content stays Procurement-owned even though decision routing may
// later go through the Workflow Engine (§11.2 boundary) — Phase-1 decides
// directly with a SoD guard (preparer cannot also decide) rather than a full
// Workflow instance, same simplification Finance's earlier build used before
// wiring Workflow in.
model AwardRecommendation {
  id                     String                @id @default(cuid())
  tenantId               String
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number                 String
  comparisonId           String
  comparison             ProcurementComparison @relation(fields: [comparisonId], references: [id])
  rfqId                  String
  rfq                    ProcurementRfq        @relation(fields: [rfqId], references: [id])
  recommendedSupplierId  String
  recommendedSupplier    Supplier              @relation(fields: [recommendedSupplierId], references: [id])
  recommendedQuotationId String
  recommendedQuotation   SupplierQuotation     @relation("RecommendedByAward", fields: [recommendedQuotationId], references: [id])
  justification          String?
  status                 String                @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | SUPERSEDED
  preparedById           String
  preparedBy             UserIdentity          @relation("AwardPreparedBy", fields: [preparedById], references: [id])
  preparedAt             DateTime              @default(now())
  decidedById            String?
  decidedBy              UserIdentity?         @relation("AwardDecidedBy", fields: [decidedById], references: [id])
  decidedAt              DateTime?
  decisionNote           String?

  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, rfqId, status])
}

model ProcurementActivity {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  eventType      String
  summary        String
  previousStatus String?
  nextStatus     String?
  metadata       String?
  correlationId  String
  actorId        String
  actor          UserIdentity @relation(fields: [actorId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
}

// ---------------------------------------------------------------------------
// PRD_Work_Progress - physical construction execution and site operations
// ---------------------------------------------------------------------------

model WorkPackage {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId          String
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId           String?
  parent             WorkPackage?           @relation("WorkPackageTree", fields: [parentId], references: [id])
  children           WorkPackage[]          @relation("WorkPackageTree")
  code               String
  name               String
  description        String?
  discipline         String
  location           String?
  contractorName     String?
  accountableOwnerId String
  measurementMethod  String                 @default("INSTALLED_QUANTITY")
  unit               String                 @default("item")
  approvedQuantity   Float                  @default(0)
  acceptedQuantity   Float                  @default(0)
  weight             Float                  @default(0)
  plannedStart       DateTime?
  plannedFinish      DateTime?
  forecastFinish     DateTime?
  status             String                 @default("DRAFT")
  readinessStatus    String                 @default("NOT_ASSESSED")
  qualityGateStatus  String                 @default("NOT_REQUIRED")
  hseGateStatus      String                 @default("NOT_REQUIRED")
  recordVersion      Int                    @default(1)
  createdById        String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
