# Copy to .env and fill in. Every variable the app, the test suite and CI read
# is listed here — nothing required should have to be reverse-engineered from
# source.

# --- Database -----------------------------------------------------------
# Postgres (Neon). Use the POOLED connection string (-pooler host) at runtime:
# serverless functions opening unpooled connections is the fastest way to
# exhaust Postgres's connection limit.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The DIRECT (unpooled) string. Prisma uses this for `migrate`/`db push` only;
# migrations cannot run through the pooler.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth ---------------------------------------------------------------
# Signing key for session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage -------------------------------------------------------
# Where uploaded drawings, photos, renders and documents are stored.
#   local  — writes under .storage/ on disk. The default for dev, tests and CI.
#   vercel — Vercel Blob. Requires BLOB_READ_WRITE_TOKEN below.
BLOB_DRIVER="local"

# Required only when BLOB_DRIVER=vercel. From the Vercel dashboard:
# Storage -> your Blob store -> .env.local tab.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Public base URL used to build absolute links to privately-served files.
# Defaults to NEXTAUTH_URL when unset.
# APP_URL="http://localhost:3000"

# --- Email (Phase 2) -------------------------------------------------------
# Notification email is a driver, like BLOB_DRIVER. Left unset, the "log"
# driver records what would have been sent instead of pretending it went out,
# so nothing silently disappears in development or CI.
# Set to "resend" and supply a key to send for real.
# EMAIL_DRIVER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="Nesto <no-reply@yourdomain.com>"
