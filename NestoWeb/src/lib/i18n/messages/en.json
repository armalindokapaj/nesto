  "apply": {
    "title": "Professional & contractor sign-up",
    "body": "Independent professional profiles, portfolios and contractor applications are part of Nesto's upcoming Business Collaboration Layer. This isn't open yet — company workspace accounts are created by your organisation's Company Admin.",
    "backToSignIn": "Back to sign in"
  },
  "requestDemoPage": {
    "title": "Request a demo",
    "body": "Nesto is currently in private build, running live for a single pilot company. Public demo scheduling isn't open yet — the platform is still in the phase where every new workspace is set up by hand.",
    "whatItCovers": "When demos open up, a session will walk through: multi-department dashboards, the project and task workflow, cross-department client requests, and the role-based permission model that keeps each department seeing only what it should.",
    "backToSignIn": "Back to sign in"
  },
  "securityPage": {
    "title": "Security",
    "intro": "Nesto is built as a private operating system for a single construction company at a time. Every workspace's data lives behind its own tenant boundary — here is what that means concretely, in the system as it exists today.",
    "isolationTitle": "Tenant isolation",
    "isolationBody": "Every record — projects, tasks, clients, documents, comments — is scoped to a tenant ID at the data layer. A user session is bound to one tenant; there is no query path that lets one company's workspace read another's.",
    "authTitle": "Authentication",
    "authBody": "Passwords are hashed with bcrypt before storage — Nesto never stores or logs a plaintext password. Sessions are signed tokens verified on every request, and login responses are shaped identically whether or not an account exists, so a failed attempt can't be used to guess valid usernames.",
    "accessTitle": "Admin-controlled access",
    "accessBody": "There is no public self-registration. Every account is created by a Company Admin or Owner inside the workspace, and access can be suspended or archived by them at any time without deleting the underlying history.",
    "permissionsTitle": "Role-based permissions",
    "permissionsBody": "Every department (Finance, HR, Legal, Architecture, Sales and more) has its own permission level per resource — read, write, or full — enforced on both the interface and the server action handling the request, not just hidden in the UI.",
    "backToSignIn": "Back to sign in"
  },
  "forgotPassword": {
    "title": "Forgot your password?",
    "body": "Nesto accounts are created and managed by your company's administrator — there's no self-service reset yet. Enter your account email below and we'll notify your workspace's admin to help you back in.",
    "emailLabel": "Account email",
    "submit": "Notify my admin",
    "sending": "Sending…",
    "successTitle": "Request sent",
    "successBody": "If an account exists for that email, your workspace administrator has been notified."
  },
