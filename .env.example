# Copy to .env. Every variable the apps, the workers, the test suite and CI read
# is listed here — nothing required should have to be reverse-engineered from
# source. A missing required secret fails fast at boot (ADR-0017).

# --- Runtime -------------------------------------------------------------
NODE_ENV=development

# --- Database ------------------------------------------------------------
# Runtime connects as nesto_app: not a superuser and NOBYPASSRLS, so every row
# level security policy actually applies to the application. That is the only
# way the isolation suite proves anything (ADR-0002).
# Port 5433 avoids colliding with a system Postgres on 5432.
DATABASE_URL=postgresql://nesto_app:nesto_app_dev@localhost:5433/nesto?schema=public
# Migrations and seeds connect as the owner, which does bypass RLS —
# bootstrapping a tenant necessarily happens before there is a tenant context
# to bootstrap it in. Unpooled: migrations cannot run through a pooler.
DATABASE_URL_DIRECT=postgresql://nesto:nesto_dev@localhost:5433/nesto?schema=public

# --- Queues --------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Authentication (ADR-0003) -------------------------------------------
# Signing key for the 10-minute access token. openssl rand -base64 48
AUTH_ACCESS_SECRET=dev-only-access-secret-replace-me-with-48-random-bytes
# Pepper mixed into refresh-token hashes so a database read alone cannot
# reconstruct a usable token. openssl rand -base64 48
AUTH_REFRESH_PEPPER=dev-only-refresh-pepper-replace-me-with-48-random-bytes

# --- Encryption (ADR-0017) -----------------------------------------------
# Key-encryption key for envelope encryption of MFA seeds and credentials.
# 32 bytes, base64. openssl rand -base64 32
CRYPTO_KEK=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24ta2V5LTMyYnl0ZQ==

# --- Object storage (ADR-0007) -------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=nesto
STORAGE_SECRET_KEY=nesto_dev_secret
STORAGE_BUCKET_OBJECTS=nesto-objects
STORAGE_BUCKET_QUARANTINE=nesto-quarantine
STORAGE_FORCE_PATH_STYLE=true

# Malware scanner driver: clamav | permissive-dev
# permissive-dev marks uploads clean without inspecting them and is REFUSED at
# boot when NODE_ENV=production. Declared deviation D-3.
MALWARE_SCANNER=permissive-dev

# --- Mail ----------------------------------------------------------------
# log | smtp. smtp points at mailpit locally; nothing leaves the machine.
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Nesto <no-reply@nesto.local>"

# --- Service URLs --------------------------------------------------------
# Server-to-server: what company-web and platform-admin call from the server.
API_INTERNAL_URL=http://localhost:4000
# What a browser would call, for links and redirects.
API_PUBLIC_URL=http://localhost:4000
COMPANY_WEB_URL=http://localhost:3000
PLATFORM_ADMIN_URL=http://localhost:3001

# --- Observability (deviation D-5) ---------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
